---
import '@removesynth/shared/styles/base.css';
import '../styles/theme.css';
import { SITES } from '@removesynth/shared/sites';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
}

const { title, description, schema, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const path = Astro.url.pathname;

const NAV = [
  { href: '/', label: 'AI checker' },
  { href: '/platforms/', label: 'Platforms' },
  { href: '/synthid-detector/', label: 'SynthID detector' },
];
const FOOTER = [
  {
    heading: 'Check',
    links: [
      { href: '/', label: 'AI metadata checker' },
      { href: '/platforms/', label: 'How platforms label AI' },
      { href: '/synthid-detector/', label: 'SynthID detector guide' },
    ],
  },
  {
    heading: 'From RemoveSynth',
    links: [
      { href: `${SITES.removesynth}/photo-metadata-remover/`, label: 'Photo metadata remover' },
      { href: `${SITES.removesynth}/heic-to-jpg/`, label: 'HEIC to JPG' },
      { href: `${SITES.removesynth}/generators/`, label: 'What AI generators add' },
      { href: `${SITES.removesynth}/what-is-synthid/`, label: 'What is SynthID?' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#070b10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label={`${SITE.name} home`}>
          <span class="logo-mark" aria-hidden="true"></span>
          <span>CheckAI<b>orNot</b></span>
        </a>
        <nav aria-label="Main">
          <ul class="nav">
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a href="/" class="logo">{SITE.name}</a>
          <p class="muted">Is it AI or not? See what the file says.</p>
        </div>
        <div class="footer-cols">
          {FOOTER.map((group) => (
            <div>
              <h2 class="footer-heading">{group.heading}</h2>
              <ul class="footer-links">
                {group.links.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="muted small">
          CheckAIorNot reads the metadata inside a file. It can’t prove an image is real or fake, and it
          can’t see invisible watermarks like SynthID. Not affiliated with Google, Meta, OpenAI, Adobe or
          the C2PA.
        </p>
        <p class="muted small">&copy; {new Date().getFullYear()} {SITE.name} · a <a href={SITES.removesynth}>RemoveSynth</a> project</p>
      </div>
    </footer>
  </body>
</html>
