---
import Base from '../layouts/Base.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'SynthID Detector: How to Check if Content Has SynthID';
const description =
  'How to check whether an image, video, audio clip or text has a SynthID watermark, using Google’s SynthID Detector and Gemini, and how to read the results.';

const faqs: FaqItem[] = [
  {
    q: 'Can I see SynthID by looking at a file?',
    a: 'No. SynthID is invisible and isn’t stored in metadata, so you need a detector built for it.',
  },
  {
    q: 'Does a negative result mean content isn’t AI-generated?',
    a: 'No. SynthID only marks content from tools that apply it. AI content from other tools won’t carry it, and heavy edits can weaken the signal.',
  },
  {
    q: 'Can EXIF or metadata viewers find SynthID?',
    a: 'No. They can show C2PA Content Credentials, which are stored in metadata, but SynthID lives in the content itself.',
  },
  {
    q: 'Can CheckAIorNot detect SynthID?',
    a: 'Not yet. Our checker reads the metadata in a file, such as Content Credentials and IPTC tags, but SynthID is in the pixels. Use Google’s tools described on this page.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'SynthID detector', url: `${SITE.url}/synthid-detector/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  faqSchema(faqs),
];
---

<Base title={title} description={description} schema={schema} ogType="article">
  <article class="prose">
    <header class="hero" style="text-align:left;padding-bottom:0">
      <span class="eyebrow">Detection</span>
      <h1>SynthID detector: how to check a file</h1>
      <p class="lead" style="margin-left:0">
        SynthID can’t be seen or found in metadata. Here’s how to check whether a file carries it,
        and what the result does and doesn’t tell you.
      </p>
    </header>

    <h2>Ways to check for SynthID</h2>
    <h3>1. Google’s SynthID Detector</h3>
    <p>
      Google’s SynthID Detector lets you upload a file and reports whether a SynthID watermark was
      found. For some media it also highlights which parts are most likely to carry the watermark.
    </p>
    <h3>2. Ask Gemini</h3>
    <p>
      In the Gemini app you can upload an image and ask whether it was made with Google AI. Gemini
      checks for SynthID and tells you what it finds.
    </p>
    <h3>3. Check C2PA too</h3>
    <p>
      Many AI tools also attach C2PA Content Credentials to files. A Content Credentials viewer can
      show this metadata, which complements a SynthID check. See <a href="https://removesynth.com/blog/synthid-vs-c2pa/">SynthID
      vs C2PA</a>.
    </p>

    <h2>How to read the result</h2>
    <ul>
      <li><strong>Watermark found:</strong> the content, or part of it, was generated or edited with a tool that applies SynthID.</li>
      <li><strong>Not found:</strong> the file doesn’t carry a detectable SynthID signal. It may still be AI-generated by a tool that doesn’t use SynthID.</li>
      <li><strong>Uncertain:</strong> the signal may be weak, for example after heavy editing or on a very small file.</li>
    </ul>

    <div class="callout">
      Want to know more about how the watermark works? Read <a href="https://removesynth.com/what-is-synthid/">What is SynthID?</a>
    </div>

    <Faq items={faqs} heading="SynthID detector FAQ" />
  </article>
</Base>
