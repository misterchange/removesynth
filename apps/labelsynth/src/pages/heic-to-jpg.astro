---
import Base from '../layouts/Base.astro';
import ToolDrop from '@removesynth/shared/components/ToolDrop.astro';
import DocBlocks from '../components/DocBlocks.astro';
import { PAGES } from '../data/registry';
import { SITE } from '../site';
import { splitHero, extractFaq } from '../lib/doc';
import { renderInline } from '../lib/inline';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';

const doc = PAGES['heic-to-jpg'];
const { h1, lead, rest } = splitHero(doc.blocks, doc.title);
const faq = extractFaq(doc.blocks);

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'HEIC to JPG', url: `${SITE.url}/heic-to-jpg/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'HEIC to JPG Converter',
    url: `${SITE.url}/heic-to-jpg/`,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  ...(faq.length ? [faqSchema(faq as FaqItem[])] : []),
];
---

<Base title={doc.title} description={doc.description} schema={schema}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Free · Batch up to 30 · No upload</span>
      <h1 set:html={renderInline(h1)} />
      {lead.map((b, i) => <p class={i === 0 ? 'lead' : ''} set:html={renderInline(b.text)} />)}
      <ToolDrop
        id="heic"
        accept="image/heic,image/heif,.heic,.heif"
        multiple
        title="Drop HEIC photos"
        sub="We convert them to JPG in your browser."
        meta="click to choose · HEIC · HEIF · up to 30 at once"
        footnote="Runs in your browser · nothing is uploaded · metadata is not copied"
      >
        <div class="options">
          <label for="quality">Quality</label>
          <select id="quality">
            <option value="0.8">80% · smaller</option>
            <option value="0.92" selected>92% · recommended</option>
            <option value="1">100% · best</option>
          </select>
        </div>
        <div class="results" hidden aria-live="polite">
          <div class="bar">
            <span class="summary"></span>
            <button type="button" class="btn zip">Download all (ZIP)</button>
          </div>
          <ul class="rows"></ul>
        </div>
      </ToolDrop>
    </div>
  </section>

  <article class="prose">
    <DocBlocks blocks={rest} />
  </article>
</Base>

<style>
  .options {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.92rem;
  }
  select {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    padding: 6px 10px;
  }
  .results {
    margin-top: 16px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .bar .btn {
    padding: 8px 14px;
    font-size: 0.9rem;
  }
  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .rows :global(li) {
    display: flex;
    gap: 12px;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px 12px;
    background: var(--bg-elev-2);
  }
  .rows :global(img) {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
    flex: none;
  }
  .rows :global(.info) {
    flex: 1;
    min-width: 0;
  }
  .rows :global(.name) {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .rows :global(.note) {
    margin: 2px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .rows :global(a.btn) {
    padding: 6px 12px;
    font-size: 0.85rem;
  }
</style>

<script>
  import { zipSync } from 'fflate';

  const MAX = 30;
  const root = document.getElementById('heic')!;
  const results = root.querySelector('.results') as HTMLElement;
  const rows = root.querySelector('.rows') as HTMLUListElement;
  const summary = root.querySelector('.summary') as HTMLElement;
  const zipBtn = root.querySelector('.zip') as HTMLButtonElement;
  const quality = root.querySelector('#quality') as HTMLSelectElement;
  const outputs: { name: string; blob: Blob }[] = [];
  let busy = 0;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const jpgName = (n: string) => n.replace(/\.(heic|heif)$/i, '') + '.jpg';
  const update = () => {
    summary.textContent = busy ? `Converting… ${outputs.length} done` : `${outputs.length} converted`;
    zipBtn.disabled = busy > 0 || outputs.length < 2;
  };

  root.addEventListener('files', async (e) => {
    const files = (e as CustomEvent<File[]>).detail.slice(0, Math.max(0, MAX - rows.children.length));
    if (!files.length) return;
    results.hidden = false;
    const { default: heic2any } = await import('heic2any');
    busy += files.length;
    update();
    for (const file of files) {
      const li = el('li');
      const info = el('div', 'info');
      const note = el('p', 'note', 'Converting…');
      info.append(el('div', 'name', file.name), note);
      li.append(info);
      rows.append(li);
      try {
        const out = await heic2any({ blob: file, toType: 'image/jpeg', quality: Number(quality.value) });
        const blob = Array.isArray(out) ? out[0] : out;
        const name = jpgName(file.name);
        outputs.push({ name, blob });
        const url = URL.createObjectURL(blob);
        const img = el('img') as HTMLImageElement;
        img.src = url;
        img.alt = '';
        li.prepend(img);
        note.textContent = `${(file.size / 1024).toFixed(0)} KB → ${(blob.size / 1024).toFixed(0)} KB`;
        const a = el('a', 'btn', 'Download') as HTMLAnchorElement;
        a.href = url;
        a.download = name;
        li.append(a);
      } catch {
        note.textContent = 'This file couldn’t be converted. Make sure it’s a HEIC or HEIF photo.';
      } finally {
        busy--;
        update();
      }
    }
  });

  zipBtn.addEventListener('click', async () => {
    const entries: Record<string, Uint8Array> = {};
    for (const o of outputs) {
      let n = o.name;
      for (let i = 2; entries[n]; i++) n = o.name.replace(/\.jpg$/, `-${i}.jpg`);
      entries[n] = new Uint8Array(await o.blob.arrayBuffer());
    }
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([zipSync(entries, { level: 0 })], { type: 'application/zip' }));
    a.download = 'labelsynth-heic-to-jpg.zip';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10_000);
  });
</script>
