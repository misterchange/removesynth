    list-style: decimal;
    padding-left: 24px;
  }
  .link-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    gap: 10px;
    margin: 24px 0;
  }
  .link-grid a {
    display: block;
    padding: 10px 14px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--fg);
    transition: all 0.15s ease;
