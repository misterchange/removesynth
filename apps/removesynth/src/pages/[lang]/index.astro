---
import HomePage from '../../components/HomePage.astro';
import { ALL_HOME_CONTENT } from '../../home-content';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang },
    props: { content: ALL_HOME_CONTENT[lang as Locale] },
  }));
}

const { content } = Astro.props;
---

<HomePage c={content} />
