<script>
  function setupExifTool() {
    const root = document.getElementById('exif-tool');
    if (!root) return;

    const dz = root.querySelector<HTMLElement>('#dz')!;
    const fileIn = root.querySelector<HTMLInputElement>('#file-in')!;
    const dzPrompt = root.querySelector<HTMLElement>('#dz-prompt')!;
    const dzPreview = root.querySelector<HTMLElement>('#dz-preview')!;
    const previewImg = root.querySelector<HTMLImageElement>('#preview-img')!;
    const fileInfo = root.querySelector<HTMLElement>('#file-info')!;
    const btnChange = root.querySelector<HTMLButtonElement>('#btn-change')!;
    const btnInject = root.querySelector<HTMLButtonElement>('#btn-inject')!;
    const status = root.querySelector<HTMLElement>('#tool-status')!;
    const presetBtns = [...root.querySelectorAll<HTMLButtonElement>('.preset-card')];

    const fMake = root.querySelector<HTMLInputElement>('#f-make')!;
    const fModel = root.querySelector<HTMLInputElement>('#f-model')!;
    const fLens = root.querySelector<HTMLInputElement>('#f-lens')!;
    const fIso = root.querySelector<HTMLInputElement>('#f-iso')!;
    const fFnumber = root.querySelector<HTMLInputElement>('#f-fnumber')!;
    const fShutter = root.querySelector<HTMLInputElement>('#f-shutter')!;
    const fDate = root.querySelector<HTMLInputElement>('#f-date')!;
    const fGeo = root.querySelector<HTMLSelectElement>('#f-geo')!;

    let currentFile: File | null = null;

    // Set default datetime to now
    const now = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    fDate.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;

    const PRESETS: Record<string, { make: string; model: string; lens: string; iso: string; f: string; shutter: string }> = {
      sony: { make: 'SONY', model: 'ILCE-7M4', lens: 'FE 24-70mm F2.8 GM II', iso: '100', f: 'f/2.8', shutter: '1/250s' },
      canon: { make: 'Canon', model: 'Canon EOS R5', lens: 'RF 50mm F1.2 L USM', iso: '200', f: 'f/1.8', shutter: '1/500s' },
      iphone: { make: 'Apple', model: 'iPhone 15 Pro Max', lens: 'iPhone 15 Pro Max back camera 6.86mm f/1.78', iso: '64', f: 'f/1.78', shutter: '1/120s' },
      nikon: { make: 'NIKON CORPORATION', model: 'NIKON Z 8', lens: 'NIKKOR Z 24-120mm f/4 S', iso: '125', f: 'f/4', shutter: '1/160s' },
      fuji: { make: 'FUJIFILM', model: 'X-T5', lens: 'XF 35mm f/1.4 R', iso: '160', f: 'f/2', shutter: '1/320s' },
    };

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const p = PRESETS[btn.dataset.preset ?? 'sony'];
        if (p) {
          fMake.value = p.make;
          fModel.value = p.model;
          fLens.value = p.lens;
          fIso.value = p.iso;
          fFnumber.value = p.f;
          fShutter.value = p.shutter;
        }
      });
    });

    const handleFile = (file: File) => {
      currentFile = file;
      const url = URL.createObjectURL(file);
      previewImg.src = url;
      fileInfo.textContent = `${file.name} · ${(file.size / 1024 / 1024).toFixed(2)} MB`;
      dzPrompt.hidden = true;
      dzPreview.hidden = false;
      btnInject.disabled = false;
      status.textContent = 'Photo loaded. Choose your camera preset and click inject.';
      status.className = 'tool-status small';
    };

    dz.addEventListener('click', (e) => {
      if (e.target !== btnChange) fileIn.click();
    });
    fileIn.addEventListener('change', () => fileIn.files?.[0] && handleFile(fileIn.files[0]));
    btnChange.addEventListener('click', (e) => {
      e.stopPropagation();
      fileIn.click();
    });

    dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('drag'); });
    dz.addEventListener('dragleave', () => dz.classList.remove('drag'));
    dz.addEventListener('drop', (e) => {
      e.preventDefault();
      dz.classList.remove('drag');
      const f = e.dataTransfer?.files?.[0];
      if (f) handleFile(f);
    });

    // Helper to build standard binary TIFF EXIF header for JPEG APP1
    function createExifApp1(make: string, model: string, dateStr: string): Uint8Array {
      // Formats date as YYYY:MM:DD HH:MM:SS
      const d = new Date(dateStr);
      const exDate = `${d.getFullYear()}:${pad(d.getMonth() + 1)}:${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}\0`;

      // Big-endian TIFF structure
      const enc = new TextEncoder();
      const makeBytes = enc.encode(make + '\0');
      const modelBytes = enc.encode(model + '\0');
      const dateBytes = enc.encode(exDate);

      // Simple, standard valid IFD0 with Make, Model, DateTime
      const numEntries = 3;
      const ifdLength = 2 + numEntries * 12 + 4;
      const offsetData = 8 + ifdLength;

      const totalSize = offsetData + makeBytes.length + modelBytes.length + dateBytes.length;
      const tiff = new Uint8Array(totalSize);
      const view = new DataView(tiff.buffer);

      // TIFF Header: Big Endian 'MM', 42, offset to IFD0 (8)
      tiff[0] = 0x4D; tiff[1] = 0x4D;
      view.setUint16(2, 42);
      view.setUint32(4, 8);

      // IFD0 count
      view.setUint16(8, numEntries);

      let curOffset = offsetData;

      // Tag 0x010F: Make
      let p = 10;
      view.setUint16(p, 0x010F); view.setUint16(p + 2, 2); // ASCII
      view.setUint32(p + 4, makeBytes.length);
      view.setUint32(p + 8, curOffset);
      tiff.set(makeBytes, curOffset);
      curOffset += makeBytes.length;

      // Tag 0x0110: Model
      p += 12;
      view.setUint16(p, 0x0110); view.setUint16(p + 2, 2); // ASCII
      view.setUint32(p + 4, modelBytes.length);
      view.setUint32(p + 8, curOffset);
      tiff.set(modelBytes, curOffset);
      curOffset += modelBytes.length;

      // Tag 0x0132: DateTime
      p += 12;
      view.setUint16(p, 0x0132); view.setUint16(p + 2, 2); // ASCII
      view.setUint32(p + 4, dateBytes.length);
      view.setUint32(p + 8, curOffset);
      tiff.set(dateBytes, curOffset);

      // Next IFD = 0
      p += 12;
      view.setUint32(p, 0);

      // Wrap in JPEG APP1 marker: 0xFFE1 + length + "Exif\0\0"
      const app1 = new Uint8Array(2 + 2 + 6 + tiff.length);
      app1[0] = 0xFF; app1[1] = 0xE1;
      const app1Len = 2 + 6 + tiff.length;
      app1[2] = (app1Len >> 8) & 0xFF;
      app1[3] = app1Len & 0xFF;
      app1.set(enc.encode('Exif\0\0'), 4);
      app1.set(tiff, 10);
      return app1;
    }

    btnInject.addEventListener('click', async () => {
      if (!currentFile) return;
      status.textContent = 'Generating camera EXIF payload...';
      btnInject.disabled = true;

      try {
        const bmp = await createImageBitmap(currentFile);
        const canvas = document.createElement('canvas');
        canvas.width = bmp.width;
        canvas.height = bmp.height;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(bmp, 0, 0);

        const blob = await new Promise<Blob>((res) => canvas.toBlob((b) => res(b!), 'image/jpeg', 0.98));
        const jpegBytes = new Uint8Array(await blob.arrayBuffer());

        // Create the new Camera EXIF APP1 block
        const app1 = createExifApp1(fMake.value, fModel.value, fDate.value);

        // Splice APP1 after SOI (0xFF, 0xD8)
        let outJpeg: Uint8Array;
        if (jpegBytes[0] === 0xFF && jpegBytes[1] === 0xD8) {
          // Check if an existing APP1 exists and skip it
          let offset = 2;
          if (jpegBytes[2] === 0xFF && (jpegBytes[3] & 0xF0) === 0xE0) {
            const segLen = (jpegBytes[4] << 8) | jpegBytes[5];
            offset = 4 + segLen;
          }
          outJpeg = new Uint8Array(2 + app1.length + (jpegBytes.length - offset));
          outJpeg[0] = 0xFF; outJpeg[1] = 0xD8;
          outJpeg.set(app1, 2);
          outJpeg.set(jpegBytes.subarray(offset), 2 + app1.length);
        } else {
          outJpeg = jpegBytes;
        }

        const outBlob = new Blob([outJpeg], { type: 'image/jpeg' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(outBlob);
        const dot = currentFile.name.lastIndexOf('.');
        const base = dot > 0 ? currentFile.name.slice(0, dot) : currentFile.name;
        a.download = `${base}-${fMake.value.toLowerCase().replace(/\s+/g, '')}-exif.jpg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        status.textContent = `Success! Injected ${fMake.value} ${fModel.value} camera metadata.`;
        status.className = 'tool-status small ok';
      } catch (err) {
        status.textContent = 'Failed to process image. Try a standard JPG or PNG.';
        status.className = 'tool-status small';
      } finally {
        btnInject.disabled = false;
      }
    });
  }

  setupExifTool();
</script>
