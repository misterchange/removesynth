---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'Add Camera EXIF to Photo: Mock Camera Metadata Online';
const description =
  'Add realistic camera EXIF tags, focal length, lens details, and exposure settings to AI and digital photos. Free client-side tool with zero cloud uploads.';

const faqs: FaqItem[] = [
  {
    q: 'Why add camera EXIF to an AI-generated image?',
    a: 'AI generators like Midjourney and DALL·E export images with missing or stripped camera headers. Adding realistic camera EXIF (like a Sony A7 IV or iPhone 15 Pro) provides realistic photo metadata for photography portfolios, personal archives, or platforms that expect standard camera files.',
  },
  {
    q: 'Does this tool upload my images?',
    a: 'No. The EXIF injection engine runs 100% locally inside your browser using HTML5 Canvas and typed binary arrays. Your photos never leave your device.',
  },
  {
    q: 'Which camera presets are available?',
    a: 'We provide one-click presets for popular cameras including Sony Alpha A7 IV, Canon EOS R5, iPhone 15 Pro Max, Nikon Z8, and Fujifilm X-T5, plus full custom controls for any camera, lens, ISO, shutter speed, or GPS coordinate.',
  },
  {
    q: 'Will the image quality or resolution change?',
    a: 'No. You can set the export quality to 100% to ensure your pixels remain crystal sharp with original dimensions.',
  },
  {
    q: 'Does it remove AI markers while adding EXIF?',
    a: 'Yes. Any existing AI generator parameters or C2PA provenance blocks are cleared when re-saving with the new camera metadata.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Tools', url: `${SITE.url}/tools/` },
    { name: 'Add camera EXIF to photo', url: `${SITE.url}/add-camera-exif/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Add Camera EXIF to Photo & Geotag Generator',
    url: `${SITE.url}/add-camera-exif/`,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to inject camera EXIF into photos',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Select your photo',
        text: 'Drop a JPG or PNG image into the upload box above.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Pick a camera preset',
        text: 'Choose a preconfigured camera profile (Sony, Canon, iPhone, Nikon, Fujifilm) or type custom Make and Model values.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Set capture date',
        text: 'Choose a realistic timestamp matching when your scene was set.',
      },
      {
        '@type': 'HowToStep',
        position: 4,
        name: 'Download enhanced photo',
        text: 'Click Inject Camera EXIF & Download to save your newly tagged image with zero server uploads.',
      },
    ],
  },
  faqSchema(faqs),
];
