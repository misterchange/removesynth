---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'AI Image Resizer: Fit Midjourney & DALL-E Art Free';
const description =
  'Resize and pad AI art from Midjourney, DALL-E, and Stable Diffusion to standard aspect ratios without cropping. Free client-side tool with zero server uploads.';

const faqs: FaqItem[] = [
  {
    q: 'How does this tool resize AI images without cropping?',
    a: 'Instead of aggressively cutting off the top and bottom of your AI character or landscape, our tool keeps your original artwork 100% intact, centers it on the target aspect ratio canvas (e.g. 16:9 or 9:16), and uses our smart blur algorithm or color padding to seamlessly extend the background edges.',
  },
  {
    q: 'What AI generators are supported?',
    a: 'It supports images from Midjourney (v5, v6, Niji), ChatGPT / DALL-E 3, Google Gemini, Stable Diffusion, Flux.1, Leonardo.ai, and Adobe Firefly.',
  },
  {
    q: 'Can I convert Midjourney WebP images to PNG or JPG?',
    a: 'Yes. You can upload any WebP, JPG, or PNG image and export the resized canvas directly into pristine PNG or high-res JPG.',
  },
  {
    q: 'What aspect ratio presets are included?',
    a: 'We include 16:9 (Desktop wallpaper & YouTube thumbnails), 9:16 (Phone wallpaper, Instagram Reels, TikTok), 4:5 (Instagram portrait feed), 1:1 (Square), and 21:9 (Ultrawide cinematic).',
  },
  {
    q: 'Are my images uploaded to any server?',
    a: 'No. All canvas rendering, smart blur filtering, and file exports execute locally in your web browser. Your artwork is never uploaded to any server.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Tools', url: `${SITE.url}/tools/` },
    { name: 'AI image resizer', url: `${SITE.url}/ai-image-resizer/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI Image Resizer for Midjourney & DALL-E',
    url: `${SITE.url}/ai-image-resizer/`,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  faqSchema(faqs),
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Creator Tool • 100% In-Browser • Zero Subject Cropping</span>
      <h1>AI Image <span class="accent">Aspect Ratio Resizer</span></h1>
      <p class="lead">
        Fit square Midjourney and DALL-E artwork to 16:9 cinematic wallpapers, 9:16 mobile stories, or 4:5 Instagram feeds.
