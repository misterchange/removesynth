<script>
  let rawFile: File | null = null;
  let sourceImg: HTMLImageElement | null = null;
  let targetW = 1920;
  let targetH = 1080;
  let fillStyle = 'blur';

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzActiveBar = document.getElementById('dz-active-bar')!;
  const photoFilename = document.getElementById('photo-filename')!;
  const photoFilesize = document.getElementById('photo-filesize')!;
  const btnChange = document.getElementById('btn-change')!;
  const stage = document.getElementById('stage')!;

  const previewCanvas = document.getElementById('preview-canvas') as HTMLCanvasElement;
  const ratioButtons = document.querySelectorAll('.btn-ratio');
  const fillButtons = document.querySelectorAll('.btn-fill');
  const exportFormat = document.getElementById('export-format') as HTMLSelectElement;
  const btnDownload = document.getElementById('btn-download') as HTMLButtonElement;

  dz.addEventListener('click', (e) => {
    if (e.target !== btnChange) fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag-active');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag-active'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag-active');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      loadFile(e.dataTransfer.files[0]);
    }
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files && fileIn.files[0]) {
      loadFile(fileIn.files[0]);
    }
  });

  btnChange.addEventListener('click', (e) => {
    e.stopPropagation();
    fileIn.click();
  });

  function formatBytes(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function loadFile(file: File) {
    rawFile = file;
    photoFilename.textContent = file.name;
    photoFilesize.textContent = `${formatBytes(file.size)} • ${file.type || 'image/png'}`;
    dzPrompt.hidden = true;
    dzActiveBar.hidden = false;
    stage.hidden = false;

    const img = new Image();
    const url = URL.createObjectURL(file);
    img.src = url;

    img.onload = () => {
      sourceImg = img;
      renderCanvas();
    };
  }

  function renderCanvas() {
    if (!sourceImg) return;

    previewCanvas.width = targetW;
    previewCanvas.height = targetH;
    const ctx = previewCanvas.getContext('2d')!;

    // Draw background fill
    if (fillStyle === 'blur') {
      ctx.save();
      ctx.filter = 'blur(45px) brightness(0.85)';
      ctx.drawImage(sourceImg, -40, -40, targetW + 80, targetH + 80);
      ctx.restore();
    } else if (fillStyle === 'black') {
      ctx.fillStyle = '#05070a';
      ctx.fillRect(0, 0, targetW, targetH);
    } else if (fillStyle === 'white') {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, targetW, targetH);
    }

    // Scale and center original artwork cleanly
    const imgRatio = sourceImg.naturalWidth / sourceImg.naturalHeight;
    const canvasRatio = targetW / targetH;

    let drawW = targetW;
    let drawH = targetH;

    if (imgRatio > canvasRatio) {
      drawW = targetW;
      drawH = targetW / imgRatio;
    } else {
      drawH = targetH;
      drawW = targetH * imgRatio;
    }

    const drawX = (targetW - drawW) / 2;
    const drawY = (targetH - drawH) / 2;

    // Draw drop shadow on centered art if blurred
    if (fillStyle === 'blur') {
      ctx.save();
      ctx.shadowColor = 'rgba(0,0,0,0.5)';
      ctx.shadowBlur = 30;
      ctx.drawImage(sourceImg, drawX, drawY, drawW, drawH);
      ctx.restore();
    } else {
      ctx.drawImage(sourceImg, drawX, drawY, drawW, drawH);
    }
  }

  ratioButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      ratioButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      targetW = parseInt(btn.getAttribute('data-w') || '1920', 10);
      targetH = parseInt(btn.getAttribute('data-h') || '1080', 10);
      renderCanvas();
    });
  });

  fillButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      fillButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      fillStyle = btn.getAttribute('data-fill') || 'blur';
      renderCanvas();
    });
  });

  btnDownload.addEventListener('click', () => {
    const fmt = exportFormat.value;
    const ext = fmt === 'image/png' ? '.png' : (fmt === 'image/webp' ? '.webp' : '.jpg');
    
    previewCanvas.toBlob((blob) => {
      if (blob) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const cleanName = (rawFile?.name || 'ai-artwork').replace(/\.[^/.]+$/, '') + `-fit-${targetW}x${targetH}${ext}`;
        a.href = url;
        a.download = cleanName;
        a.click();
        URL.revokeObjectURL(url);
      }
    }, fmt, 0.94);
  });
</script>

