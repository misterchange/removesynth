    margin: 0 auto;
    padding: 32px 16px 80px;
  }
  .hero {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 36px;
  }
  .eyebrow {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(44, 196, 245, 0.25);
    margin-bottom: 14px;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }
  .lead {
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }

  .tool-wrapper {
    margin-bottom: 56px;
  }

  .results {
    margin-top: 18px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 12px;
  }
  .bar-actions {
    display: flex;
    gap: 8px;
  }
  .rows {
    list-style: none;
    margin: 0;
