<script>
  import { cleanFile, downloadBlob, downloadZip } from '@removesynth/shared/lib/clean';

  const root = document.getElementById('anon-cleaner');
  if (root) {
    const results = root.querySelector('.results') as HTMLElement;
    const summary = root.querySelector('.summary') as HTMLElement;
    const rows = root.querySelector('.rows') as HTMLElement;
    const zipBtn = root.querySelector('.zip') as HTMLButtonElement;
    const clearBtn = root.querySelector('.clear') as HTMLButtonElement;

    const cleanedFiles: { name: string; blob: Blob }[] = [];

    const formatBytes = (bytes: number): string => {
      if (bytes < 1024) return bytes + ' B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
    };

    root.addEventListener('files', async (e: Event) => {
      const files = (e as CustomEvent).detail as File[];
      if (!files || !files.length) return;

      results.hidden = false;
      rows.innerHTML = '';
      cleanedFiles.length = 0;
      zipBtn.disabled = true;

      let totalBefore = 0;
      let totalAfter = 0;

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        totalBefore += file.size;

        const li = document.createElement('li');
        li.className = 'bar';
        li.innerHTML = `<span><b>${file.name}</b> (${formatBytes(file.size)})</span><span class="muted">Anonymizing hardware fingerprints...</span>`;
        rows.appendChild(li);

        try {
          const res = await cleanFile(file, { stripAll: true });
          totalAfter += res.cleanSize;
          cleanedFiles.push({ name: res.name, blob: res.blob });

          const saved = file.size - res.cleanSize;
          const pct = file.size > 0 ? ((saved / file.size) * 100).toFixed(1) : '0';

          li.innerHTML = `
            <span><b>${res.name}</b>: ${formatBytes(file.size)} to <span style="color:#00e699">${formatBytes(res.cleanSize)}</span> (Sanitized)</span>
            <button type="button" class="btn btn-ghost dl-single">Download</button>
          `;
          li.querySelector('.dl-single')?.addEventListener('click', () => {
            downloadBlob(res.blob, res.name);
          });
        } catch (err: any) {
          li.innerHTML = `<span><b>${file.name}</b></span><span style="color:#ff4444">Failed: ${err.message || 'Error'}</span>`;
        }
      }

      const totalSaved = totalBefore - totalAfter;
      summary.textContent = `Sanitized ${cleanedFiles.length} photo(s). 100% of GPS coordinates, camera serials, and MakerNotes eliminated.`;
      if (cleanedFiles.length > 1) {
        zipBtn.disabled = false;
      }
    });

    zipBtn?.addEventListener('click', () => {
      if (cleanedFiles.length) {
        downloadZip(cleanedFiles, 'anonymous-sanitized-photos.zip');
      }
    });

    clearBtn?.addEventListener('click', () => {
      results.hidden = true;
      rows.innerHTML = '';
      cleanedFiles.length = 0;
      zipBtn.disabled = true;
    });
  }
</script>
