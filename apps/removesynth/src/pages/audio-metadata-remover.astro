            </tr>
            <tr>
              <td><strong>Mobile Compatibility</strong></td>
              <td>iPhone, iPad, Android</td>
              <td>Desktop Only</td>
              <td>Mobile Web</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- FAQ Section -->
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item card">
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </article>
</Base>

<style>
