            <td>Instant (15-80ms per image)</td>
            <td>5-30s Queue and Upload Wait</td>
            <td>Requires Software Launch Time</td>
          </tr>
          <tr>
            <td><strong>File Size Limits</strong></td>
            <td>Unlimited Local File Size</td>
            <td>100MB Caps on Free Tiers</td>
            <td>Hardware RAM Dependent</td>
          </tr>
          <tr>
            <td><strong>Batch Processing</strong></td>
            <td>Up to 30 Files with ZIP Export</td>
            <td>Requires Paid Subscription</td>
            <td>Batch Actions Script Required</td>
          </tr>
          <tr>
            <td><strong>Cost &amp; Sign-Up</strong></td>
            <td>100% Free with No Account</td>
            <td>Monthly Subscription / Ads</td>
