    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }

  .tool-wrapper {
    margin-bottom: 56px;
  }

  .results {
    margin-top: 18px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 12px;
  }
  .bar-actions {
    display: flex;
    gap: 8px;
  }
  .rows {
    list-style: none;
