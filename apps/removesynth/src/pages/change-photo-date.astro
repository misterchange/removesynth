  .steps {
    list-style: decimal;
    padding-left: 24px;
    line-height: 1.8;
    margin: 20px 0;
  }

  .table-wrap {
    overflow-x: auto;
    margin: 24px 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th, td {
    padding: 10px 14px;
    border: 1px solid var(--border);
    text-align: left;
  }
  th {
    background: var(--card-bg);
    color: var(--fg);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 24px;
  }
  .faq-item {
    padding: 20px 24px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .faq-item h3 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    color: var(--fg);
  }
  .faq-item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
</style>

<script>
  import { downloadBlob } from '@removesynth/shared/lib/clean';

  const root = document.getElementById('date-drop');
  if (root) {
    const results = root.querySelector('.results') as HTMLElement;
    const previewImg = document.getElementById('preview-img') as HTMLImageElement;
    const fileName = document.getElementById('file-name') as HTMLElement;
    const currentDate = document.getElementById('current-date') as HTMLElement;
    const dateField = document.getElementById('date-field') as HTMLInputElement;
    const timeField = document.getElementById('time-field') as HTMLInputElement;
    const dateInputs = document.getElementById('date-inputs') as HTMLElement;
    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
    const modeRadios = document.querySelectorAll('input[name="mode"]');

    let activeFile: File | null = null;
    let fileBuffer: ArrayBuffer | null = null;

    // Helper: format Date object to YYYY:MM:DD HH:MM:SS
    const formatExifString = (dateVal: string, timeVal: string): string => {
      const d = dateVal.replace(/-/g, ':');
      const t = timeVal || '12:00:00';
      return `${d} ${t}`;
    };

    modeRadios.forEach((r) => {
      r.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (val === 'strip') {
          dateInputs.style.display = 'none';
          saveBtn.textContent = 'Strip All Timestamps & Download';
        } else {
          dateInputs.style.display = 'flex';
          saveBtn.textContent = 'Apply and Download Photo';
        }
      });
    });

    root.addEventListener('files', async (e: Event) => {
      const files = (e as CustomEvent).detail as File[];
      if (!files || !files.length) return;

      activeFile = files[0];
      fileName.textContent = activeFile.name;
      results.hidden = false;

      // Preview thumbnail
      const objectUrl = URL.createObjectURL(activeFile);
      previewImg.src = objectUrl;

      // Read buffer
      fileBuffer = await activeFile.arrayBuffer();
      const bytes = new Uint8Array(fileBuffer);

      // Search for Exif date string "YYYY:MM:DD HH:MM:SS"
      let foundDate = 'None / Not Found';
      const textDecoder = new TextDecoder('ascii');
      const dateRegex = /\b(19\d\d|20\d\d):([01]\d):([0-3]\d) ([0-2]\d):([0-5]\d):([0-5]\d)\b/;

      for (let i = 0; i < Math.min(bytes.length - 20, 65536); i++) {
        if (bytes[i] === 0x31 || bytes[i] === 0x32) {
          // starts with '1' or '2'
          const candidate = textDecoder.decode(bytes.subarray(i, i + 19));
          if (dateRegex.test(candidate)) {
            foundDate = candidate;
            const parts = candidate.split(' ');
            dateField.value = parts[0].replace(/:/g, '-');
            timeField.value = parts[1];
            break;
          }
        }
      }

      currentDate.textContent = foundDate;
      if (foundDate === 'None / Not Found') {
        const now = new Date();
        dateField.value = now.toISOString().split('T')[0];
        timeField.value = '12:00:00';
      }
    });

    saveBtn?.addEventListener('click', async () => {
      if (!activeFile || !fileBuffer) return;

      const mode = (document.querySelector('input[name="mode"]:checked') as HTMLInputElement).value;
      const copy = new Uint8Array(fileBuffer.slice(0));
      const textEncoder = new TextEncoder();
      const textDecoder = new TextDecoder('ascii');
      const dateRegex = /\b(19\d\d|20\d\d):([01]\d):([0-3]\d) ([0-2]\d):([0-5]\d):([0-5]\d)\b/;

      if (mode === 'set') {
        const newDateStr = formatExifString(dateField.value, timeField.value);
        const encodedNew = textEncoder.encode(newDateStr);

        for (let i = 0; i < Math.min(copy.length - 20, 65536); i++) {
          if (copy[i] === 0x31 || copy[i] === 0x32) {
            const candidate = textDecoder.decode(copy.subarray(i, i + 19));
            if (dateRegex.test(candidate)) {
              copy.set(encodedNew, i);
            }
          }
        }
      } else {
        // Strip mode: overwrite timestamp bytes with spaces or nulls
        const blank = textEncoder.encode('                   ');
        for (let i = 0; i < Math.min(copy.length - 20, 65536); i++) {
          if (copy[i] === 0x31 || copy[i] === 0x32) {
            const candidate = textDecoder.decode(copy.subarray(i, i + 19));
            if (dateRegex.test(candidate)) {
              copy.set(blank, i);
            }
          }
        }
      }

      const cleanBlob = new Blob([copy], { type: activeFile.type || 'image/jpeg' });
      downloadBlob(cleanBlob, activeFile.name.replace(/\.jpe?g$/i, '-date-updated.jpg'));
    });

    clearBtn?.addEventListener('click', () => {
      results.hidden = true;
      activeFile = null;
      fileBuffer = null;
    });
  }
</script>
