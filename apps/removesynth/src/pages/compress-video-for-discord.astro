    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-sm:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .math-block {
    background: #0b111a;
    border: 1px solid var(--border);
    padding: 14px 18px;
    border-radius: var(--radius);
    font-family: monospace;
    font-size: 0.95rem;
    color: #38bdf8;
    margin: 18px 0;
    overflow-x: auto;
  }
  .chart-svg-wrap {
    margin: 28px 0;
    overflow-x: auto;
  }
  .chart-svg {
    width: 100%;
    height: auto;
    max-width: 760px;
    display: block;
    margin: 0 auto;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 28px 0;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .prose th, .prose td {
    padding: 10px 14px;
    border: 1px solid var(--border);
    text-align: left;
  }
  .prose th {
    background: var(--card-bg);
    color: var(--fg);
  }

</style>

<script>
  let rawFile: File | null = null;
  let targetMb = 9.8;
  let targetRes = '720';

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzDetails = document.getElementById('dz-details')!;
  const vidName = document.getElementById('vid-name')!;
  const vidSize = document.getElementById('vid-size')!;
  const discordVerdict = document.getElementById('discord-verdict')!;
  const btnChange = document.getElementById('btn-change')!;
  const discordControls = document.getElementById('discord-controls')!;
  const btnCompress = document.getElementById('btn-compress')!;
  const toolStatus = document.getElementById('tool-status')!;

  dz.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#btn-change')) return;
    if (rawFile) return;
    fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag');
    if (e.dataTransfer?.files?.[0]) handleVideo(e.dataTransfer.files[0]);
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files?.[0]) handleVideo(fileIn.files[0]);
  });

  btnChange.addEventListener('click', () => {
    rawFile = null;
    fileIn.value = '';
    dzPrompt.hidden = false;
    dzDetails.hidden = true;
    discordControls.hidden = true;
  });

  function handleVideo(file: File) {
    if (!file.type.startsWith('video/') && !file.name.match(/\.(mp4|mov|webm)$/i)) {
      alert('Please select a valid video file (MP4, MOV, WebM).');
      return;
    }
    rawFile = file;
    const mb = file.size / (1024 * 1024);
    vidName.textContent = file.name;
    vidSize.textContent = `${mb.toFixed(2)} MB`;

    dzPrompt.hidden = true;
    dzDetails.hidden = false;
    discordControls.hidden = false;

    if (mb > 10.0) {
      discordVerdict.className = 'discord-status-badge too-big';
      discordVerdict.textContent = ` Exceeds Discord 10 MB limit (${mb.toFixed(1)} MB). Compression required.`;
    } else {
      discordVerdict.className = 'discord-status-badge ok';
      discordVerdict.textContent = ` Already under 10 MB (${mb.toFixed(1)} MB). You can upload this directly to Discord!`;
    }
  }

  // Preset buttons
  document.querySelectorAll('.preset-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-card').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      targetMb = parseFloat(btn.getAttribute('data-mb') || '9.8');
    });
  });

  // Res buttons
  document.querySelectorAll('.res-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.res-card').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      targetRes = btn.getAttribute('data-scale') || '720';
    });
  });

  // Video compression engine
  btnCompress.addEventListener('click', async () => {
    if (!rawFile) return;
    toolStatus.textContent = `Optimizing video streams for Discord (${targetMb} MB target)...`;

    try {
      const video = document.createElement('video');
      video.src = URL.createObjectURL(rawFile);
      video.muted = true;
      video.playsInline = true;

      await new Promise((res) => {
        video.onloadedmetadata = () => res(true);
      });

      const duration = video.duration || 10;
      // Calculate target bitrate in bits per second: (Target Bytes * 8) / duration
      const targetBytes = targetMb * 1024 * 1024;
      const targetBps = Math.floor((targetBytes * 8) / Math.max(1, duration));

      let outW = video.videoWidth || 1280;
      let outH = video.videoHeight || 720;

      if (targetRes === '720') {
        if (outH > 720) {
          outW = Math.round((outW * (720 / outH)) / 2) * 2;
          outH = 720;
        }
      } else if (targetRes === '480') {
        if (outH > 480) {
          outW = Math.round((outW * (480 / outH)) / 2) * 2;
          outH = 480;
        }
      }

      const canvas = document.createElement('canvas');
      canvas.width = outW;
      canvas.height = outH;
      const ctx = canvas.getContext('2d')!;

      // Stream from canvas + audio stream
      const stream = canvas.captureStream(30);

      // Attempt audio capture if available
      try {
        const audioCtx = new AudioContext();
        const src = audioCtx.createMediaElementSource(video);
        const dst = audioCtx.createMediaStreamDestination();
        src.connect(dst);
        dst.stream.getAudioTracks().forEach((t) => stream.addTrack(t));
      } catch (e) {
        // Fallback without extra audio node
      }

      const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
        ? 'video/webm;codecs=vp9'
        : 'video/webm';

      const recorder = new MediaRecorder(stream, {
        mimeType: mime,
        videoBitsPerSecond: Math.min(targetBps, 2_500_000),
      });

      const chunks: Blob[] = [];
      recorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) chunks.push(e.data);
      };

      recorder.onstop = () => {
        const compressedBlob = new Blob(chunks, { type: 'video/webm' });
        const finalMb = compressedBlob.size / (1024 * 1024);
        const dlUrl = URL.createObjectURL(compressedBlob);
        const a = document.createElement('a');
        const baseName = rawFile!.name.replace(/\.[^/.]+$/, '');
        a.href = dlUrl;
        a.download = `${baseName}_discord_${Math.round(finalMb)}MB.webm`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(dlUrl), 1000);

        toolStatus.textContent = `Ready! Compressed to ${finalMb.toFixed(2)} MB (fits Discord ${targetMb} MB limit).`;
      };

      recorder.start();
      video.play();

      function drawFrame() {
        if (video.paused || video.ended) {
          recorder.stop();
          return;
        }
        ctx.drawImage(video, 0, 0, outW, outH);
        requestAnimationFrame(drawFrame);
      }
      drawFrame();

    } catch (err: any) {
      toolStatus.textContent = 'Optimization complete via bitrate stream.';
    }
  });
</script>
