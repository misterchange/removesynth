</style>

<script>
  // Filter chips
  const chips = document.querySelectorAll('.tab-chip');
  const cards = document.querySelectorAll('.platform-card');

  chips.forEach((c) => {
    c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.remove('active'));
      c.classList.add('active');
      const filter = c.getAttribute('data-filter');

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const status = el.getAttribute('data-status');
        if (filter === 'all') {
          el.style.display = 'block';
        } else if (filter === 'danger') {
          el.style.display = (status === 'danger' || status === 'warning') ? 'block' : 'none';
        } else if (filter === 'safe') {
          el.style.display = status === 'safe' ? 'block' : 'none';
        }
      });
    });
  });

  // Tester
  const btnSelect = document.getElementById('btn-select')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const testResult = document.getElementById('test-result')!;

  btnSelect.addEventListener('click', () => fileIn.click());

  fileIn.addEventListener('change', async () => {
    if (!fileIn.files?.[0]) return;
    const file = fileIn.files[0];
    const buffer = await file.arrayBuffer();
    const bytes = new Uint8Array(buffer);
    const text = new TextDecoder('latin1').decode(bytes.subarray(0, Math.min(bytes.length, 256 * 1024)));

    const hasGps = text.includes('GPS') || text.includes('©xyz');
    const hasExif = text.includes('Exif');

    testResult.hidden = false;
    testResult.innerHTML = `
      <strong>Analysis for "${file.name}":</strong><br />
      • EXIF Camera Data: ${hasExif ? '<span style="color:#ef4444"> Present (Model &amp; Timestamp embedded)</span>' : '<span style="color:#10b981"> Clean</span>'}<br />
      • GPS Location Coordinates: ${hasGps ? '<span style="color:#ef4444"> FOUND (Your exact location is inside this file!)</span>' : '<span style="color:#10b981"> No GPS tags found</span>'}<br /><br />
      ${(hasGps || hasExif) ? ' <em>Recommendation:</em> Clean this photo with our <a href="/photo-metadata-remover/" style="color:var(--accent)">Photo Metadata Remover</a> before sharing on iMessage, AirDrop, or as WhatsApp/Telegram document.' : ' This photo does not contain private GPS coordinates.'}
    `;
  });
</script>
