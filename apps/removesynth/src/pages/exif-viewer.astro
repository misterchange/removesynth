<script>
  let rawFile: File | null = null;
  let parsedTags: { name: string; cat: string; val: string }[] = [];

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzActiveBar = document.getElementById('dz-active-bar')!;
  const photoFilename = document.getElementById('photo-filename')!;
  const photoFilesize = document.getElementById('photo-filesize')!;
  const btnChange = document.getElementById('btn-change')!;
  const dashboard = document.getElementById('dashboard')!;

  const privacyDot = document.getElementById('privacy-dot')!;
  const privacyTitle = document.getElementById('privacy-title')!;
  const privacyDesc = document.getElementById('privacy-desc')!;
  const btnStripAll = document.getElementById('btn-strip-all')!;

  const valCamera = document.getElementById('val-camera')!;
  const valMake = document.getElementById('val-make')!;
  const valLens = document.getElementById('val-lens')!;
  const valFocal = document.getElementById('val-focal')!;
  const valAperture = document.getElementById('val-aperture')!;
  const valShutter = document.getElementById('val-shutter')!;
  const valIso = document.getElementById('val-iso')!;
  const valDate = document.getElementById('val-date')!;
  const valTime = document.getElementById('val-time')!;

  const gpsCard = document.getElementById('gps-card')!;
  const valLat = document.getElementById('val-lat')!;
  const valLng = document.getElementById('val-lng')!;
  const valAlt = document.getElementById('val-alt')!;
  const linkMap = document.getElementById('link-map') as HTMLAnchorElement;

  const tagsCount = document.getElementById('tags-count')!;
  const tagSearch = document.getElementById('tag-search') as HTMLInputElement;
  const tagsTbody = document.getElementById('tags-tbody')!;

  dz.addEventListener('click', (e) => {
    if (e.target !== btnChange) fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag-active');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag-active'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag-active');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      loadFile(e.dataTransfer.files[0]);
    }
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files && fileIn.files[0]) {
      loadFile(fileIn.files[0]);
    }
  });

  btnChange.addEventListener('click', (e) => {
    e.stopPropagation();
    fileIn.click();
  });

  function formatBytes(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function loadFile(file: File) {
    rawFile = file;
    photoFilename.textContent = file.name;
    photoFilesize.textContent = `${formatBytes(file.size)} • ${file.type || 'image/jpeg'}`;
    dzPrompt.hidden = true;
    dzActiveBar.hidden = false;
    dashboard.hidden = false;

    parseExif(file);
  }

  async function parseExif(file: File) {
    const buf = await file.arrayBuffer();
    const view = new DataView(buf);
    parsedTags = [];

    let hasGPS = false;
    let hasSerial = false;
    let cameraMake = '';
    let cameraModel = '';
    let lensModel = '';
    let focalLength = '';
    let fNumber = '';
    let exposureTime = '';
    let iso = '';
    let dateTime = '';
    let latVal = 0, lngVal = 0, altVal = '';

    // Check JPEG SOI (0xFFD8)
    if (view.getUint16(0) === 0xffd8) {
      let offset = 2;
      while (offset < view.byteLength) {
        if (view.getUint8(offset) !== 0xff) break;
        const marker = view.getUint8(offset + 1);
        const len = view.getUint16(offset + 2);

        // APP1 Marker (EXIF or XMP)
        if (marker === 0xe1) {
          const sig = String.fromCharCode(
            view.getUint8(offset + 4),
            view.getUint8(offset + 5),
            view.getUint8(offset + 6),
            view.getUint8(offset + 7)
          );

          if (sig === 'Exif') {
            const tiffOffset = offset + 10;
            const isLittle = view.getUint16(tiffOffset) === 0x4949;
            const ifdOffset = view.getUint32(tiffOffset + 4, isLittle);

            function readTag(tagOffset: number, category: string) {
              const numEntries = view.getUint16(tagOffset, isLittle);
              let entryPtr = tagOffset + 2;

              for (let i = 0; i < numEntries; i++) {
                const tag = view.getUint16(entryPtr, isLittle);
                const type = view.getUint16(entryPtr + 2, isLittle);
                const count = view.getUint32(entryPtr + 4, isLittle);
                const valOffset = entryPtr + 8;

                let tagVal = '';

                // ASCII string
                if (type === 2) {
                  let strPtr = count > 4 ? tiffOffset + view.getUint32(valOffset, isLittle) : valOffset;
                  let str = '';
                  for (let s = 0; s < count - 1; s++) {
                    str += String.fromCharCode(view.getUint8(strPtr + s));
                  }
                  tagVal = str.trim();
                } else if (type === 3) {
                  // Short (16-bit)
                  tagVal = String(view.getUint16(valOffset, isLittle));
                } else if (type === 4) {
                  // Long (32-bit)
                  tagVal = String(view.getUint32(valOffset, isLittle));
                } else if (type === 5) {
                  // Rational
                  const rPtr = tiffOffset + view.getUint32(valOffset, isLittle);
                  const num = view.getUint32(rPtr, isLittle);
                  const den = view.getUint32(rPtr + 4, isLittle);
                  tagVal = den !== 0 ? (num / den).toFixed(2) : '0';
                }

                // Tag mapping
                if (tag === 0x010f) { cameraMake = tagVal; parsedTags.push({ name: 'Make', cat: 'Camera', val: tagVal }); }
                else if (tag === 0x0110) { cameraModel = tagVal; parsedTags.push({ name: 'Model', cat: 'Camera', val: tagVal }); }
                else if (tag === 0x0132) { dateTime = tagVal; parsedTags.push({ name: 'DateTime', cat: 'Timestamp', val: tagVal }); }
                else if (tag === 0x0131) { parsedTags.push({ name: 'Software', cat: 'Editing', val: tagVal }); }
                else if (tag === 0x829a) {
                  // Exposure Time
                  const rPtr = tiffOffset + view.getUint32(valOffset, isLittle);
                  const num = view.getUint32(rPtr, isLittle);
                  const den = view.getUint32(rPtr + 4, isLittle);
                  exposureTime = num === 1 ? `1/${den}` : `${(num/den).toFixed(3)}`;
                  parsedTags.push({ name: 'ExposureTime', cat: 'Exposure', val: `${exposureTime}s` });
                } else if (tag === 0x829d) {
                  // FNumber
                  fNumber = tagVal;
                  parsedTags.push({ name: 'FNumber', cat: 'Exposure', val: `f/${tagVal}` });
                } else if (tag === 0x8827) {
                  // ISO
                  iso = tagVal;
                  parsedTags.push({ name: 'ISOSpeedRatings', cat: 'Exposure', val: tagVal });
                } else if (tag === 0x920a) {
                  // Focal Length
                  focalLength = tagVal;
                  parsedTags.push({ name: 'FocalLength', cat: 'Lens', val: `${tagVal} mm` });
                } else if (tag === 0xa434) {
                  lensModel = tagVal;
                  parsedTags.push({ name: 'LensModel', cat: 'Lens', val: tagVal });
                } else if (tag === 0xa431) {
                  hasSerial = true;
                  parsedTags.push({ name: 'BodySerialNumber', cat: 'Hardware', val: tagVal });
                } else if (tag === 0x8769) {
                  // Exif SubIFD
                  const subIfdOffset = tiffOffset + view.getUint32(valOffset, isLittle);
                  readTag(subIfdOffset, 'EXIF');
                } else if (tag === 0x8825) {
                  // GPS SubIFD
                  hasGPS = true;
                  const gpsOffset = tiffOffset + view.getUint32(valOffset, isLittle);
                  readGps(gpsOffset);
                }

                entryPtr += 12;
              }
            }

            function readGps(gpsPtr: number) {
              const numEntries = view.getUint16(gpsPtr, isLittle);
              let ptr = gpsPtr + 2;
              let latRef = 'N', lngRef = 'W';

              for (let i = 0; i < numEntries; i++) {
                const tag = view.getUint16(ptr, isLittle);
                const valOffset = ptr + 8;

                if (tag === 0x0001) latRef = String.fromCharCode(view.getUint8(valOffset));
                else if (tag === 0x0003) lngRef = String.fromCharCode(view.getUint8(valOffset));
                else if (tag === 0x0002) {
                  // Lat rationals
                  const rPtr = tiffOffset + view.getUint32(valOffset, isLittle);
                  const d = view.getUint32(rPtr, isLittle) / view.getUint32(rPtr + 4, isLittle);
                  const m = view.getUint32(rPtr + 8, isLittle) / view.getUint32(rPtr + 12, isLittle);
                  const s = view.getUint32(rPtr + 16, isLittle) / view.getUint32(rPtr + 20, isLittle);
                  latVal = d + m / 60 + s / 3600;
                  if (latRef === 'S') latVal = -latVal;
                } else if (tag === 0x0004) {
                  // Lng rationals
                  const rPtr = tiffOffset + view.getUint32(valOffset, isLittle);
                  const d = view.getUint32(rPtr, isLittle) / view.getUint32(rPtr + 4, isLittle);
                  const m = view.getUint32(rPtr + 8, isLittle) / view.getUint32(rPtr + 12, isLittle);
                  const s = view.getUint32(rPtr + 16, isLittle) / view.getUint32(rPtr + 20, isLittle);
                  lngVal = d + m / 60 + s / 3600;
                  if (lngRef === 'W') lngVal = -lngVal;
                } else if (tag === 0x0006) {
                  const rPtr = tiffOffset + view.getUint32(valOffset, isLittle);
                  altVal = `${(view.getUint32(rPtr, isLittle) / view.getUint32(rPtr + 4, isLittle)).toFixed(1)} m`;
                }

                ptr += 12;
              }

              parsedTags.push({ name: 'GPSLatitude', cat: 'Location', val: latVal.toFixed(6) });
              parsedTags.push({ name: 'GPSLongitude', cat: 'Location', val: lngVal.toFixed(6) });
            }

            readTag(tiffOffset + ifdOffset, 'IFD0');
          }
        }
        offset += 2 + len;
      }
    }

    // Populate Visual Badges
    valCamera.textContent = cameraModel || (cameraMake ? `${cameraMake} Camera` : 'Not Specified');
    valMake.textContent = cameraMake || 'Standard Sensor';
    valLens.textContent = lensModel || (focalLength ? `${focalLength} mm prime/zoom` : 'Built-in Lens');
    valFocal.textContent = focalLength ? `${focalLength} mm equivalent` : 'Standard Angle';
    valAperture.textContent = fNumber ? `f/${fNumber}` : 'f/--';
    valShutter.textContent = exposureTime ? `${exposureTime}s` : '-- sec';
    valIso.textContent = iso ? `ISO ${iso}` : 'ISO --';
    
    if (dateTime) {
      const parts = dateTime.split(' ');
      valDate.textContent = parts[0]?.replace(/:/g, '-') || dateTime;
      valTime.textContent = parts[1] || 'Capture time';
    } else {
      valDate.textContent = 'No Timestamp';
      valTime.textContent = 'EXIF date absent';
    }

    // Populate GPS Card
    if (hasGPS && (latVal !== 0 || lngVal !== 0)) {
      gpsCard.hidden = false;
      valLat.textContent = latVal.toFixed(6);
      valLng.textContent = lngVal.toFixed(6);
      valAlt.textContent = altVal || 'N/A';
      linkMap.href = `https://www.openstreetmap.org/?mlat=${latVal}&mlon=${lngVal}#map=16/${latVal}/${lngVal}`;
    } else {
      gpsCard.hidden = true;
    }

    // Privacy Status Banner
    if (hasGPS) {
      privacyDot.className = 'privacy-status-dot red';
      privacyTitle.textContent = 'High Privacy Risk: Exact GPS Location Found';
      privacyDesc.textContent = 'This photo reveals the precise location where it was taken. Clean before sharing.';
    } else if (hasSerial || parsedTags.length > 5) {
      privacyDot.className = 'privacy-status-dot yellow';
      privacyTitle.textContent = 'Moderate Privacy Risk: Device & Timestamp Metadata Found';
      privacyDesc.textContent = `${parsedTags.length} tags discovered. Camera details, dates, and settings are exposed.`;
    } else {
      privacyDot.className = 'privacy-status-dot green';
      privacyTitle.textContent = 'Clean / Low Metadata Footprint';
      privacyDesc.textContent = 'No GPS location or serial numbers detected.';
    }

    // Render Table
    renderTagsTable(parsedTags);
  }

  function renderTagsTable(tags: { name: string; cat: string; val: string }[]) {
    tagsCount.textContent = String(tags.length);
    tagsTbody.innerHTML = '';

    if (tags.length === 0) {
      tagsTbody.innerHTML = '<tr><td colspan="3" class="muted">No technical EXIF tags discovered in this file.</td></tr>';
      return;
    }

    tags.forEach((t) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><strong>${t.name}</strong></td>
        <td><span class="tag-cat">${t.cat}</span></td>
        <td class="tag-val-col">${t.val}</td>
      `;
      tagsTbody.appendChild(tr);
    });
  }

  // Search filter
  tagSearch.addEventListener('input', () => {
    const q = tagSearch.value.toLowerCase().trim();
    const filtered = parsedTags.filter(
      (t) => t.name.toLowerCase().includes(q) || t.cat.toLowerCase().includes(q) || t.val.toLowerCase().includes(q)
    );
    renderTagsTable(filtered);
  });

  // Clean all metadata & download in one click
  btnStripAll.addEventListener('click', async () => {
    if (!rawFile) return;

    btnStripAll.disabled = true;
    btnStripAll.textContent = 'Sanitizing...';

    const img = new Image();
    const url = URL.createObjectURL(rawFile);
    img.src = url;

    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.naturalWidth;
      canvas.height = img.naturalHeight;
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(img, 0, 0);

      canvas.toBlob((blob) => {
        if (blob) {
          const downloadUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          const cleanName = rawFile!.name.replace(/\.[^/.]+$/, '') + '-clean.jpg';
          a.href = downloadUrl;
          a.download = cleanName;
          a.click();
          URL.revokeObjectURL(downloadUrl);

          btnStripAll.disabled = false;
          btnStripAll.innerHTML = `
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6L9 17l-5-5"></path>
            </svg>
            Cleaned Photo Downloaded!
          `;
          setTimeout(() => {
            btnStripAll.innerHTML = `
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              Clean All Metadata &amp; Download
            `;
          }, 3500);
        }
      }, 'image/jpeg', 0.94);

      URL.revokeObjectURL(url);
    };
  });
</script>


