---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'ExifTool Online: Free In-Browser Metadata Viewer';
const description =
  'Inspect and strip detailed EXIF, IPTC, and XMP metadata from your photos in your browser. Fast client-side ExifTool inspector with zero server file uploads.';

const faqs: FaqItem[] = [
  {
    q: 'What is ExifTool Online?',
    a: 'ExifTool Online is a browser-based, zero-installation alternative to Phil Harvey’s renowned command-line ExifTool utility. It parses JPEG, PNG, WebP, and AVIF metadata segments, displays tag values in an interactive inspection table, and scrubs all private headers in one click.',
  },
  {
    q: 'How does it compare to command-line "exiftool -all="?',
    a: 'Running "exiftool -all= image.jpg" in the terminal removes all metadata markers (APP1 through APP15, EXIF, IPTC, XMP). Our in-browser engine does the exact same thing locally: it reconstructs the image binary without any auxiliary metadata segments, keeping the core image stream 100% intact.',
  },
  {
    q: 'Do you upload my files to a server like Metadata2Go?',
    a: 'No. Unlike websites such as Metadata2Go or Jimpl that upload your files to remote cloud servers to run Perl scripts, RemoveSynth processes 100% of your data inside your local browser memory using JavaScript.',
  },
  {
    q: 'Does stripping metadata reduce image quality or change colors?',
    a: 'No. Stripping metadata removes only text and binary informational headers (camera settings, timestamps, GPS, software logs). The visual pixel payload is untouched.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Tools', url: `${SITE.url}/tools/` },
    { name: 'ExifTool online', url: `${SITE.url}/exiftool-online/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ExifTool Online Web Alternative',
    url: `${SITE.url}/exiftool-online/`,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  faqSchema(faqs),
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Zero Uploads · CLI Equivalent · 100% Private</span>
      <h1>ExifTool <span class="accent">online</span></h1>
      <p class="lead">
        A private, in-browser alternative to ExifTool and ExifCleaner. Read every EXIF, IPTC, and XMP tag, then strip all metadata in one click.
      </p>

      <!-- ExifTool Stage -->
      <div class="tool-stage">
        <Jitter side="left" />
        <div class="et-tool" id="et-tool">
          <!-- Dropzone -->
          <div class="et-dropzone" id="dz">
            <input type="file" id="file-in" accept="image/jpeg,image/png,image/webp,image/avif" hidden />
            <div class="dz-prompt" id="dz-prompt">
              <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" y1="19" x2="20" y2="19"></line>
              </svg>
              <p><strong>Click or drag an image here to inspect tags</strong></p>
              <span class="small muted">JPG, PNG, WebP · Equivalent to <code>exiftool -all=</code></span>
            </div>
            <div class="dz-details" id="dz-details" hidden>
              <div class="file-stat-bar">
                <span class="file-name" id="file-name"></span>
                <span class="badge" id="tag-count">0 tags detected</span>
              </div>
              <button type="button" class="btn-sm btn-ghost" id="btn-change">Inspect another file</button>
            </div>
          </div>

          <!-- Metadata Terminal / Table -->
          <div class="et-inspector" id="et-inspector" hidden>
            <div class="terminal-header">
              <div class="term-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="term-title">Metadata Inspector (Terminal View)</span>
              <button type="button" class="btn-xs" id="btn-copy-tags">Copy Raw JSON</button>
            </div>
            <div class="terminal-body" id="term-body"></div>

            <div class="actions-row">
              <button type="button" class="btn btn-primary" id="btn-strip-all">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Strip All Metadata (exiftool -all=)
              </button>
              <span class="tool-status small" id="tool-status" role="status" aria-live="polite"></span>
            </div>
          </div>
        </div>
        <Jitter side="right" />
      </div>
    </div>
  </section>

  <article class="prose">
    <h2>What Is ExifTool Online and How Does It Compare to Phil Harvey's CLI?</h2>
    <p>
      Phil Harvey's open-source <strong>ExifTool</strong> is universally recognized across cybersecurity, digital forensics, and professional photography as the premier command-line utility for reading, writing, and manipulating multimedia metadata. However, deploying native ExifTool presents technical friction for average users: it requires a Perl runtime environment, terminal proficiency, manual executable compilation on modern macOS, and familiarity with dozens of cryptographic flags.
    </p>
    <p>
      RemoveSynth's <strong>ExifTool Online</strong> brings the analytical power of ExifTool into a modern, zero-installation web application. Operating directly in any web browser via WebAssembly and JavaScript byte readers, it parses deep TIFF Image File Directories (IFD), extracts EXIF, IPTC, and XMP tags, and provides instantaneous one-click metadata erasure identical to running <code>exiftool -all= -overwrite_original</code> in your terminal.
    </p>

    <h2>The Dangers of Server-Side ExifTool Alternatives: Metadata2Go, Jimpl, and VerExif</h2>
    <p>
      When users search for web-based alternatives to ExifTool, they encounter legacy file inspection portals like Metadata2Go, Jimpl, and VerExif. These websites operate on outdated client-server architectures fraught with privacy and security hazards:
    </p>
    <ul>
      <li><strong>Remote Server File Uploads:</strong> When you submit a photo to Metadata2Go or Jimpl, your entire raw image (often containing personal facial photos, scanned contracts, or home GPS tags) is transmitted across the internet to an unverified third-party cloud server running Perl scripts.</li>
      <li><strong>Persistent Temporary Disk Storage:</strong> Uploaded files are written to remote server disks where server access logs, caching proxies, and automated scrapers can index sensitive document assets.</li>
      <li><strong>Bandwidth Constraints and Upload Limits:</strong> Uploading 50MB camera RAW files or multi-image batches over residential internet connections results in agonizing upload delays and frequent HTTP 504 gateway timeouts.</li>
      <li><strong>The RemoveSynth Client-Side Advantage:</strong> RemoveSynth executes 100 percent of binary parsing, tag extraction, and metadata excision locally inside your web browser memory. Not a single byte of your file is ever transmitted over the network.</li>
    </ul>

    <h2>Mathematical Model of Binary Marker Excision (exiftool -all=)</h2>
    <p>
      In binary transform theory, a JPEG image is modeled as an ordered sequence of contiguous marker segments terminated by entropy-coded pixel scans:
    </p>
    <div class="math-block">
      <code>JPEG_Binary = SOI || Marker_1(Type, Len, Data) || Marker_2(Type, Len, Data) || ... || SOS || ScanData || EOI</code>
    </div>
    <p>
      Where the Start of Image is <code>SOI = 0xFFD8</code> and the End of Image is <code>EOI = 0xFFD9</code>. The command-line operation <code>exiftool -all= image.jpg</code> executes a binary excision filter that strips all auxiliary application segments in the range <code>[0xFFE1, 0xFFEF]</code> while preserving structural decoding tables:
    </p>
    <div class="math-block">
      <code>Preserved_Markers = &#123; Marker | Marker.Type in &#123; 0xFFE0 (APP0_JFIF), 0xFFDB (DQT), 0xFFC0 (SOF0), 0xFFC4 (DHT), 0xFFDA (SOS) &#125; &#125;</code>
    </div>
    <p>
      Because the quantization tables (DQT), Huffman coding trees (DHT), and discrete cosine transform coefficients in <code>ScanData</code> remain completely untouched:
    </p>
    <div class="math-block">
      <code>PSNR(Pixels_Original, Pixels_Sanitized) = Infinity dB  (100% Lossless Bitstream Integrity)</code>
    </div>

    <h2>Worked Example: Inspecting and Stripping 214 Metadata Tags from a Canon EOS R5 Photo</h2>
    <p>
      To illustrate the analytical fidelity of our browser tool, consider inspecting a raw-derived commercial photograph:
    </p>
    <ul>
      <li><strong>Camera Hardware:</strong> Canon EOS R5 paired with Canon RF 24-70mm f/2.8L IS USM lens</li>
      <li><strong>Input File:</strong> High-resolution studio portrait (<code>studio-portrait-raw-export.jpg</code>)</li>
      <li><strong>Original File Size:</strong> 18,240,110 bytes (17.39 Megabytes)</li>
      <li><strong>Total Tags Detected:</strong> 214 discrete metadata tags across 4 primary namespaces</li>
      <li><strong>Detected Sensitive Data:</strong> Camera Body Serial Number (<code>042021001492</code>), Lens Serial Number (<code>9820001412</code>), Internal Owner Name (&quot;Studio J. Reynolds&quot;), Exact Shutter Count (14,210 cycles), Firmware Version (v1.8.1), GPS Coordinates (Latitude <code>40 deg 42 min 46.1 sec N</code>, Longitude <code>74 deg 00 min 21.6 sec W</code>), Photoshop XMP DocumentAncestors block (142 KB XML payload)</li>
      <li><strong>Execution Action:</strong> Clicked &quot;Strip All Metadata (exiftool -all=)&quot;</li>
      <li><strong>Sanitized Output File Size:</strong> 18,062,400 bytes (17.22 Megabytes)</li>
      <li><strong>Payload Excision:</strong> 177,710 bytes of invisible tracking markers and XML bloat purged</li>
      <li><strong>Visual Quality:</strong> Bit-for-bit lossless ($PSNR = \infty$)</li>
      <li><strong>Processing Speed:</strong> 26 milliseconds in local browser WebAssembly memory</li>
    </ul>

    <h2>In-Browser ExifTool Parser and Stripping Pipeline Architecture</h2>
    <p>
      The vector diagram below traces how our local in-browser engine parses TIFF IFD hierarchies and reconstructs metadata-free image streams.
    </p>
