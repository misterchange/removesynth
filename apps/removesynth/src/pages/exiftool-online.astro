          </tr>
          <tr>
            <td><strong>Inject Realistic EXIF</strong></td>
            <td><code>exiftool -Make="SONY" -Model="A7M4" image.jpg</code></td>
            <td><a href="/add-camera-exif/">Add Camera EXIF Tool</a></td>
            <td>Presets for Sony, Canon, Nikon, Apple</td>
          </tr>
          <tr>
            <td><strong>Change Date Taken</strong></td>
            <td><code>exiftool -DateTimeOriginal="2024:01:01 12:00:00" image.jpg</code></td>
            <td><a href="/change-photo-date/">Change Photo Date Tool</a></td>
            <td>Batch timestamp editor</td>
          </tr>
          <tr>
            <td><strong>Remove C2PA Provenance</strong></td>
            <td><code>exiftool -xmp:c2pa= -app11:all= video.mp4</code></td>
            <td><a href="/remove-c2pa-from-video/">Remove C2PA from Video</a></td>
