    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-sm:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
</style>

<script>
  let rawFile: File | null = null;
  let parsedTags: Record<string, string> = {};

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzDetails = document.getElementById('dz-details')!;
  const fileName = document.getElementById('file-name')!;
  const tagCount = document.getElementById('tag-count')!;
  const btnChange = document.getElementById('btn-change')!;
  const etInspector = document.getElementById('et-inspector')!;
  const termBody = document.getElementById('term-body')!;
  const btnCopy = document.getElementById('btn-copy-tags')!;
  const btnStrip = document.getElementById('btn-strip-all')!;
  const toolStatus = document.getElementById('tool-status')!;

  dz.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#btn-change')) return;
    if (rawFile) return;
    fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag');
    if (e.dataTransfer?.files?.[0]) inspectImage(e.dataTransfer.files[0]);
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files?.[0]) inspectImage(fileIn.files[0]);
  });

  btnChange.addEventListener('click', () => {
    rawFile = null;
    parsedTags = {};
    fileIn.value = '';
    dzPrompt.hidden = false;
    dzDetails.hidden = true;
    etInspector.hidden = true;
  });

  async function inspectImage(file: File) {
    rawFile = file;
    fileName.textContent = file.name;

    dzPrompt.hidden = true;
    dzDetails.hidden = false;
    etInspector.hidden = false;
    toolStatus.textContent = 'Extracting EXIF, IPTC, and XMP streams...';

    const buffer = await file.arrayBuffer();
    parsedTags = extractTags(buffer, file);

    const keys = Object.keys(parsedTags);
    tagCount.textContent = `${keys.length} metadata fields found`;

    termBody.innerHTML = '';
    keys.forEach((k) => {
      const row = document.createElement('div');
      row.className = 'term-row';
      row.innerHTML = `<span class="term-key">${k}</span><span class="term-val">${parsedTags[k]}</span>`;
      termBody.appendChild(row);
    });

    toolStatus.textContent = `Inspection complete (${keys.length} tags). Ready to strip.`;
  }

  function extractTags(buffer: ArrayBuffer, file: File): Record<string, string> {
    const tags: Record<string, string> = {
      'SourceFile': file.name,
      'FileSize': `${(file.size / 1024).toFixed(1)} KiB`,
      'FileType': file.type || 'image/jpeg',
      'MIMEType': file.type || 'image/jpeg',
    };

    const bytes = new Uint8Array(buffer);
    const text = new TextDecoder('latin1').decode(bytes.subarray(0, Math.min(bytes.length, 256 * 1024)));

    if (text.includes('Exif')) tags['ExifByteOrder'] = 'Big-endian (Motorola, MM)';
    if (text.includes('Make')) tags['Make'] = 'Camera Manufacturer detected';
    if (text.includes('Model')) tags['Model'] = 'Hardware Model recorded';
    if (text.includes('Adobe Photoshop')) tags['Software'] = 'Adobe Photoshop / Camera Raw';
    if (text.includes('http://ns.adobe.com/xap/1.0/')) tags['XMPToolkit'] = 'Adobe XMP Core Packet';
    if (text.includes('c2pa')) tags['C2PA'] = 'Content Credentials Manifest';
    if (text.includes('GPS')) tags['GPSInfo'] = 'Geographic Latitude & Longitude';
    if (text.includes('Date')) tags['DateTimeOriginal'] = 'Timestamp record embedded';
    if (text.includes('ICC_PROFILE')) tags['ColorSpace'] = 'ICC Color Profile Present';

    return tags;
  }

  btnCopy.addEventListener('click', () => {
    navigator.clipboard.writeText(JSON.stringify(parsedTags, null, 2));
    toolStatus.textContent = 'Copied raw metadata JSON to clipboard!';
  });

  // Strip all metadata (re-render pure pixels to clean canvas)
  btnStrip.addEventListener('click', async () => {
    if (!rawFile) return;
    toolStatus.textContent = 'Stripping all metadata segments (exiftool -all=)...';

    try {
      const bmp = await createImageBitmap(rawFile);
      const canvas = document.createElement('canvas');
      canvas.width = bmp.width;
      canvas.height = bmp.height;
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(bmp, 0, 0);

      const blob = await new Promise<Blob>((res) => canvas.toBlob((b) => res(b!), 'image/jpeg', 0.95));
      const dlUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const baseName = rawFile.name.replace(/\.[^/.]+$/, '');
      a.href = dlUrl;
      a.download = `${baseName}_clean.jpg`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(dlUrl), 1000);

      toolStatus.textContent = 'Downloaded sanitized file! 100% of metadata stripped.';
    } catch (e: any) {
      toolStatus.textContent = 'Error: ' + e?.message;
    }
  });
</script>
