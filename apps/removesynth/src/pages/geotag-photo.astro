<script>
  let rawFile: File | null = null;
  let rawImg: HTMLImageElement | null = null;

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzPreview = document.getElementById('dz-preview')!;
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const photoInfo = document.getElementById('photo-info')!;
  const btnChange = document.getElementById('btn-change')!;
  const geoBody = document.getElementById('geo-body')!;
  const mapWrap = document.getElementById('map-wrap')!;
  const mapPin = document.getElementById('map-pin')!;

  const fLat = document.getElementById('f-lat') as HTMLInputElement;
  const fLng = document.getElementById('f-lng') as HTMLInputElement;
  const fAlt = document.getElementById('f-alt') as HTMLInputElement;
  const fLocName = document.getElementById('f-locname') as HTMLInputElement;
  const btnGeotag = document.getElementById('btn-geotag')!;
  const toolStatus = document.getElementById('tool-status')!;

  // Coordinates <-> Map position projection
  // Lat: -90 to +90 -> Y: 100% to 0%
  // Lng: -180 to +180 -> X: 0% to 100%
  function updatePinFromCoords() {
    const lat = parseFloat(fLat.value) || 0;
    const lng = parseFloat(fLng.value) || 0;
    const xPct = ((lng + 180) / 360) * 100;
    const yPct = ((90 - lat) / 180) * 100;
    mapPin.style.left = `${Math.max(0, Math.min(100, xPct))}%`;
    mapPin.style.top = `${Math.max(0, Math.min(100, yPct))}%`;
  }

  function updateCoordsFromClick(e: MouseEvent) {
    const rect = mapWrap.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const xPct = x / rect.width;
    const yPct = y / rect.height;

    const lng = Number((xPct * 360 - 180).toFixed(6));
    const lat = Number((90 - yPct * 180).toFixed(6));

    fLat.value = String(lat);
    fLng.value = String(lng);
    fLocName.value = `Custom (${lat > 0 ? lat + '°N' : -lat + '°S'}, ${lng > 0 ? lng + '°E' : -lng + '°W'})`;
    updatePinFromCoords();
  }

  mapWrap.addEventListener('click', updateCoordsFromClick);

  fLat.addEventListener('input', updatePinFromCoords);
  fLng.addEventListener('input', updatePinFromCoords);

  // City chips
  document.querySelectorAll('.city-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      fLat.value = btn.getAttribute('data-lat') || '0';
      fLng.value = btn.getAttribute('data-lng') || '0';
      fLocName.value = btn.getAttribute('data-name') || '';
      updatePinFromCoords();
    });
  });

  // Dropzone logic
  dz.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#btn-change')) return;
    if (rawFile) return;
    fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag');
    if (e.dataTransfer?.files?.[0]) handleFile(e.dataTransfer.files[0]);
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files?.[0]) handleFile(fileIn.files[0]);
  });

  btnChange.addEventListener('click', () => {
    rawFile = null;
    rawImg = null;
    fileIn.value = '';
    dzPrompt.hidden = false;
    dzPreview.hidden = true;
    geoBody.hidden = true;
  });

  function handleFile(file: File) {
    if (!file.type.startsWith('image/')) {
      alert('Please upload an image (JPG, PNG, WebP).');
      return;
    }
    rawFile = file;
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      rawImg = img;
      previewImg.src = url;
      photoInfo.textContent = `${file.name} · ${img.naturalWidth} × ${img.naturalHeight} px (${(file.size / 1024).toFixed(1)} KB)`;
      dzPrompt.hidden = true;
      dzPreview.hidden = false;
      geoBody.hidden = false;
      updatePinFromCoords();
    };
    img.src = url;
  }

  // Decimal to Rational DMS (Degrees, Minutes, Seconds)
  function toDms(deg: number) {
    const d = Math.floor(Math.abs(deg));
    const mFloat = (Math.abs(deg) - d) * 60;
    const m = Math.floor(mFloat);
    const s = Math.round((mFloat - m) * 60 * 100);
    return [
      [d, 1],
      [m, 1],
      [s, 100],
    ];
  }

  // Create Standard EXIF with GPSInfo IFD
  function buildGpsExifApp1(lat: number, lng: number, alt: number): Uint8Array {
    const enc = new TextEncoder();
    const latRef = lat >= 0 ? 'N' : 'S';
    const lngRef = lng >= 0 ? 'E' : 'W';
    const latDms = toDms(lat);
    const lngDms = toDms(lng);

    // GPSInfo IFD has 6 tags:
    // 0: GPSVersionID (BYTE, 4) = 2, 3, 0, 0
    // 1: GPSLatitudeRef (ASCII, 2)
    // 2: GPSLatitude (RATIONAL, 3) = 24 bytes
    // 3: GPSLongitudeRef (ASCII, 2)
    // 4: GPSLongitude (RATIONAL, 3) = 24 bytes
    // 6: GPSAltitude (RATIONAL, 1) = 8 bytes
    const numGpsTags = 6;
    const gpsIfdLen = 2 + numGpsTags * 12 + 4;

    // IFD0 has 1 tag: 0x8825 (GPSInfoIFD pointer)
    const numIfd0Tags = 1;
    const ifd0Len = 2 + numIfd0Tags * 12 + 4;

    const offsetIfd0 = 8;
    const offsetGpsIfd = offsetIfd0 + ifd0Len;
    const offsetData = offsetGpsIfd + gpsIfdLen;

    // Data buffer needed:
    // Latitude rationals: 24 bytes
    // Longitude rationals: 24 bytes
    // Altitude rational: 8 bytes
    const totalTiff = offsetData + 24 + 24 + 8;
    const tiff = new Uint8Array(totalTiff);
    const view = new DataView(tiff.buffer);

    // TIFF Header: 'MM' (big-endian), 42, offset to IFD0
    tiff[0] = 0x4D; tiff[1] = 0x4D;
    view.setUint16(2, 42);
    view.setUint32(4, offsetIfd0);

    // IFD0
    view.setUint16(offsetIfd0, numIfd0Tags);
    // Tag 0x8825: GPSInfo IFD Pointer
    view.setUint16(offsetIfd0 + 2, 0x8825);
    view.setUint16(offsetIfd0 + 4, 4); // LONG
    view.setUint32(offsetIfd0 + 6, 1);
    view.setUint32(offsetIfd0 + 10, offsetGpsIfd);
    view.setUint32(offsetIfd0 + 14, 0); // Next IFD = 0

    // GPS IFD
    let gp = offsetGpsIfd;
    view.setUint16(gp, numGpsTags);
    gp += 2;

    // 0: GPSVersionID (0x0000, BYTE[4])
    view.setUint16(gp, 0x0000); view.setUint16(gp + 2, 1); view.setUint32(gp + 4, 4);
    tiff[gp + 8] = 2; tiff[gp + 9] = 3; tiff[gp + 10] = 0; tiff[gp + 11] = 0;
    gp += 12;

    // 1: GPSLatitudeRef (0x0001, ASCII[2])
    view.setUint16(gp, 0x0001); view.setUint16(gp + 2, 2); view.setUint32(gp + 4, 2);
    tiff[gp + 8] = latRef.charCodeAt(0); tiff[gp + 9] = 0;
    gp += 12;

    let curData = offsetData;

    // 2: GPSLatitude (0x0002, RATIONAL[3])
    view.setUint16(gp, 0x0002); view.setUint16(gp + 2, 5); view.setUint32(gp + 4, 3);
    view.setUint32(gp + 8, curData);
    for (let i = 0; i < 3; i++) {
      view.setUint32(curData + i * 8, latDms[i][0]);
      view.setUint32(curData + i * 8 + 4, latDms[i][1]);
    }
    curData += 24;
    gp += 12;

    // 3: GPSLongitudeRef (0x0003, ASCII[2])
    view.setUint16(gp, 0x0003); view.setUint16(gp + 2, 2); view.setUint32(gp + 4, 2);
    tiff[gp + 8] = lngRef.charCodeAt(0); tiff[gp + 9] = 0;
    gp += 12;

    // 4: GPSLongitude (0x0004, RATIONAL[3])
    view.setUint16(gp, 0x0004); view.setUint16(gp + 2, 5); view.setUint32(gp + 4, 3);
    view.setUint32(gp + 8, curData);
    for (let i = 0; i < 3; i++) {
      view.setUint32(curData + i * 8, lngDms[i][0]);
      view.setUint32(curData + i * 8 + 4, lngDms[i][1]);
    }
    curData += 24;
    gp += 12;

    // 6: GPSAltitude (0x0006, RATIONAL[1])
    view.setUint16(gp, 0x0006); view.setUint16(gp + 2, 5); view.setUint32(gp + 4, 1);
    view.setUint32(gp + 8, curData);
    view.setUint32(curData, Math.max(0, Math.round(alt)));
    view.setUint32(curData + 4, 1);
    gp += 12;

    view.setUint32(gp, 0); // Next GPS IFD = 0

    // Wrap in JPEG APP1 (0xFF, 0xE1)
    const app1 = new Uint8Array(2 + 2 + 6 + tiff.length);
    app1[0] = 0xFF; app1[1] = 0xE1;
    const len = 2 + 6 + tiff.length;
    app1[2] = (len >> 8) & 0xFF;
    app1[3] = len & 0xFF;
    app1.set(enc.encode('Exif\0\0'), 4);
    app1.set(tiff, 10);
    return app1;
  }

  // Geotag Button
  btnGeotag.addEventListener('click', async () => {
    if (!rawFile) return;
    toolStatus.textContent = 'Injecting GPS coordinates into EXIF...';

    try {
      const bmp = await createImageBitmap(rawFile);
      const canvas = document.createElement('canvas');
      canvas.width = bmp.width;
      canvas.height = bmp.height;
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(bmp, 0, 0);

      const blob = await new Promise<Blob>((res) => canvas.toBlob((b) => res(b!), 'image/jpeg', 0.98));
      const jpegBytes = new Uint8Array(await blob.arrayBuffer());

      const lat = parseFloat(fLat.value) || 0;
      const lng = parseFloat(fLng.value) || 0;
      const alt = parseFloat(fAlt.value) || 0;

      const app1 = buildGpsExifApp1(lat, lng, alt);

      let outJpeg: Uint8Array;
      if (jpegBytes[0] === 0xFF && jpegBytes[1] === 0xD8) {
        let offset = 2;
        if (jpegBytes[2] === 0xFF && (jpegBytes[3] & 0xF0) === 0xE0) {
          const segLen = (jpegBytes[4] << 8) | jpegBytes[5];
          offset = 4 + segLen;
        }
        outJpeg = new Uint8Array(2 + app1.length + (jpegBytes.length - offset));
        outJpeg[0] = 0xFF; outJpeg[1] = 0xD8;
        outJpeg.set(app1, 2);
        outJpeg.set(jpegBytes.subarray(offset), 2 + app1.length);
      } else {
        outJpeg = jpegBytes;
      }

      const outBlob = new Blob([outJpeg], { type: 'image/jpeg' });
      const dlUrl = URL.createObjectURL(outBlob);
      const a = document.createElement('a');
      const baseName = rawFile.name.replace(/\.[^/.]+$/, '');
      a.href = dlUrl;
      a.download = `${baseName}_geotagged.jpg`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(dlUrl), 1000);

      toolStatus.textContent = `Downloaded! Embedded GPS: ${lat.toFixed(4)}°, ${lng.toFixed(4)}°`;
    } catch (err: any) {
      toolStatus.textContent = 'Error injecting GPS: ' + (err?.message || err);
    }
  });
</script>
