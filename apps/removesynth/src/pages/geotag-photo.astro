              <div class="map-canvas-wrap" id="map-wrap">
                <!-- SVG World Map Graphic for Click Pinpoint -->
                <svg id="world-map" viewBox="0 0 1000 500" preserveAspectRatio="none">
                  <rect width="1000" height="500" fill="#0d1520" />
                  <!-- Simplified World Coastline Grid -->
                  <path d="M150,120 Q220,100 280,140 Q320,180 250,220 Q190,260 160,200 Z" fill="#1b2838" />
                  <path d="M220,260 Q280,280 290,360 Q260,450 200,420 Q180,340 220,260 Z" fill="#1b2838" />
                  <path d="M460,90 Q540,70 560,130 Q510,180 440,140 Z" fill="#1b2838" />
                  <path d="M460,180 Q560,190 570,300 Q510,390 440,320 Q420,240 460,180 Z" fill="#1b2838" />
                  <path d="M600,100 Q800,80 860,160 Q800,240 680,220 Q620,160 600,100 Z" fill="#1b2838" />
                  <path d="M720,290 Q850,280 840,380 Q760,410 710,360 Z" fill="#1b2838" />
                  <!-- Lat/Lng Grid Lines -->
                  <line x1="0" y1="250" x2="1000" y2="250" stroke="#253548" stroke-dasharray="4,4" />
                  <line x1="500" y1="0" x2="500" y2="500" stroke="#253548" stroke-dasharray="4,4" />
                  <line x1="0" y1="125" x2="1000" y2="125" stroke="#162230" stroke-dasharray="2,4" />
                  <line x1="0" y1="375" x2="1000" y2="375" stroke="#162230" stroke-dasharray="2,4" />
                </svg>
                <!-- Location Pin Marker -->
                <div class="map-pin" id="map-pin">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="#40e0d0">
                    <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                    <circle cx="12" cy="10" r="3" fill="#0b1118"></circle>
                  </svg>
