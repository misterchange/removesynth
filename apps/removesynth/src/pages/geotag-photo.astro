---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'Geotag Photo Online: Add or Change GPS on Photos Free';
const description =
  'Add, edit, or remove GPS coordinates and geographic tags on your photos. In-browser photo geotagging tool with interactive map and zero server uploads.';

const faqs: FaqItem[] = [
  {
    q: 'How does geotagging photos work?',
    a: 'Digital cameras and smartphones store GPS coordinates inside an image’s EXIF metadata (specifically under the GPSInfo IFD block: Latitude, Longitude, Altitude, and Timestamp). Our tool creates or updates these standardized EXIF tags so photo apps, Lightroom, Google Photos, and Apple Photos display your photo in the exact location on the map.',
  },
  {
    q: 'Can I add GPS coordinates to photos taken without location?',
    a: 'Yes. If your camera lacked GPS, was in airplane mode, or if the photo was generated with AI, you can drop the photo here, click anywhere on the world map or enter coordinates, and inject precise GPS metadata.',
  },
  {
    q: 'Can I change or correct existing geotags on a photo?',
    a: 'Yes. If a photo was tagged at the wrong location, our tool cleanly replaces the existing GPS tags with your newly selected coordinates.',
  },
  {
    q: 'Will other photo apps recognize the geotag?',
    a: 'Yes. We write standard EXIF 2.31 GPS tags (GPSLatitude, GPSLatitudeRef, GPSLongitude, GPSLongitudeRef, GPSAltitude). Apple Photos, Google Photos, Instagram, Flickr, Adobe Lightroom, and Windows Photos will read and display the pin on their built-in maps.',
  },
  {
    q: 'Is my photo uploaded to a server?',
    a: 'No. The entire EXIF binary injection happens 100% locally in your browser using JavaScript and HTML5 Canvas. Your photos never leave your device.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Geotag Photo Online: GPS EXIF Injector',
    url: `${SITE.url}/geotag-photo/`,
    applicationCategory: 'PhotographyApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to geotag photos and add GPS coordinates online',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Upload photo',
        text: 'Drop your JPG, PNG, or WebP photo into the geotag tool above.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Pick coordinates or preset',
        text: 'Click on the interactive map, select a city preset, or enter exact latitude and longitude values.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Inject GPS and download',
        text: 'Click Geotag & Download Photo to save your image with standard EXIF 2.31 GPS tags injected in browser memory.',
      },
    ],
  },
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Tools', url: `${SITE.url}/tools/` },
    { name: 'Geotag Photo', url: `${SITE.url}/geotag-photo/` },
  ]),
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Interactive Map · 100% In-Browser · Standard EXIF 2.31</span>
      <h1>Geotag photo <span class="accent">online</span></h1>
      <p class="lead">
        Add, edit, or adjust GPS coordinates on your photos. Click anywhere on the map or pick a city preset to inject standard EXIF GPS tags into your images.
      </p>

      <!-- Geotag Tool Stage -->
      <div class="tool-stage">
        <Jitter side="left" />
        <div class="geo-tool" id="geo-tool">
          <!-- Dropzone -->
          <div class="geo-dropzone" id="dz">
            <input type="file" id="file-in" accept="image/jpeg,image/png,image/webp,image/avif" hidden />
            <div class="dz-prompt" id="dz-prompt">
              <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <p><strong>Click or drag a photo here to geotag</strong></p>
              <span class="small muted">JPG, PNG, WebP · Runs 100% locally in your browser</span>
            </div>
            <div class="dz-preview" id="dz-preview" hidden>
              <img id="preview-img" alt="Uploaded photo" />
              <div class="photo-info" id="photo-info"></div>
              <button type="button" class="btn-sm btn-ghost" id="btn-change">Change photo</button>
            </div>
          </div>

          <!-- Interactive Map & Coordinates Section -->
          <div class="geo-body" id="geo-body" hidden>
            <div class="section-label">1. Choose Location on Map or Presets</div>

            <!-- City Presets -->
            <div class="presets-row">
              <button type="button" class="city-chip" data-lat="40.7128" data-lng="-74.0060" data-name="New York, USA">New York</button>
