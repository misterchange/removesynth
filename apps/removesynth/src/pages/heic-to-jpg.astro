---
import Base from '../layouts/Base.astro';
import ToolDrop from '@removesynth/shared/components/ToolDrop.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { SITE } from '../site';

const title = 'HEIC to JPG: Free iPhone Photo Converter Online';
const description =
  'Convert iPhone HEIC photos to JPG format free in your browser. Batch convert up to 30 files, preserve quality, and download as ZIP with zero cloud uploads.';

const faqs = [
  {
    q: 'What is a HEIC file and why won’t my computer open it?',
    a: 'HEIC (High Efficiency Image Container) is the default image format used by Apple iPhones and newer Samsung devices. It employs modern HEVC compression to cut file sizes in half. However, older Windows systems, web forms, and desktop photo editors lack native HEIC codecs and cannot open the files without conversion.',
  },
  {
    q: 'Are my private photos uploaded to an external server?',
    a: 'No. The conversion executes entirely inside your web browser using WebAssembly. Your photos, family portraits, and private documents never leave your computer or smartphone.',
  },
  {
    q: 'Can I batch convert multiple HEIC photos at once?',
    a: 'Yes. You can drag and drop up to 30 HEIC images simultaneously. The converter processes them concurrently and offers a one-click ZIP download.',
  },
  {
    q: 'Is EXIF metadata and GPS location stripped during conversion?',
    a: 'Yes. Converting HEIC to JPG decodes pure bitmap frames and recompiles clean JPEG headers, automatically removing embedded GPS coordinates, device serial numbers, and camera metadata for enhanced privacy.',
  },
  {
    q: 'Which quality setting should I choose?',
    a: '92 percent quality is recommended for virtually all photography, providing visually lossless fidelity matching the original. Choose 80 percent for smaller file sizes, or 100 percent for professional archival and editing.',
  },
  {
    q: 'Does this converter work on Windows 10 and Windows 11?',
    a: 'Yes. Because RemoveSynth runs directly inside your web browser (Chrome, Edge, Firefox, Brave), you do not need to purchase the HEVC Video Extensions from the Microsoft Store.',
  },
  {
    q: 'Why are converted JPG files sometimes larger than the original HEIC?',
    a: 'HEIC utilizes advanced H.265 compression algorithms that are up to 50 percent more efficient than legacy JPEG compression. When converting back to standard 1992 JPEG format, the file size can expand slightly to maintain visual detail.',
  },
  {
    q: 'Does it support Apple Live Photos and Burst Shots?',
    a: 'Yes. The converter extracts and converts the primary full-resolution still image from the HEIC container.',
  },
];

const canonicalUrl = `${SITE.url}/heic-to-jpg/`;

const singleSchemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        url: SITE.url,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
          { '@type': 'ListItem', position: 3, name: 'HEIC to JPG Converter', item: canonicalUrl },
        ],
      },
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: 'HEIC to JPG Converter',
      url: canonicalUrl,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any (web browser)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description,
      featureList: [
        'Batch conversion up to 30 HEIC photos simultaneously',
        'Lossless quality preservation with custom compression slider',
        'Automatic EXIF and GPS privacy sanitization',
        'Direct ZIP export for multi-photo downloads',
        '100 percent in-browser WebAssembly execution with zero server uploads',
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to Convert iPhone HEIC Photos to JPG Online',
      description: 'Step-by-step instructions to convert Apple HEIC photos into universal JPG files without uploading to third-party servers.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Select HEIC photos',
          text: 'Drop or select up to 30 iPhone HEIC images into the converter dropzone.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Choose JPEG output quality',
          text: 'Select your preferred compression quality (80 percent for smaller size, 92 percent standard, or 100 percent maximum).',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'In-browser decoding and transcoding',
          text: 'The WebAssembly decoder unpacks the HEVC video bitstream into RGB pixels and encodes clean JPEG files.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Download JPGs or ZIP bundle',
          text: 'Download individual JPG photos or click Download All as ZIP for batch saving.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ],
};
---

<Base title={title} description={description} schema={singleSchemaGraph}>
  <section class="hero" id="tool">
    <div class="container">
      <span class="eyebrow">Free - Batch up to 30 - 100% In-Browser - Zero Upload</span>
      <h1>HEIC to <span class="accent">JPG</span> Converter</h1>
      <p class="lead">
        Turn iPhone HEIC photos into universal JPGs that open everywhere.
        Fast in-browser WebAssembly conversion, customizable quality, automatic GPS sanitization, and instant ZIP download.
      </p>

      <div class="tool-card">
        <ToolDrop
          id="heic"
          accept="image/heic,image/heif,.heic,.heif"
          multiple
          title="Drop HEIC photos here"
          subtitle="Or click to select files from your iPhone, Mac, or PC"
        >
          <div class="controls">
            <label for="quality">JPEG Quality</label>
            <select id="quality">
              <option value="0.92" selected>92% - Recommended (Sharpest)</option>
              <option value="0.80">80% - Smaller file size</option>
              <option value="1.0">100% - Maximum quality</option>
            </select>
          </div>

          <div class="results" hidden>
            <div class="bar">
              <span class="summary">0 converted</span>
              <div class="bar-actions">
                <button type="button" class="btn btn-ghost zip" disabled>Download All as ZIP</button>
                <button type="button" class="btn btn-ghost" id="btn-share-state">Share Link</button>
              </div>
            </div>
            <ul class="rows"></ul>
          </div>
        </ToolDrop>
      </div>

    </div>
  </section>

  <!-- Lead In-Depth Context -->
  <section class="section">
    <div class="container measure-readable">
      <p class="lead-context">
        Since iOS 11, Apple devices capture photographs in the High Efficiency Image File Format (HEIF/HEIC) by default. While HEIC delivers exceptional compression efficiency, it presents persistent compatibility headaches when transferring pictures to Windows PCs, uploading images to e-commerce portals, submitting online visa forms, or editing photos in legacy graphics software. Most online converters require you to upload your personal gallery to third-party cloud servers. RemoveSynth solves this compatibility challenge with a high-performance in-browser conversion engine. Using WebAssembly and HTML5 Canvas, your files are decoded and transcoded directly inside your computer or phone RAM with complete data privacy.
      </p>
    </div>
  </section>

  <!-- Technical Formulation and Binary Decoding Model -->
  <section class="section bg-alt">
    <div class="container">
      <h2>How HEIC to JPG Transcoding Works: The ISOBMFF Architecture</h2>
      <p class="section-lead">
        HEIC files are not traditional raw image bitmaps; they are media containers based on the ISO Base Media File Format (ISOBMFF).
      </p>

      <div class="formula-card">
        <h3>Mathematical Model of the Transcoding Pipeline</h3>
        <p>
          An Apple HEIC image container contains a hierarchical structure of nested boxes:
        </p>
        <div class="math-block">
          <code>File_HEIC = Box_ftyp("heic") + Box_meta( hdlr, iloc, iinf, iprp ) + Box_mdat( Bitstream_H265 )</code>
        </div>
        <p>
          The payload in the <code>mdat</code> box consists of High Efficiency Video Coding (ITU-T H.265 / HEVC) Intra-coded frames:
        </p>
        <div class="math-block">
          <code>Frame_RGB(x,y) = Dequantize_HEVC( InverseDCT_Intra( Tile_hvc1(x,y) ) )</code>
        </div>
        <p>
          RemoveSynth unpacks the <code>iloc</code> item locations, executes the WebAssembly H.265 decoder to yield 24-bit sRGB bitmap arrays, and re-encodes the image into an ITU-T T.81 compliant JPEG structure:
        </p>
        <div class="math-block">
          <code>File_JPEG = SOI + DQT_quant_tables + SOF0_baseline + DHT_huffman + SOS + ScanData + EOI</code>
        </div>
      </div>

      <div class="worked-example-card">
        <h3>Worked Example: Transcoding an iPhone 15 Pro Portrait</h3>
        <p>
          Consider a real photograph captured on an iPhone 15 Pro (48 megapixels, 8064x6048 pixels):
        </p>
        <ul>
          <li><strong>Source File:</strong> 4,821,100 bytes (4.82 MB) HEIC file carrying embedded Apple camera metadata, dual-lens depth maps, and GPS location coordinates.</li>
          <li><strong>Compatibility Problem:</strong> Windows Photos displays "HEVC Video Extensions required" error; web portal rejects the <code>.heic</code> extension.</li>
          <li><strong>Execution in RemoveSynth:</strong> The file is dropped into the browser. The WebAssembly decoder extracts the primary <code>hvc1</code> intra frame, discards sensitive GPS tags and proprietary depth buffers, and applies 92 percent discrete cosine quantization.</li>
          <li><strong>Transcoded Output File:</strong> 4,210,800 bytes universal JPEG.</li>
          <li><strong>Result:</strong> Opens instantly on any Windows PC, Android device, Photoshop, and web portal with zero quality degradation and complete privacy.</li>
        </ul>
      </div>

      <!-- SVG Container Architecture Diagram -->
      <div class="chart-container">
        <h3>ISOBMFF HEIC Container Parsing vs. Universal JPEG Stream</h3>
        <p class="chart-sub">Decoding Apple HEVC intra frames to standardized JPEG markers.</p>
        <svg viewBox="0 0 760 280" class="data-chart" aria-label="HEIC to JPG Transcoding Architecture Chart">
          <rect x="20" y="20" width="720" height="240" rx="8" fill="#13171f" stroke="#252d3d" stroke-width="1" />
          
          <!-- HEIC Container -->
          <text x="40" y="55" fill="#f87171" font-size="13" font-weight="600">INPUT: APPLE HEIC CONTAINER (ISO/IEC 23008-12)</text>
          
          <rect x="40" y="70" width="100" height="40" rx="4" fill="#1e293b" stroke="#334155" />
          <text x="90" y="95" fill="#94a3b8" font-size="12" text-anchor="middle">ftyp (heic)</text>

          <rect x="150" y="70" width="140" height="40" rx="4" fill="#1e293b" stroke="#334155" />
          <text x="220" y="95" fill="#94a3b8" font-size="12" text-anchor="middle">meta (iloc, iinf)</text>

          <rect x="300" y="70" width="220" height="40" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="410" y="95" fill="#fca5a5" font-size="12" font-weight="600" text-anchor="middle">mdat: H.265 Intra Bitstream</text>

          <rect x="530" y="70" width="190" height="40" rx="4" fill="#1e293b" stroke="#334155" />
          <text x="625" y="95" fill="#94a3b8" font-size="12" text-anchor="middle">EXIF &amp; GPS Location Tags</text>

          <line x1="40" y1="135" x2="740" y2="135" stroke="#334155" stroke-dasharray="4" />

          <!-- JPEG Stream -->
          <text x="40" y="165" fill="#34d399" font-size="13" font-weight="600">OUTPUT: UNIVERSAL JPEG STREAM (ITU-T T.81 / JFIF)</text>
          
          <rect x="40" y="180" width="90" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="85" y="205" fill="#a7f3d0" font-size="12" text-anchor="middle">SOI</text>

          <rect x="140" y="180" width="130" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="205" y="205" fill="#a7f3d0" font-size="12" text-anchor="middle">DQT + SOF0</text>

          <rect x="280" y="180" width="320" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="440" y="205" fill="#a7f3d0" font-size="12" font-weight="600" text-anchor="middle">Clean Quantized Scan Data (Zero GPS)</text>

          <rect x="610" y="180" width="110" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="665" y="205" fill="#a7f3d0" font-size="12" text-anchor="middle">EOI Marker</text>

          <!-- Marker Badge -->
          <rect x="270" y="235" width="260" height="24" rx="12" fill="#10b981" />
          <text x="400" y="251" fill="#022c22" font-size="11" font-weight="700" text-anchor="middle">YOU ARE HERE (UNIVERSAL JPG OUTPUT)</text>
        </svg>
      </div>

    </div>
  </section>

  <!-- Step-by-Step Instructions -->
