---
import Base from '../layouts/Base.astro';
import ImageTool from '../components/ImageTool.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'Image Converter Online Free: In-Browser Batch Tool';
const description =
  'Convert images between JPG, PNG, WebP, AVIF, and HEIC online for free. Fast in-browser batch converter with zero server uploads and high visual fidelity.';

const faqs: FaqItem[] = [
  {
    q: 'Which image formats can I convert using this tool?',
    a: 'RemoveSynth image converter supports bidirectional batch conversion between all major web and camera formats: JPG, JPEG, PNG, WebP, AVIF, HEIC (iPhone Apple photos), and GIF. You can convert any supported input format to JPG, PNG, WebP, or AVIF.',
  },
  {
    q: 'Are my photos uploaded to a cloud server during conversion?',
    a: 'No. All image parsing, pixel decoding, color space mapping, and target re-encoding occur 100 percent locally inside your web browser using HTML5 Canvas, WebAssembly, and client-side Web Workers. Your private photos never leave your device.',
  },
  {
    q: 'Does converting between formats cause loss of image quality?',
    a: 'Converting between lossy formats (like HEIC to JPG or AVIF to WebP) uses optimized quality encoding (quality factor 92) with perceptually tuned chroma subsampling. Visual degradation is virtually indistinguishable to the human eye. Converting to PNG is completely lossless.',
  },
  {
    q: 'How many photos can I convert simultaneously in batch mode?',
    a: 'You can drag and drop up to 30 images at once. The converter processes the queue in parallel and lets you download individual converted files or a consolidated ZIP archive with a single click.',
  },
  {
    q: 'How do I open and convert iPhone HEIC photos on Windows 10 and 11?',
    a: 'Windows does not natively decode HEIC files without purchasing extensions from the Microsoft Store. Simply drag your .heic images from your iPhone into our converter above and select JPG or PNG to download universally viewable images instantly.',
  },
  {
    q: 'Why should I convert PNG images to WebP or AVIF for websites?',
    a: 'Modern web formats like WebP and AVIF achieve 30 to 80 percent smaller file sizes than legacy PNG and JPG files at identical visual fidelity. Converting graphics and hero images to WebP or AVIF accelerates page load speeds and improves Google Core Web Vitals rankings.',
  },
  {
    q: 'Does this converter preserve transparent backgrounds?',
    a: 'Yes. If your source image contains an alpha transparency channel (such as transparent PNG or transparent WebP), converting to PNG or WebP preserves full transparency. Converting to JPG will replace the transparent background with clean solid white.',
  },
  {
    q: 'Can I convert photos directly on my iPhone or Android mobile device?',
    a: 'Yes. Open this page in Safari on iOS or Chrome on Android, tap the upload dropzone to select photos from your camera roll or Files app, choose your output format, and save the converted images directly back to your device storage.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Tools', url: `${SITE.url}/tools/` },
    { name: 'Image Converter', url: `${SITE.url}/image-converter/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Universal In-Browser Image Converter',
    url: `${SITE.url}/image-converter/`,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to convert images online in your browser',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Upload source images', text: 'Drag and drop your photos (JPG, PNG, WebP, AVIF, HEIC) into the converter stage above.' },
      { '@type': 'HowToStep', position: 2, name: 'Select output format and quality', text: 'Choose your desired target format (JPG, PNG, WebP, or AVIF) and adjust the quality slider.' },
      { '@type': 'HowToStep', position: 3, name: 'Download converted files', text: 'Save your converted images individually or download all files at once in a single ZIP package.' },
    ],
  },
  faqSchema(faqs),
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Universal Format Transcoding · 100% In-Browser · Batch Up to 30</span>
      <h1>Universal <span class="accent">Image Converter</span></h1>
      <p class="lead">
        Convert images seamlessly between JPG, PNG, WebP, AVIF, and HEIC in seconds. Fast, private, and runs entirely in your browser with zero cloud server uploads.
      </p>
      <ImageTool />
    </div>
  </section>

  <article class="prose">
    <h2>Why Choose Client-Side In-Browser Image Conversion?</h2>
    <p>
      For decades, converting images between digital file formats required uploading private photographs to remote cloud conversion websites. While functional, traditional cloud converters expose users to severe privacy, security, and bandwidth drawbacks. Uploading high-resolution photo batches from smartphones or professional cameras consumes gigabytes of mobile data, risks sensitive image leakage to third-party databases, and introduces latency during network transfers.
    </p>
    <p>
      RemoveSynth completely reimagines digital image transcoding by executing 100 percent of the decoding, color space transformation, and encoding pipelines client-side inside your modern web browser. Leveraging WebAssembly (WASM), HTML5 Canvas 2D rendering contexts, and hardware-accelerated Web Workers, our engine transforms image bitstreams directly within your device RAM. Your confidential family snapshots, sensitive business documents, and high-value creative assets never touch an external server.
    </p>

    <h2>Comprehensive Format Ecosystem: JPG, PNG, WebP, AVIF, and HEIC</h2>
    <p>
      Navigating today fragmented digital image landscape requires understanding the architectural strengths and compatibility profiles of different compression standards:
    </p>
    <ul>
      <li>
        <strong>JPEG / JPG (Joint Photographic Experts Group):</strong> Standardized in 1992, JPEG remains the undisputed universal benchmark for digital photography, supported by 100 percent of web browsers, operating systems, digital cameras, and photo printing kiosks. Uses lossy discrete cosine transform (DCT) compression with 4:2:0 or 4:4:4 chroma subsampling.
      </li>
      <li>
        <strong>PNG (Portable Network Graphics):</strong> Designed in 1996 as an open replacement for GIF, PNG employs lossless DEFLATE compression. Ideal for user interface screenshots, graphic illustrations, logos, and medical imagery requiring 8-bit alpha transparency and zero loss of pixel precision.
      </li>
      <li>
        <strong>WebP:</strong> Introduced by Google in 2010 based on the VP8 video keyframe codec. WebP achieves 25 to 34 percent smaller file sizes than comparable JPEG images while supporting both lossy and lossless modes, 8-bit alpha transparency, and animated frame sequences.
      </li>
      <li>
        <strong>AVIF (AV1 Image File Format):</strong> Developed by the Alliance for Open Media (AOMedia) based on the AV1 video codec. AVIF delivers cutting-edge compression efficiency, reducing file sizes by up to 50 percent compared to WebP and 70 percent compared to JPEG, while supporting 10-bit and 12-bit High Dynamic Range (HDR) color depths.
      </li>
      <li>
        <strong>HEIC / HEIF (High Efficiency Image File Format):</strong> Standardized by MPEG and adopted by Apple as the default photo capture format on iPhone since iOS 11. Built upon HEVC (H.265) intra-frame coding, HEIC provides superior compression but suffers from limited native compatibility on Windows PCs and legacy web browsers.
      </li>
    </ul>

    <h2>Mathematical Formulation of Image Decoding and Transcoding</h2>
    <p>
      When an image is converted from a compressed bitstream (such as HEVC in HEIC or AV1 in AVIF) to JPEG, the transcoding engine executes a multi-stage mathematical pipeline. First, the source bitstream is entropy-decoded and inverse-transformed to yield raw uncompressed RGB pixel matrices:
    </p>
    <div class="math-block">
      <code>
        Pixel(x, y) = [R(x, y), G(x, y), B(x, y)] in [0, 255]^3
      </code>
    </div>
    <p>
      To encode into JPEG, the RGB buffer is converted to the $YC_bC_r$ color space via the ITU-R BT.601 matrix transformation:
    </p>
    <div class="math-block">
      <code>
        Y  = +0.2990 * R + 0.5870 * G + 0.1140 * B
        Cb = -0.1687 * R - 0.3313 * G + 0.5000 * B + 128
        Cr = +0.5000 * R - 0.4187 * G - 0.0813 * B + 128
      </code>
    </div>
    <p>
      The chrominance channels ($C_b$ and $C_r$) are downsampled using 4:2:0 subsampling, reducing spatial color resolution by a factor of 4. Each $8 	imes 8$ block of luminance and chrominance samples is subsequently transformed into frequency coefficients via the 2D Discrete Cosine Transform (DCT):
    </p>
    <div class="math-block">
      <code>
        F(u, v) = (1/4) * C(u) * C(v) * sum_x sum_y f(x, y) * cos((2x+1)u*pi / 16) * cos((2y+1)v*pi / 16)
      </code>
    </div>
    <p>
      Where C(u), C(v) = 1/sqrt(2) for u, v = 0, and 1 otherwise. The resulting frequency coefficients are divided by a psycho-visually tuned quantization matrix Q(u, v) scaled by the user quality setting q, and finally entropy-coded using Huffman or arithmetic coding to produce the output JPEG file.
    </p>

    <h2>Worked Numerical Example: Transcoding Benchmark and Storage Savings</h2>
    <p>
      To illustrate real-world compression performance across formats, consider a high-resolution 12-megapixel photograph ($4032 	imes 3024$ pixels) captured on an iPhone 15 Pro transcoded across all supported formats:
    </p>
    <div class="table-wrap">
      <table>
