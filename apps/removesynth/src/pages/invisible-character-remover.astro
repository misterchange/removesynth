<script>
  function setupZwspTool() {
    const root = document.getElementById('zwsp-tool');
    if (!root) return;

    const textIn = root.querySelector<HTMLTextAreaElement>('#text-in')!;
    const textOut = root.querySelector<HTMLTextAreaElement>('#text-out')!;
    const badge = root.querySelector<HTMLElement>('#badge-count')!;
    const btnClean = root.querySelector<HTMLButtonElement>('#btn-clean')!;
    const btnCopy = root.querySelector<HTMLButtonElement>('#btn-copy')!;
    const btnClear = root.querySelector<HTMLButtonElement>('#btn-clear')!;
    const btnSample = root.querySelector<HTMLButtonElement>('#btn-sample')!;
    const status = root.querySelector<HTMLElement>('#tool-status')!;

    // Invisible characters regex
    const INVISIBLE_REGEX = /[\u200B-\u200D\uFEFF\u00AD\u2060\u200E\u200F\u2028\u2029]/g;

    const SAMPLE = `Hello\u200BWorld!\u200C This\u200D is a sentence\uFEFF with\u00AD hidden\u2060 zero-width tracking characters.`;

    function scanText() {
      const val = textIn.value;
      const matches = val.match(INVISIBLE_REGEX);
      const count = matches ? matches.length : 0;

      if (count > 0) {
        badge.textContent = `Found ${count} hidden invisible character${count === 1 ? '' : 's'}`;
        badge.className = 'stat-badge alert';
        btnClean.disabled = false;
      } else if (val.length > 0) {
        badge.textContent = 'No invisible characters detected';
        badge.className = 'stat-badge ok';
        btnClean.disabled = false;
      } else {
        badge.textContent = '0 invisible characters detected';
        badge.className = 'stat-badge';
        btnClean.disabled = true;
      }
    }

    function cleanText() {
      const val = textIn.value;
      const cleaned = val.replace(INVISIBLE_REGEX, '');
      textOut.value = cleaned;
      btnCopy.disabled = cleaned.length === 0;
      status.textContent = 'Text cleaned successfully!';
      status.className = 'tool-status small ok';
    }

    textIn.addEventListener('input', scanText);
    btnClean.addEventListener('click', cleanText);

    btnSample.addEventListener('click', () => {
      textIn.value = SAMPLE;
      scanText();
      cleanText();
    });

    btnClear.addEventListener('click', () => {
      textIn.value = '';
      textOut.value = '';
      badge.textContent = '0 invisible characters detected';
      badge.className = 'stat-badge';
      btnClean.disabled = true;
      btnCopy.disabled = true;
      status.textContent = '';
    });

    btnCopy.addEventListener('click', async () => {
      if (!textOut.value) return;
      await navigator.clipboard.writeText(textOut.value);
      status.textContent = 'Clean text copied to clipboard!';
      status.className = 'tool-status small ok';
      setTimeout(() => { status.textContent = ''; }, 3000);
    });
  }

  setupZwspTool();
</script>
