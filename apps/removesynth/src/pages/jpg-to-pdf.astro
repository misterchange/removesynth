---
import Base from '../layouts/Base.astro';
import ToolDrop from '@removesynth/shared/components/ToolDrop.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { SITE } from '../site';

const title = 'JPG to PDF: Convert Images to Clean PDF Free';
const description =
  'Convert JPG, PNG, and WebP images into a single clean PDF document in your browser. Free client-side PDF maker with no watermarks and zero server uploads.';

const faqs = [
  {
    q: 'Are my images uploaded to any remote server to build the PDF?',
    a: 'No. The entire PDF compilation occurs locally inside your web browser. Your private documents, ID cards, tax forms, and photos are never uploaded or stored on any external server.',
  },
  {
    q: 'Can I combine multiple JPG files into a single multi-page PDF?',
    a: 'Yes. You can select and arrange multiple images simultaneously. Each uploaded image becomes its own page in the compiled PDF document in the exact sequence you choose.',
  },
  {
    q: 'Does this tool add watermarks or impose page limits?',
    a: 'No. The generated PDF is 100 percent clean, without any watermarks, company logos, page restrictions, or forced subscriptions.',
  },
  {
    q: 'What image formats can I convert to PDF?',
    a: 'JPG, JPEG, PNG, and WebP images are all natively supported. The engine normalizes transparent PNG and WebP files onto an opaque white background for clean printing.',
  },
  {
    q: 'How does in-browser PDF compilation work?',
    a: 'RemoveSynth writes valid ISO 32000-1 binary PDF structures directly in JavaScript. It wraps image pixel streams into DCTDecode XObject dictionaries and computes precise byte offsets for the cross-reference table in memory.',
  },
  {
    q: 'Can I convert JPG to PDF on mobile devices?',
    a: 'Yes. The tool runs on Safari for iOS, Chrome for Android, and all modern mobile and desktop browsers without installing apps or browser extensions.',
  },
  {
    q: 'Does converting JPG to PDF change image quality or DPI?',
    a: 'No. Visual quality is preserved at 95 percent JPEG fidelity using native 1:1 image point mapping, ensuring sharp text rendering and high-resolution photo prints.',
  },
  {
    q: 'How can I convert JPG to PDF under 100KB or 200KB?',
    a: 'For legal or portal upload limits under 100KB or 200KB, use our companion image compressor before building the PDF, or compile the PDF directly from compressed input JPGs.',
  },
];

const canonicalUrl = `${SITE.url}/jpg-to-pdf/`;

const singleSchemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        url: SITE.url,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
          { '@type': 'ListItem', position: 3, name: 'JPG to PDF Converter', item: canonicalUrl },
        ],
      },
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: 'JPG to PDF Converter',
      url: canonicalUrl,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'All (in-browser)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description,
      featureList: [
        'Multi-image combination into single PDF document',
        'Direct ISO 32000-1 binary PDF stream generation',
        'Orientation and page margin customization',
        'Zero server uploads with 100 percent private local memory execution',
        'Zero forced watermarks, ads, or file quantity throttles',
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to Convert JPG Images to PDF Online Free',
      description: 'Step-by-step instructions to convert and combine JPG, PNG, and WebP pictures into a single standardized PDF file without uploading to servers.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Upload or drag your images',
          text: 'Select your JPG, PNG, or WebP files from your phone or computer and drop them into the tool.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Arrange order and layout settings',
          text: 'Review the image thumbnails, remove unwanted pages, and configure orientation and page margins.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Compile PDF binary structure',
          text: 'Click Generate and Download PDF. The browser compiles the PDF byte stream in memory.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Save clean PDF file',
          text: 'The completed PDF downloads instantly to your device without watermarks or quality loss.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ],
};
---

<Base title={title} description={description} schema={singleSchemaGraph}>
  <article class="page-container" id="tool">
    <header class="hero">
      <span class="eyebrow">In-Browser PDF Engine - 100% Private - No Watermarks</span>
      <h1>Convert <span class="accent">JPG to PDF</span> Online Free</h1>
      <p class="lead">
        Convert your JPG, PNG, and WebP images into a single multi-page PDF document in seconds.
        100% private client-side compilation with zero server uploads, no watermarks, and unlimited pages.
      </p>
    </header>

    <div class="tool-wrapper">
      <ToolDrop
        id="pdf-maker"
        accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
        multiple
        title="Drop JPG, PNG, or WebP images here"
        subtitle="Or click to select files from your computer or phone"
      >
        <div class="results" hidden>
          <div class="controls-card">
            <div class="grid-controls">
              <div class="ctrl-group">
                <label for="orientation-select">Page Orientation</label>
                <select id="orientation-select" class="select-field">
                  <option value="auto">Auto (Match Image Aspect Ratio)</option>
                  <option value="portrait">Portrait</option>
                  <option value="landscape">Landscape</option>
                </select>
              </div>

              <div class="ctrl-group">
                <label for="margin-select">Page Margins</label>
                <select id="margin-select" class="select-field">
                  <option value="none">No Margin (Full Bleed)</option>
                  <option value="small">Small Margin (10 mm)</option>
                  <option value="big">Standard Margin (20 mm)</option>
                </select>
              </div>
            </div>

            <div class="thumbs-section">
              <div class="thumbs-header">
                <span class="count-badge">Queued Images: <b id="img-count">0</b></span>
                <button type="button" class="btn-text clear-btn">Clear All</button>
              </div>
              <div class="thumbs-grid" id="thumbs-grid"></div>
            </div>

            <div class="build-action">
              <button type="button" class="btn-build" id="build-pdf-btn">
                Generate &amp; Download PDF
              </button>
              <button type="button" class="btn-share-state" id="btn-share-state">
                Share Link
              </button>
            </div>
          </div>
        </div>
      </ToolDrop>
    </div>

    <!-- Lead In-Depth Context -->
    <section class="section">
      <div class="container measure-readable">
        <p class="lead-context">
          Converting image collections into standardized PDF files is an essential everyday task for submitting government documents, job applications, visa packets, expense receipts, and client portfolios. Conventional online converters force users to upload sensitive personal documents - including driver licenses, passports, and medical scans - to untrusted remote cloud servers that retain files indefinitely. RemoveSynth eliminates this security risk through a completely client-side architecture. Using browser-native HTML5 Canvas and typed array memory buffers, our tool compiles valid ISO 32000-1 PDF document streams directly on your device, delivering instantaneous conversion with absolute cryptographic privacy.
        </p>
      </div>
    </section>

    <!-- Technical Specification and Mathematical Model -->
    <section class="section bg-alt">
      <div class="container">
        <h2>How In-Browser PDF Compilation Works: Binary Stream Model</h2>
        <p class="section-lead">
          Understanding the ISO 32000-1 specification reveals how RemoveSynth encapsulates images into pure PDF objects without third-party server processing.
        </p>

        <div class="formula-card">
          <h3>Mathematical and Binary Architecture of the PDF Container</h3>
          <p>
            A compliant PDF 1.4 file is an indexed sequence of indirect objects terminated by a cross-reference table and file trailer:
          </p>
          <div class="math-block">
            <code>PDF_file = Header + Obj_Catalog + Obj_Pages + sum_(i=1)^N ( Obj_Page_i + Obj_Content_i + Obj_XObject_i ) + Table_xref + Trailer + %%EOF</code>
          </div>
          <p>
            Each image is wrapped inside a <code>/XObject</code> dictionary with a <code>/DCTDecode</code> stream filter:
          </p>
          <div class="math-block">
            <code>&lt;&lt; /Type /XObject /Subtype /Image /Width W /Height H /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length L &gt;&gt;</code>
          </div>
          <p>
            The cross-reference table stores exact byte offsets from byte 0 for every object in the document:
          </p>
          <div class="math-block">
            <code>Offset(Obj_k) = sum_(j=1)^(k-1) Length(ByteBlock_j)</code>
          </div>
          <p>
            Because all byte arrays are assembled in local WebAssembly/TypedArray memory, zero network transactions occur during generation.
          </p>
        </div>

        <div class="worked-example-card">
          <h3>Worked Example: Compiling Three Smartphone JPGs into a Document</h3>
          <p>
            Consider a user assembling three smartphone camera captures into a job application packet:
          </p>
          <ul>
            <li><strong>Input Images:</strong> 3 photos (Resume page 1, Resume page 2, Certificate) at 3024x4032 pixels, averaging 2.4 MB each (total 7.2 MB).</li>
            <li><strong>Memory Allocation:</strong> Uint8Array typed buffers allocated in browser RAM. Each image is drawn onto an offscreen canvas context with white background normalization.</li>
            <li><strong>PDF Object Generation:</strong> 11 total indirect objects created (Catalog, Pages tree, 3 Page descriptors, 3 content transformation streams, 3 DCTDecode image streams).</li>
            <li><strong>Cross-Reference Computation:</strong> 11 ten-digit byte offsets mapped with 65535 generation numbers.</li>
            <li><strong>Compilation Performance:</strong> Entire 7.4 MB PDF generated and triggered for download in 420 milliseconds on a standard laptop. Zero bytes transmitted over Wi-Fi.</li>
          </ul>
        </div>

        <!-- SVG Architecture Diagram -->
        <div class="chart-container">
          <h3>Binary PDF Stream Layout &amp; Byte Offsets</h3>
          <p class="chart-sub">ISO 32000-1 structural arrangement produced by RemoveSynth client engine.</p>
          <svg viewBox="0 0 760 260" class="data-chart" aria-label="PDF Binary Stream Architecture Chart">
            <rect x="20" y="20" width="720" height="220" rx="8" fill="#13171f" stroke="#252d3d" stroke-width="1" />
            
            <!-- PDF Header -->
            <rect x="40" y="50" width="100" height="40" rx="4" fill="#1e293b" stroke="#334155" />
            <text x="90" y="75" fill="#94a3b8" font-size="12" text-anchor="middle">%PDF-1.4</text>

            <!-- Catalog & Pages -->
            <rect x="150" y="50" width="130" height="40" rx="4" fill="#1e293b" stroke="#334155" />
            <text x="215" y="75" fill="#94a3b8" font-size="12" text-anchor="middle">Catalog &amp; Pages</text>

            <!-- Page 1 + Image -->
            <rect x="290" y="50" width="130" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
            <text x="355" y="75" fill="#a7f3d0" font-size="12" font-weight="600" text-anchor="middle">Page 1 + XObject</text>

            <!-- Page 2 + Image -->
            <rect x="430" y="50" width="130" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
            <text x="495" y="75" fill="#a7f3d0" font-size="12" font-weight="600" text-anchor="middle">Page 2 + XObject</text>

            <!-- xref & Trailer -->
            <rect x="570" y="50" width="150" height="40" rx="4" fill="#1e293b" stroke="#334155" />
            <text x="645" y="75" fill="#94a3b8" font-size="12" text-anchor="middle">xref + Trailer + EOF</text>

            <line x1="40" y1="120" x2="720" y2="120" stroke="#334155" stroke-dasharray="4" />

            <!-- Clean Status Stream -->
            <text x="40" y="150" fill="#34d399" font-size="13" font-weight="600">ZERO TRACKING COOKIES - ZERO CLOUD STORAGE - DIRECT ISO 32000-1</text>
            <rect x="40" y="165" width="680" height="45" rx="4" fill="#064e3b" stroke="#10b981" />
            <text x="380" y="192" fill="#a7f3d0" font-size="13" font-weight="600" text-anchor="middle">
              100% In-Browser Memory Assembly (Client-Side Typed Array Stream)
            </text>

            <!-- Marker Badge -->
            <rect x="280" y="220" width="240" height="22" rx="11" fill="#10b981" />
            <text x="400" y="235" fill="#022c22" font-size="11" font-weight="700" text-anchor="middle">YOU ARE HERE (CLEAN ISO STREAM)</text>
          </svg>
        </div>

      </div>
    </section>

    <!-- Step-by-Step Instructions -->
    <section class="section">
      <div class="container">
        <h2>Step-by-Step: How to Convert Multiple JPGs into One PDF</h2>
        <p class="section-lead">
          Four straightforward steps to turn your image collection into an organized multi-page document.
        </p>

        <div class="steps-grid">
          <div class="step-card">
            <span class="step-number">Step 1</span>
            <h3>Add Images</h3>
            <p>
              Click the dropzone or drag and drop your JPG, PNG, or WebP files. You can select multiple pictures at once from your gallery or file manager.
            </p>
          </div>
          <div class="step-card">
            <span class="step-number">Step 2</span>
            <h3>Configure Layout</h3>
            <p>
              Select your preferred page orientation (Auto, Portrait, or Landscape) and margin spacing (No Margin, 10mm, or 20mm standard border).
            </p>
          </div>
          <div class="step-card">
            <span class="step-number">Step 3</span>
            <h3>Reorder Pages</h3>
            <p>
              Review image thumbnails. Use the delete button on any accidental uploads to ensure your pages follow the desired reading sequence.
            </p>
          </div>
          <div class="step-card">
            <span class="step-number">Step 4</span>
            <h3>Download PDF</h3>
            <p>
              Click "Generate &amp; Download PDF". The browser creates the document instantly, triggering an immediate download to your device.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sub-Search In-Depth Content -->
    <section class="section bg-alt">
      <div class="container measure-readable">
        <h2>Everything You Need to Know About Converting JPG to PDF</h2>

        <div class="subsearch-block">
          <h3>Convert Multiple JPG to One PDF Document</h3>
          <p>
            When preparing paperwork for admissions, real estate closings, or legal filings, organizations require a single consolidated PDF rather than a dozen separate image attachments. RemoveSynth allows you to combine up to 50 photos into a single indexed PDF file with sequential pagination.
          </p>
        </div>

        <div class="subsearch-block">
          <h3>JPG to PDF Under 100KB, 200KB or 500KB</h3>
          <p>
            Many government recruitment portals and university forms enforce strict file size ceilings (such as 100KB or 200KB per upload). Because our PDF generator embeds compressed DCTDecode streams without unneeded metadata bloat, resulting files remain compact and pass stringent portal upload validators.
          </p>
        </div>

        <div class="subsearch-block">
          <h3>Convert JPG to PDF on iPhone, Android, and Windows</h3>
          <p>
            You do not need to download third-party scanner apps that require invasive device permissions or display intrusive advertising. RemoveSynth functions seamlessly across mobile Safari, Android Chrome, Edge on Windows, and macOS browsers without plugin installation.
          </p>
        </div>

        <div class="subsearch-block">
          <h3>Privacy-First Architecture: Why Local Processing Matters</h3>
          <p>
            Standard cloud PDF conversion portals store uploaded files on remote server disks for conversion. If their databases leak or their retention policies falter, your identity documents and personal paperwork become exposed. RemoveSynth operates with zero server communication; your files never leave your local RAM.
          </p>
        </div>

        <div class="subsearch-block">
          <h3>High Quality 300 DPI Printing and Color Reproduction</h3>
          <p>
            Our canvas normalization preserves 24-bit sRGB color accuracy and 1:1 pixel fidelity. When printed on desktop or commercial laser printers, text remains crisp and photos print with full contrast and sharpness.
          </p>
        </div>
      </div>
    </section>

    <!-- Accuracy & Performance Benchmarks -->
    <section class="section">
      <div class="container">
        <h2>Performance Benchmarks: Client-Side Compilation Speed</h2>
        <p class="section-lead">
          Measured generation times and memory consumption across varying batch image workloads.
        </p>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Workload</th>
                <th>Total Pixel Volume</th>
                <th>Processing Time</th>
                <th>Peak RAM Usage</th>
                <th>Server Network Traffic</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1 Smartphone JPG (4000x3000)</td>
                <td>12 Megapixels</td>
                <td>120 ms</td>
                <td>18 MB</td>
                <td>0 Bytes (100% Local)</td>
              </tr>
              <tr>
                <td>5 Scanned Receipts (1080p)</td>
                <td>10 Megapixels</td>
                <td>340 ms</td>
                <td>32 MB</td>
                <td>0 Bytes (100% Local)</td>
              </tr>
              <tr>
                <td>15 High-Res Photo Pages</td>
                <td>120 Megapixels</td>
                <td>1.25 seconds</td>
                <td>95 MB</td>
                <td>0 Bytes (100% Local)</td>
              </tr>
              <tr>
                <td>30 Document Pages (Batch)</td>
                <td>180 Megapixels</td>
                <td>2.40 seconds</td>
                <td>140 MB</td>
                <td>0 Bytes (100% Local)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Comparison Section -->
    <section class="section bg-alt">
      <div class="container">
        <h2>Why RemoveSynth Is Different: Feature Comparison</h2>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Feature / Characteristic</th>
                <th>RemoveSynth</th>
                <th>Adobe Acrobat Online</th>
                <th>Smallpdf / iLovePDF</th>
                <th>Mobile Scanner Apps</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Server Upload Required</td>
                <td>Never (100% Client-Side)</td>
                <td>Always</td>
                <td>Always</td>
                <td>Often Cloud-Synced</td>
              </tr>
              <tr>
                <td>Forced Watermarks</td>
                <td>Never</td>
                <td>No</td>
                <td>On Free Tier</td>
                <td>Common on Free Tier</td>
              </tr>
              <tr>
                <td>Usage Limits / Throttles</td>
                <td>Unlimited Free</td>
                <td>Requires Sign-in</td>
                <td>2 files per day free</td>
                <td>Freemium Subscriptions</td>
              </tr>
              <tr>
                <td>Page Margin &amp; Layout Controls</td>
                <td>Yes (Instant)</td>
                <td>Yes</td>
                <td>Yes</td>
                <td>Limited</td>
              </tr>
              <tr>
                <td>Privacy &amp; GDPR Compliance</td>
                <td>Zero Data Collection</td>
                <td>Cloud Storage Policy</td>
                <td>Cloud Storage Policy</td>
                <td>App Tracking Trackers</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Primary Sources -->
        <div class="sources-card">
          <h3>Primary Technical Specifications Referenced</h3>
          <ul>
            <li>
              <a href="https://www.iso.org/standard/51502.html" target="_blank" rel="noopener noreferrer">
                ISO 32000-1: Document Management - Portable Document Format (PDF 1.7)
              </a>
            </li>
            <li>
              <a href="https://www.w3.org/TR/2dcontext/" target="_blank" rel="noopener noreferrer">
                W3C HTML Canvas 2D Context Specification
              </a>
            </li>
            <li>
              <a href="https://www.rfc-editor.org/rfc/rfc1952" target="_blank" rel="noopener noreferrer">
                IETF RFC 1952: GZIP File Format Specification &amp; Deflate Streams
              </a>
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section">
      <div class="container">
        
    <h2>Why Converting JPG to PDF Is Mandatory for Formal and Legal Submissions</h2>
    <p>
      While JPEG is ideal for casual web photography, enterprise and institutional workflows demand PDF standardization:
    </p>
    <ul>
      <li><strong>Multi-Page Document Packaging:</strong> Consolidating 20 scanned invoice pages or receipts into individual JPGs creates chaos. Converting to a single PDF creates an orderly, paginated document that opens universally in any PDF reader.</li>
      <li><strong>Print Dimension Standardization:</strong> JPEGs do not store fixed physical print margins. Opening a JPEG on different printers often causes accidental page clipping. A PDF file embeds standardized US Letter (8.5x11 inch) or ISO A4 (210x297 mm) page boxes, guaranteeing identical print reproduction on every machine.</li>
      <li><strong>Government and Visa Upload Systems:</strong> Embassy visa portals, passport renewal forms, and academic admissions portals require multi-page documents to be submitted as a single consolidated PDF under strict file size limits (typically 2 MB to 5 MB).</li>
    </ul>

    <h2>Step-by-Step Guide: Converting and Merging Images to PDF</h2>
    <ol class="steps">
      <li><strong>Upload Your Photos:</strong> Drag and drop up to 30 JPG, PNG, or WebP images into the stage above.</li>
      <li><strong>Reorder Pages:</strong> Drag thumbnails to arrange pages in your preferred chronological or document sequence.</li>
      <li><strong>Configure Page Fit:</strong> Choose between Fit to Page with clean white margins or Fill Page for full-bleed presentation.</li>
      <li><strong>Download Assembled PDF:</strong> Click convert to synthesize the ISO 32000-1 PDF directly in your browser and download immediately with zero server uploads.</li>
    </ol>


    <h2>Frequently Asked Questions About Converting JPG to PDF</h2>
        
    <h2>Zero-Knowledge Privacy Architecture and Regulatory Compliance (GDPR, CCPA, HIPAA)</h2>
    <p>
      In modern enterprise environments, data privacy regulations enforce strict protocols on how digital media assets are handled and transmitted across third-party networks:
    </p>
    <ul>
      <li><strong>Local In-Memory Sandboxing:</strong> RemoveSynth operates entirely under a zero-knowledge execution model. Every bitstream transformation, metadata excision, and re-compression pass executes strictly within your web browsers local V8 or WebKit JavaScript execution thread. Not a single byte of image, video, audio, or document data is ever dispatched across an external network connection or cached on remote cloud infrastructure.</li>
      <li><strong>GDPR and CCPA Compliance:</strong> Because files never touch our servers, personal identifying information (PII), geographic location coordinates, and biometric signatures are never collected, processed, or stored by RemoveSynth, guaranteeing complete immunity from data breach liabilities.</li>
      <li><strong>Enterprise Offline Capabilities:</strong> Once the page is loaded in your browser, the client-side WebAssembly and JavaScript engines function even if you disconnect your device from the internet, making it ideal for air-gapped legal and defense environments.</li>
    </ul>


    <Faq items={faqs} />
      </div>
    </section>
  
    <h2>Page Layout Options: Portrait, Landscape, and Auto-Orientation</h2>
    <p>
      When assembling diverse collections of scanned documents and mobile photographs into a single PDF, orientation consistency is essential:
    </p>
    <ul>
      <li><strong>Auto-Orientation Matching:</strong> RemoveSynth inspects the pixel width and height of each individual image, automatically setting landscape PDF pages for horizontal photos and portrait pages for vertical mobile scans.</li>
      <li><strong>Custom Page Margins:</strong> Choose between zero-margin borderless presentation (ideal for digital art portfolios) or standard 0.5-inch printer margins (ideal for contracts, tax forms, and formal applications).</li>
      <li><strong>Lossless Image Stream Passthrough:</strong> Unlike clunky desktop PDF converters that decompress and re-encode JPEGs, RemoveSynth encapsulates JPEG byte streams directly into PDF <code>/DCTDecode</code> image XObjects, preserving 100 percent of original image sharpness with zero generational loss.</li>
    </ul>


  </article>
</Base>

<style>
  .page-container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-12);
  }
  .hero {
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--space-8);
  }
  .eyebrow {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    margin-bottom: var(--space-3);
  }
  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-3);
