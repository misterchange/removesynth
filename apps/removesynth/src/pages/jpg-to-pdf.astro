<script>
  interface ImageItem {
    file: File;
    url: string;
    width: number;
    height: number;
    jpegData: Uint8Array;
  }

  const root = document.getElementById('pdf-maker') as HTMLElement;
  const results = root?.querySelector('.results') as HTMLElement;
  const thumbsGrid = root?.querySelector('#thumbs-grid') as HTMLElement;
  const imgCountEl = root?.querySelector('#img-count') as HTMLElement;
  const orientationSelect = root?.querySelector('#orientation-select') as HTMLSelectElement;
  const marginSelect = root?.querySelector('#margin-select') as HTMLSelectElement;
  const buildPdfBtn = root?.querySelector('#build-pdf-btn') as HTMLButtonElement;
  const clearBtn = root?.querySelector('.clear-btn') as HTMLButtonElement;
  const btnShareState = root?.querySelector('#btn-share-state') as HTMLButtonElement;

  let selectedImages: ImageItem[] = [];

  const updateThumbs = () => {
    if (!imgCountEl || !thumbsGrid) return;
    imgCountEl.textContent = selectedImages.length.toString();
    thumbsGrid.innerHTML = '';
    selectedImages.forEach((img, idx) => {
      const item = document.createElement('div');
      item.className = 'thumb-item';
      item.innerHTML = `
        <img src="${img.url}" alt="Thumbnail ${idx + 1}" />
        <button class="thumb-del" data-idx="${idx}" type="button">×</button>
      `;
      thumbsGrid.appendChild(item);
    });

    thumbsGrid.querySelectorAll('.thumb-del').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
        selectedImages.splice(idx, 1);
        if (!selectedImages.length) {
          results.hidden = true;
        } else {
          updateThumbs();
        }
      });
    });
  };

  root?.addEventListener('files', async (e) => {
    const files = (e as CustomEvent<File[]>).detail;
    if (!files.length) return;
    results.hidden = false;

    for (const f of files) {
      if (!f.type.startsWith('image/')) continue;
      const url = URL.createObjectURL(f);
      const img = new Image();
      img.src = url;
      await new Promise((res) => { img.onload = res; });

      const canvas = document.createElement('canvas');
      canvas.width = img.naturalWidth;
      canvas.height = img.naturalHeight;
      const ctx = canvas.getContext('2d');
      if (ctx) {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0);
      }
      const jpegBlob: Blob = await new Promise((res) => canvas.toBlob((b) => res(b!), 'image/jpeg', 0.95));
      const jpegData = new Uint8Array(await jpegBlob.arrayBuffer());

      selectedImages.push({
        file: f,
        url,
        width: img.naturalWidth,
        height: img.naturalHeight,
        jpegData,
      });
    }

    updateThumbs();
  });

  clearBtn?.addEventListener('click', () => {
    selectedImages.forEach((img) => URL.revokeObjectURL(img.url));
    selectedImages = [];
    results.hidden = true;
  });

  buildPdfBtn?.addEventListener('click', () => {
    if (!selectedImages.length) return;
    buildPdfBtn.disabled = true;
    buildPdfBtn.textContent = 'Generating PDF...';

    try {
      const pdfBytes = buildPdf(selectedImages, orientationSelect.value, marginSelect.value);
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'converted-images.pdf';
      a.click();
    } catch (err) {
      console.error(err);
      alert('Error building PDF.');
    } finally {
      buildPdfBtn.disabled = false;
      buildPdfBtn.textContent = 'Generate & Download PDF';
    }
  });

  if (btnShareState) {
    btnShareState.addEventListener('click', () => {
      const shareUrl = `${window.location.origin}${window.location.pathname}#tool`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        btnShareState.textContent = 'Link Copied!';
        setTimeout(() => {
          btnShareState.textContent = 'Share Link';
        }, 2000);
      });
    });
  }

  function buildPdf(images: ImageItem[], orientation: string, margin: string): Uint8Array {
    const marginPts = margin === 'big' ? 56.7 : margin === 'small' ? 28.3 : 0;
    let objCount = 2;
    const pageObjNums: number[] = [];
    const objects: { num: number; content: Uint8Array } = [];

    images.forEach((img, idx) => {
      let pageW = img.width * 0.75;
      let pageH = img.height * 0.75;

      if (orientation === 'portrait' && pageW > pageH) {
        const tmp = pageW; pageW = pageH; pageH = tmp;
      } else if (orientation === 'landscape' && pageH > pageW) {
        const tmp = pageW; pageW = pageH; pageH = tmp;
      }

      const drawW = pageW - marginPts * 2;
      const drawH = pageH - marginPts * 2;
      const posX = marginPts;
      const posY = marginPts;

      const imgObjNum = ++objCount;
      const streamObjNum = ++objCount;
      const pageObjNum = ++objCount;
      pageObjNums.push(pageObjNum);

      const imgHeader = new TextEncoder().encode(
        `${imgObjNum} 0 obj\n<< /Type /XObject /Subtype /Image /Width ${img.width} /Height ${img.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${img.jpegData.length} >>\nstream\n`
      );
      const imgFooter = new TextEncoder().encode('\nendstream\nendobj\n');
      const imgCombined = new Uint8Array(imgHeader.length + img.jpegData.length + imgFooter.length);
      imgCombined.set(imgHeader, 0);
      imgCombined.set(img.jpegData, imgHeader.length);
      imgCombined.set(imgFooter, imgHeader.length + img.jpegData.length);
      objects.push({ num: imgObjNum, content: imgCombined });

      const streamBody = `q\n${drawW.toFixed(2)} 0 0 ${drawH.toFixed(2)} ${posX.toFixed(2)} ${posY.toFixed(2)} cm\n/Im${idx + 1} Do\nQ\n`;
      const streamData = new TextEncoder().encode(
        `${streamObjNum} 0 obj\n<< /Length ${streamBody.length} >>\nstream\n${streamBody}endstream\nendobj\n`
      );
      objects.push({ num: streamObjNum, content: streamData });

      const pageData = new TextEncoder().encode(
        `${pageObjNum} 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pageW.toFixed(2)} ${pageH.toFixed(2)}] /Contents ${streamObjNum} 0 R /Resources << /XObject << /Im${idx + 1} ${imgObjNum} 0 R >> >> >>\nendobj\n`
      );
      objects.push({ num: pageObjNum, content: pageData });
    });

    const catalog = new TextEncoder().encode('1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n');
    objects.unshift({ num: 1, content: catalog });

    const pagesKidRefs = pageObjNums.map((n) => `${n} 0 R`).join(' ');
    const pages = new TextEncoder().encode(
      `2 0 obj\n<< /Type /Pages /Kids [${pagesKidRefs}] /Count ${pageObjNums.length} >>\nendobj\n`
    );
    objects.splice(1, 0, { num: 2, content: pages });
    objects.sort((a, b) => a.num - b.num);

    const pdfHeader = new TextEncoder().encode('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');
    const offsets: number[] = [0];
    let currentOffset = pdfHeader.length;
    const parts: Uint8Array[] = [pdfHeader];

    for (const obj of objects) {
      offsets.push(currentOffset);
      parts.push(obj.content);
      currentOffset += obj.content.length;
    }

    const startXref = currentOffset;
    let xref = `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
    for (let i = 1; i <= objects.length; i++) {
      xref += offsets[i].toString().padStart(10, '0') + ' 00000 n \n';
    }
    xref += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${startXref}\n%%EOF\n`;
    parts.push(new TextEncoder().encode(xref));

    const totalLen = parts.reduce((acc, p) => acc + p.length, 0);
    const result = new Uint8Array(totalLen);
    let cur = 0;
    for (const p of parts) {
      result.set(p, cur);
      cur += p.length;
    }
    return result;
  }
</script>
