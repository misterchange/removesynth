import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'PDF Resume Metadata Remover: Anonymize Job Submissions';
const description =
  'Clean author names, creation timestamps, and software signatures from PDF resumes and CVs. Anonymize your job applications 100% privately in your browser.';

const faqs: FaqItem[] = [
  {
    q: 'Why should I remove metadata from my PDF resume or CV?',
    a: 'When you export a resume from Microsoft Word, Google Docs, Apple Pages, or Canva, the PDF embeds hidden metadata including your personal computer username, corporate employer license names, revision counts, and exact creation timestamps. Scrubbing it guarantees blind hiring fairness and prevents leaking previous draft timestamps or template designers.',
  },
  {
    q: 'What metadata fields get removed from the PDF document?',
    a: 'Author (dc:creator), Document Title, Subject, Keywords, Creator tool (e.g., Canva, InDesign, Word), Producer library (e.g., Quartz, Skia), CreationDate, ModDate, and unreferenced XMP metadata stream dictionaries.',
  },
  {
    q: 'Will my resume layout, typography, or vector styling change?',
    a: 'No. The visual layout, typography, vectors, hyperlinks, and page formatting are 100 percent preserved. Only the invisible document /Info dictionary and XMP headers are scrubbed.',
  },
  {
    q: 'Is my confidential resume uploaded to any remote server?',
    a: 'No. The PDF scrubbing engine runs entirely in your local browser memory using client-side JavaScript. Your personal work history, contact details, and career credentials never leave your computer.',
  },
  {
    q: 'Does this tool work with ATS (Applicant Tracking Systems)?',
    a: 'Yes. ATS software parses the text stream and structure tree. Removing bloated or conflicting /Info dictionary tags ensures clean text extraction without confusing parsers with old author or template names.',
  },
  {
    q: 'How does this compare to Adobe Acrobat Pro metadata removal?',
    a: 'Acrobat Pro costs over twenty dollars a month and requires a heavy desktop installation. RemoveSynth provides the exact same ISO 32000-1 dictionary excision directly inside your browser for free with zero accounts.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Tools', url: `${SITE.url}/tools/` },
    { name: 'PDF Resume Metadata Remover', url: `${SITE.url}/pdf-resume-metadata-remover/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'PDF Resume Metadata Remover',
    url: `${SITE.url}/pdf-resume-metadata-remover/`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to remove metadata from a PDF resume',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Upload PDF resume',
        text: 'Drop your PDF resume or CV into the secure browser cleaner box above.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Binary trailer and Info excision',
        text: 'The in-browser engine scans the PDF cross-reference table and zeroes out the /Info dictionary and XMP metadata streams.',
