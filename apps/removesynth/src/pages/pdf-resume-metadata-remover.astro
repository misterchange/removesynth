    flex-direction: column;
    gap: 4px;
  }
  .pdf-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--fg);
  }
  .pdf-actions {
    margin-top: 18px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .pdf-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .tool-status {
    color: var(--muted);
  }

  .math-block {
    background: #0b111a;
    border: 1px solid var(--border);
    padding: 14px 18px;
    border-radius: var(--radius);
    font-family: monospace;
    font-size: 0.95rem;
    color: #2cc4f5;
    margin: 18px 0;
    overflow-x: auto;
  }

  .chart-svg {
    width: 100%;
    height: auto;
    max-width: 760px;
    display: block;
    margin: 24px auto;
  }

  .steps {
    list-style: decimal;
    padding-left: 24px;
    line-height: 1.8;
    margin: 20px 0;
  }

  .table-wrap {
    overflow-x: auto;
    margin: 24px 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th, td {
    padding: 10px 14px;
    border: 1px solid var(--border);
    text-align: left;
  }
  th {
    background: var(--card-bg);
    color: var(--fg);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 24px;
  }
  .faq-item {
    padding: 20px 24px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .faq-item h3 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    color: var(--fg);
  }
  .faq-item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
</style>

<script>
  import { downloadBlob } from '@removesynth/shared/lib/clean';

  const dropZone = document.getElementById('pdf-drop-zone') as HTMLElement;
  const fileInput = document.getElementById('pdf-file-input') as HTMLInputElement;
  const fileCard = document.getElementById('pdf-file-card') as HTMLElement;
  const filenameEl = document.getElementById('pdf-filename') as HTMLElement;
  const filesizeEl = document.getElementById('pdf-filesize') as HTMLElement;
  const btnChange = document.getElementById('btn-pdf-change') as HTMLButtonElement;
  const btnClean = document.getElementById('btn-clean-pdf') as HTMLButtonElement;
  const statusEl = document.getElementById('pdf-status') as HTMLElement;

  let currentFile: File | null = null;
  let fileBuffer: ArrayBuffer | null = null;

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    const kb = bytes / 1024;
    if (kb < 1024) return kb.toFixed(1) + ' KB';
    return (kb / 1024).toFixed(2) + ' MB';
  }

  function handleFile(file: File) {
    if (!file || !file.name.toLowerCase().endsWith('.pdf')) {
      alert('Please choose a valid .pdf document.');
      return;
    }
    currentFile = file;
    filenameEl.textContent = file.name;
    filesizeEl.textContent = formatBytes(file.size);

    dropZone.hidden = true;
    fileCard.hidden = false;
    btnClean.disabled = false;
    statusEl.textContent = 'Ready to clean metadata.';

    const reader = new FileReader();
    reader.onload = (e) => {
      fileBuffer = e.target?.result as ArrayBuffer;
    };
    reader.readAsArrayBuffer(file);
  }

  dropZone?.addEventListener('click', () => fileInput.click());
  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.length) handleFile(fileInput.files[0]);
  });

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer?.files.length) handleFile(e.dataTransfer.files[0]);
  });

  btnChange?.addEventListener('click', () => {
    currentFile = null;
    fileBuffer = null;
    fileInput.value = '';
    dropZone.hidden = false;
    fileCard.hidden = true;
    btnClean.disabled = true;
    statusEl.textContent = '';
  });

  btnClean?.addEventListener('click', async () => {
    if (!currentFile || !fileBuffer) return;
    btnClean.disabled = true;
    statusEl.textContent = 'Sanitizing PDF dictionary...';

    try {
      const bytes = new Uint8Array(fileBuffer.slice(0));
      const textDecoder = new TextDecoder('latin1');
      const textEncoder = new TextEncoder();
      let pdfString = textDecoder.decode(bytes);

      // 1. Wipe standard /Info dictionary tags by overwriting with neutral spaces
      const tagsToWipe = ['/Title', '/Author', '/Subject', '/Keywords', '/Creator', '/Producer', '/CreationDate', '/ModDate'];
      tagsToWipe.forEach((tag) => {
        const regex = new RegExp(`(${tag}\\s*\\([^)]*\\))`, 'g');
        pdfString = pdfString.replace(regex, (m) => ' '.repeat(m.length));
        const hexRegex = new RegExp(`(${tag}\\s*<[^>]*>)`, 'g');
        pdfString = pdfString.replace(hexRegex, (m) => ' '.repeat(m.length));
      });

      // 2. Wipe embedded XMP metadata packets
      pdfString = pdfString.replace(/<\?xpacket begin[\s\S]*?\?xpacket end=['"][rw]['"]\?>/gi, (m) => ' '.repeat(m.length));

      const cleanBytes = textEncoder.encode(pdfString);
      const cleanBlob = new Blob([cleanBytes], { type: 'application/pdf' });
      const outName = currentFile.name.replace(/\.pdf$/i, '-sanitized.pdf');

      downloadBlob(cleanBlob, outName);
      statusEl.textContent = 'Sanitized! All resume metadata stripped.';
      btnClean.disabled = false;
    } catch (err: any) {
      statusEl.textContent = `Error: ${err.message || 'Failed'}`;
      btnClean.disabled = false;
    }
  });
</script>
