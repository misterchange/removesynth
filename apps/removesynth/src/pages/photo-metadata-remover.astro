<script>
  import { cleanFile, type CleanProgress } from '@removesynth/shared/lib/clean';
  import { zipSync } from 'fflate';

  const root = document.getElementById('cleaner')!;
  const results = root.querySelector('.results') as HTMLElement;
  const summary = root.querySelector('.summary') as HTMLElement;
  const rows = root.querySelector('.rows') as HTMLElement;
  const zipBtn = root.querySelector('.zip') as HTMLButtonElement;
  const clearBtn = root.querySelector('.clear') as HTMLButtonElement;

  function formatBytes(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function downloadBlob(blob: Blob, name: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = name.replace(/\.[^/.]+$/, '') + '-clean.jpg';
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
  }

  interface Cleaned {
    file: File;
    blob: Blob;
    progress: CleanProgress;
  }
  const cleanedFiles: Cleaned[] = [];

  function updateSummary() {
    const total = cleanedFiles.length;
    const strippedTotal = cleanedFiles.reduce((acc, c) => acc + c.progress.stripped.length, 0);
    summary.textContent = `${total} photo${total === 1 ? '' : 's'} cleaned (${strippedTotal} metadata block${strippedTotal === 1 ? '' : 's'} removed)`;
    zipBtn.hidden = total < 2;
  }

  function renderRow(c: Cleaned) {
    const li = document.createElement('li');
    li.className = 'clean-row';

    const info = document.createElement('div');
    info.className = 'clean-info';
    const name = document.createElement('span');
    name.className = 'clean-name';
    name.textContent = c.file.name;
    const meta = document.createElement('span');
    meta.className = 'clean-meta';
    meta.textContent = `${formatBytes(c.file.size)} -> ${formatBytes(c.blob.size)} (${c.progress.stripped.join(', ') || 'already clean'})`;
    info.appendChild(name);
    info.appendChild(meta);

    const dl = document.createElement('button');
    dl.type = 'button';
    dl.className = 'btn btn-sm';
    dl.textContent = 'Download';
    dl.addEventListener('click', () => downloadBlob(c.blob, c.file.name));

    li.appendChild(info);
    li.appendChild(dl);
    rows.appendChild(li);
  }

  root?.addEventListener('files', async (e) => {
    const files = (e as CustomEvent<File[]>).detail;
    if (!files || !files.length) return;
    results.hidden = false;
    for (const file of files) {
      try {
        const res = await cleanFile(file, { aiOnly: false });
        const item: Cleaned = { file, blob: res.blob, progress: res.progress };
        cleanedFiles.push(item);
        renderRow(item);
        updateSummary();
      } catch {
        // ignore failures
      }
    }
  });

  zipBtn?.addEventListener('click', async () => {
    if (cleanedFiles.length === 0) return;
    zipBtn.disabled = true;
    zipBtn.textContent = 'Creating ZIP...';
    try {
      const entries: Record<string, Uint8Array> = {};
      for (const c of cleanedFiles) {
        let n = c.file.name.replace(/\.[^/.]+$/, '') + '-clean.jpg';
        for (let i = 2; entries[n]; i++) {
          n = c.file.name.replace(/\.[^/.]+$/, '') + `-clean-${i}.jpg`;
        }
        entries[n] = new Uint8Array(await c.blob.arrayBuffer());
      }
      const zipBlob = new Blob([zipSync(entries, { level: 0 })], { type: 'application/zip' });
      const url = URL.createObjectURL(zipBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'cleaned-photos.zip';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 10000);
    } finally {
      zipBtn.disabled = false;
      zipBtn.textContent = 'Download all (ZIP)';
    }
  });

  clearBtn?.addEventListener('click', () => {
    cleanedFiles.length = 0;
    rows.innerHTML = '';
    results.hidden = true;
  });

  const btnShare = document.getElementById('btn-share-state');
  const btnCopy = document.getElementById('btn-copy-summary');
  const toast = document.getElementById('utility-toast');

  function showToast(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.hidden = false;
    setTimeout(() => {
      toast.hidden = true;
    }, 2500);
  }

  btnShare?.addEventListener('click', async () => {
    const cleanUrl = `${window.location.origin}${window.location.pathname}#photo-metadata-tool`;
    try {
      await navigator.clipboard.writeText(cleanUrl);
      showToast('Tool link copied to clipboard');
    } catch {
      showToast('Link: ' + cleanUrl);
    }
  });

  btnCopy?.addEventListener('click', async () => {
    const sum = 'Sanitized with RemoveSynth: EXIF, GPS location coordinates, and camera serials removed losslessly with 100% in-browser privacy.';
    try {
      await navigator.clipboard.writeText(sum);
      showToast('Summary copied to clipboard');
    } catch {
      showToast('Verification copied');
    }
  });
</script>

