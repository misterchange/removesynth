        <polygon points="375,155 385,155 380,165" fill="rgba(255,255,255,0.5)" />

        <!-- Sanitized File Container Track -->
        <text x="80" y="195" fill="rgba(255,255,255,0.7)" font-size="12" font-weight="600">Sanitized Photo Container (Bit-for-Bit Pixel Match):</text>
        <rect x="80" y="210" width="60" height="45" rx="4" fill="#3b82f6" />
        <text x="110" y="237" fill="#fff" font-size="11" text-anchor="middle">SOI</text>
        
        <rect x="145" y="210" width="110" height="45" rx="4" stroke="#22c55e" stroke-dasharray="4,4" fill="rgba(34,197,94,0.05)" />
