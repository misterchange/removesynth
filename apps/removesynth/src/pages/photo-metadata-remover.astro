---
import Base from '../layouts/Base.astro';
import ToolDrop from '@removesynth/shared/components/ToolDrop.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { SITE } from '../site';

const title = 'Photo Metadata Remover: Remove EXIF & GPS Online Free';
const description =
  'Remove EXIF data, GPS location coordinates and camera serials from photos online. Free in-browser metadata cleaner for JPG, PNG and WebP with zero uploads.';

const faqs = [
  {
    q: 'What metadata does the photo metadata remover delete?',
    a: 'It removes GPS latitude and longitude coordinates, camera make and model, lens serial numbers, exact capture timestamps, author names, copyright notices, editing history in Adobe XMP, and embedded thumbnail images.',
  },
  {
    q: 'Does removing photo metadata re-encode or compress the picture?',
    a: 'No. The image raster data is preserved bit-for-bit without decompression or re-encoding. Only binary header metadata segments (APP1, XMP) are cleanly stripped from the file container.',
  },
  {
    q: 'Does taking a screenshot reliably remove photo metadata?',
    a: 'A screenshot creates a new raster that lacks original EXIF data, but it drastically reduces image resolution, compresses dynamic range, and introduces screen artifacts. Our tool removes metadata while keeping 100 percent original resolution and clarity.',
  },
  {
    q: 'Can I remove metadata from iPhone HEIC photos?',
    a: 'Yes. You can convert iPhone HEIC photos to JPG using our client-side HEIC to JPG tool, which automatically outputs clean, metadata-free images.',
  },
  {
    q: 'Can I clean multiple photos at the same time?',
    a: 'Yes. You can drag and drop up to 30 photos simultaneously. The tool cleans them in parallel and lets you download them individually or as a single ZIP archive.',
  },
  {
    q: 'Are my private photos uploaded to any server or cloud database?',
    a: 'No. All processing happens 100 percent locally in your browser memory using client-side JavaScript. Your photos never leave your device.',
  },
  {
    q: 'Does this tool work on mobile devices?',
    a: 'Yes. RemoveSynth runs in any modern browser on iOS Safari, Android Chrome, Windows, macOS, and Linux.',
  },
  {
    q: 'Does it remove AI provenance labels like C2PA?',
    a: 'By default, this tool keeps orientation and color profiles intact so photos render upright. If you also need to strip C2PA Content Credentials or AI Info flags, use our AI Metadata Remover.',
  },
];

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}/photo-metadata-remover/#webpage`,
      'url': `${SITE.url}/photo-metadata-remover/`,
      'name': title,
      'description': description,
      'isPartOf': {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        'name': SITE.name,
        'url': SITE.url,
      },
      'breadcrumb': {
        '@id': `${SITE.url}/photo-metadata-remover/#breadcrumb`,
      },
      'mainEntity': {
        '@id': `${SITE.url}/photo-metadata-remover/#app`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/photo-metadata-remover/#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `${SITE.url}/`,
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Tools',
          'item': `${SITE.url}/tools/`,
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': 'Photo Metadata Remover',
          'item': `${SITE.url}/photo-metadata-remover/`,
        },
      ],
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      '@id': `${SITE.url}/photo-metadata-remover/#app`,
      'name': 'Photo Metadata Remover',
      'url': `${SITE.url}/photo-metadata-remover/`,
      'applicationCategory': 'MultimediaApplication',
      'operatingSystem': 'Web (Any browser)',
      'isAccessibleForFree': true,
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
      },
      'featureList': [
        'Batch clean up to 30 photos at once',
        'Instant GPS coordinate and location track removal',
        'Camera make, model, and serial number stripping',
        'Lossless container parsing with zero re-encoding',
        'Zero server uploads with complete privacy',
      ],
    },
    {
      '@type': 'HowTo',
      '@id': `${SITE.url}/photo-metadata-remover/#howto`,
      'name': 'How to Remove Metadata and EXIF Data from Photos',
      'description': 'Step-by-step guide to removing GPS coordinates, camera serial numbers, and personal metadata from photos online.',
      'step': [
        {
          '@type': 'HowToStep',
          'position': 1,
          'name': 'Select your photos',
          'text': 'Drag and drop up to 30 JPG, PNG, or WebP pictures into the file dropzone above.',
        },
        {
          '@type': 'HowToStep',
          'position': 2,
          'name': 'In-browser binary metadata stripping',
          'text': 'The browser slices binary APP1 EXIF, XMP, and IPTC segments without touching image pixel streams.',
        },
        {
          '@type': 'HowToStep',
          'position': 3,
          'name': 'Review sanitized file summary',
          'text': 'Inspect the cleaned file table to confirm stripped metadata tags and byte size savings.',
        },
        {
          '@type': 'HowToStep',
          'position': 4,
          'name': 'Download cleaned images',
          'text': 'Download your sanitized photos individually or export all files as a single ZIP archive.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/photo-metadata-remover/#faq`,
      'mainEntity': faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': `<p>${f.a}</p>`,
        },
      })),
