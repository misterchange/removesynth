        <rect x="470" y="210" width="190" height="45" rx="4" fill="#22c55e" />
        <text x="565" y="237" fill="#fff" font-size="11" text-anchor="middle">SOF0 / SOS (Raw Pixels)</text>
        
        <rect x="665" y="210" width="55" height="45" rx="4" fill="#3b82f6" />
