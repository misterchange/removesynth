  ],
};
---

<Base title={title} description={description} schema={[jsonLdGraph]}>
  <section class="hero" id="photo-metadata-tool">
    <div class="container">
      <span class="eyebrow">Batch up to 30 Photos - 100% In-Browser Privacy - Zero Server Uploads</span>
      <h1>Photo Metadata Remover to Clean EXIF and GPS Data Online</h1>
      
      <div class="tool-wrapper">
        <ToolDrop
          id="cleaner"
          accept="image/jpeg,image/png,image/webp"
          multiple
          title="Drop photos to clean metadata"
          sub="Removes GPS location, camera serials, timestamps, and personal names."
          meta="Click to choose or paste - JPG, PNG, WebP - Batch up to 30 files"
          footnote="Runs 100% in your browser - zero files uploaded - orientation preserved"
        >
