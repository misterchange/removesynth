        </defs>
        <!-- Background Grid -->
        <rect x="10" y="10" width="740" height="340" rx="8" fill="#0b111a" stroke="#1f2d3d" stroke-width="1"/>
        
        <!-- Top Label: Before -->
        <text x="30" y="45" fill="#ff4444" font-weight="700" font-size="14">BEFORE REMOVESYNTH (18.4 MB Total)</text>
        <rect x="30" y="60" width="60" height="40" rx="4" fill="#1b2533" stroke="#2cc4f5" stroke-width="1"/>
        <text x="42" y="85" fill="#fff" font-size="11">SOI</text>
        
