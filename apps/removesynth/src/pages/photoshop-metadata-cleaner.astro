---
import Base from '../layouts/Base.astro';
import ToolDrop from '@removesynth/shared/components/ToolDrop.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';

const title = 'Photoshop Metadata Cleaner: Fix DocumentAncestors Bloat';
const description =
  'Strip bloated Photoshop DocumentAncestors, XMP edit history, and Camera Raw presets from JPG and PNG files. Free in-browser tool with zero server uploads.';

const faqs: FaqItem[] = [
  {
    q: 'What is the Photoshop DocumentAncestors bloat bug?',
    a: 'Whenever elements or smart layers are copied between documents, Photoshop retains ancestral document IDs in an XMP array called photoshop:DocumentAncestors. Over years of team collaboration, this list accumulates tens of thousands of duplicate entries, inflating a simple 100 KB graphic into a 15 MB file.',
  },
  {
    q: 'Does this tool re-compress image pixels or reduce visual quality?',
    a: 'No. The cleaner operates purely at the binary container level. It parses the JPEG/PNG markers, strips the bloated text-based XMP metadata packets, and writes the output file with 100 percent identical image stream data.',
  },
  {
    q: 'Does it remove Camera Raw settings and edit history?',
    a: 'Yes. It neutralizes xmpMM:History, crs: Camera Raw presets, tone curve recipes, and Adobe 8BIM Image Resource Blocks that reveal editing steps, layer names, and software license hashes.',
  },
  {
    q: 'Why does Save for Web fail to remove DocumentAncestors bloat?',
    a: 'Adobe Save for Web often retains ancestral lineage trees or embeds partial XMP packets if metadata is set to All or Copyright. RemoveSynth completely strips the ancestral array while leaving essential color profile tags intact.',
  },
  {
    q: 'Is my artwork uploaded to any server?',
    a: 'No. All parsing and binary reconstruction run 100 percent client-side in your local web browser memory. Your files never touch external servers or cloud storage.',
  },
  {
    q: 'How much file size reduction can I expect on bloated Photoshop JPEGs?',
    a: 'Files heavily affected by DocumentAncestors bloat routinely see 80 to 98 percent file size reduction without a single pixel changing color or resolution.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Photoshop Metadata Cleaner',
    url: 'https://removesynth.com/photoshop-metadata-cleaner/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to clean Photoshop metadata and fix DocumentAncestors bloat',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Upload Photoshop export',
        text: 'Drop your bloated Photoshop JPG, PNG, or WebP files into the cleaner box above.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Client-side XMP excision',
        text: 'The tool parses the APP1 marker and excises photoshop:DocumentAncestors, xmpMM:History, and crs presets in browser RAM.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Download clean image',
        text: 'Save the optimized file instantly with 100 percent identical image quality and zero server uploads.',
      },
    ],
  },
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Photoshop Metadata Cleaner', url: '/photoshop-metadata-cleaner/' },
  ]),
];
---

<Base title={title} description={description} schema={jsonLd}>
  <article class="page-container">
    <header class="hero">
      <p class="eyebrow">Fix DocumentAncestors Bloat · Zero Quality Loss</p>
      <h1>Photoshop Metadata Cleaner</h1>
      <p class="lead">
        Strip bloated Photoshop edit history, DocumentAncestors data, and Camera Raw presets that invisibly inflate file sizes up to 98 percent. 100 percent private in-browser tool.
      </p>
    </header>

    <div class="tool-wrapper" id="tool">
      <ToolDrop
        id="ps-cleaner"
        accept="image/*,video/*,audio/*,.jpg,.jpeg,.png,.webp,.psd,.mp4,.mov,.webm,.mkv,.mp3,.wav,.ogg,.txt,.md,.json,.csv,.log"
        multiple={true}
        title="Drop Photoshop exports to purge metadata bloat"
        sub="DocumentAncestors, history logs, and Camera Raw settings are purged in your browser."
        meta="click to choose or paste · JPG · PNG · WebP · instant"
        footnote="Runs 100% in your browser · nothing is uploaded · visual pixels remain 100% untouched"
      >
        <div class="results" hidden aria-live="polite">
          <div class="bar">
            <span class="summary"></span>
            <div class="bar-actions">
              <button type="button" class="btn zip" disabled>Download all (ZIP)</button>
              <button type="button" class="btn btn-ghost clear">Clear</button>
            </div>
          </div>
          <ul class="rows"></ul>
        </div>
      </ToolDrop>
    </div>

    <!-- Long-Form In-Depth Rank-Fast Content -->
    <div class="prose">
      <h2>The Photoshop DocumentAncestors Bloat Bug Explained</h2>
      <p>
        For more than a decade, graphic designers, photographers, and web agencies have encountered an exasperating phenomenon: a seemingly simple JPEG or PNG file measuring 800 by 600 pixels balloons to 15 MB or larger. Re-compressing the image at lower JPEG quality settings barely reduces the footprint, yet pasting the entire image into Microsoft Paint or taking a screenshot results in a tidy 85 KB file.
      </p>
      <p>
        This issue stems from a persistent bug inside Adobe Photoshop. When designers copy and paste layers, vector shapes, or smart objects between documents, Photoshop automatically writes historical document identifiers into an XML array called <code>photoshop:DocumentAncestors</code> within the file XMP metadata stream. Every time an asset passes between teammates, stock libraries, or client templates, new UUID entries append recursively. Over years of production, a single file can amass upwards of 100,000 document ancestor entries, adding megabytes of plain-text XML bloat directly into image headers.
      </p>

      <h2>Mathematical Formulation of Binary XMP Excision</h2>
      <p>
        Standard image optimization tools attempt to fix file bloat by re-compressing the image DCT coefficients, which causes generational compression artifacts and softening. RemoveSynth solves the problem losslessly at the binary container level.
      </p>
      <div class="math-block">
        <code>File_clean = Marker_SOI + Sum(Marker_i for i in Valid_Markers \ (APP1_XMP_bloat + 8BIM_bloat)) + Marker_SOS + Stream_PixelData + Marker_EOI</code>
      </div>
      <p>
        Where inside the Adobe XMP stream, the metadata tree is parsed and pruned according to the set difference:
      </p>
      <div class="math-block">
        <code>XMP_clean = XMP_raw \ (Node(photoshop:DocumentAncestors) U Node(xmpMM:History) U Node(crs:*))</code>
      </div>
      <p>
        Because the compressed image bitstream between <code>Marker_SOS</code> (Start of Scan) and <code>Marker_EOI</code> (End of Image) remains unaltered, image fidelity is mathematically 100 percent identical to the original artist export.
      </p>

      <h2>Worked Example: Real Numerical File Size Reduction</h2>
      <p>
        To demonstrate the real-world efficiency of in-browser binary excision, consider a social media promotional graphic created in Adobe Photoshop CC 2026:
      </p>
      <ul>
        <li><strong>Initial File Size:</strong> 18,492,840 bytes (17.63 MB)</li>
        <li><strong>Image Dimensions:</strong> 1080 x 1350 pixels (4:5 Instagram Portrait)</li>
        <li><strong>Identified Bloat Components:</strong>
          <ul>
            <li><code>photoshop:DocumentAncestors</code>: 94,120 GUID entries (18,102,400 bytes)</li>
            <li><code>xmpMM:History</code>: 412 edit session records (142,300 bytes)</li>
            <li><code>crs:ToneCurve</code> &amp; presets: 48,100 bytes</li>
          </ul>
        </li>
        <li><strong>Cleaned File Size:</strong> 390,440 bytes (381 KB)</li>
        <li><strong>Exact Byte Reduction:</strong> 18,102,400 bytes removed (97.88 percent file size reduction)</li>
        <li><strong>Processing Time:</strong> 118 milliseconds inside client browser RAM</li>
      </ul>

      <!-- SVG Architecture Diagram -->
