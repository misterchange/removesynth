<script>
  interface CleanedItem {
    name: string;
    size: number;
    url: string;
    blob: Blob;
    findings: string[];
  }

  const cleanedItems: CleanedItem[] = [];

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const resultsArea = document.getElementById('results-area')!;
  const summaryCount = document.getElementById('summary-count')!;
  const summaryDetails = document.getElementById('summary-details')!;
  const itemsList = document.getElementById('items-list')!;
  const btnDownloadAll = document.getElementById('btn-download-all')!;
  const btnCopySummary = document.getElementById('btn-copy-summary');
  const btnShareState = document.getElementById('btn-share-state');

  dz.addEventListener('click', () => fileIn.click());

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag-active');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag-active'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag-active');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      handleFiles(Array.from(e.dataTransfer.files));
    }
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files && fileIn.files.length > 0) {
      handleFiles(Array.from(fileIn.files));
    }
  });

  function formatBytes(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  async function handleFiles(files: File[]) {
    resultsArea.hidden = false;

    for (const file of files) {
      const findings = await detectAITriggers(file);
      const cleanBlob = await sanitizeImage(file);
      const cleanUrl = URL.createObjectURL(cleanBlob);

      cleanedItems.push({
        name: file.name.replace(/\.[^/.]+$/, '') + '-social-clean.jpg',
        size: cleanBlob.size,
        url: cleanUrl,
        blob: cleanBlob,
        findings,
      });
    }

    renderItems();
  }

  async function detectAITriggers(file: File): Promise<string[]> {
    const findings: string[] = [];
    const buf = await file.arrayBuffer();
    const str = new TextDecoder('latin1').decode(buf.slice(0, 100000));

    if (str.includes('c2pa') || str.includes('C2PA') || str.includes('jumb')) {
      findings.push('C2PA Content Credentials Manifest');
    }
    if (str.includes('compositeWithTrainedAlgorithmicMedia') || str.includes('trainedAlgorithmicMedia') || str.includes('DigitalSourceType')) {
      findings.push('IPTC DigitalSourceType Flag');
    }
    if (str.includes('Generative') || str.includes('firefly') || str.includes('dall-e') || str.includes('midjourney')) {
      findings.push('Generative Edit History Tag');
    }
    if (findings.length === 0) {
      findings.push('General Metadata and Compression Signatures');
    }
    return findings;
  }

  async function sanitizeImage(file: File): Promise<Blob> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.src = url;

      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        const ctx = canvas.getContext('2d')!;

        // Draw image onto clean 2D canvas, stripping all file-level headers and manifests
        ctx.drawImage(img, 0, 0);

        canvas.toBlob((blob) => {
          URL.revokeObjectURL(url);
          resolve(blob || file);
        }, 'image/jpeg', 0.94);
      };

      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(file);
      };
    });
  }

  function renderItems() {
    summaryCount.textContent = `${cleanedItems.length} image${cleanedItems.length > 1 ? 's' : ''} sanitized`;
    summaryDetails.textContent = 'All C2PA, IPTC AI source types, and Adobe history wiped';
    itemsList.innerHTML = '';

    cleanedItems.forEach((item) => {
      const card = document.createElement('div');
      card.className = 'cleaned-item-card';
      card.innerHTML = `
        <div class="item-col-preview">
          <img src="${item.url}" alt="${item.name}" />
        </div>
        <div class="item-col-info">
          <strong class="item-name">${item.name}</strong>
          <span class="item-meta">${formatBytes(item.size)} - Ready for Instagram and Facebook</span>
          <div class="item-tags">
            ${item.findings.map(f => `<span class="purged-pill">Purged: ${f}</span>`).join('')}
          </div>
        </div>
        <div class="item-col-action">
          <a href="${item.url}" download="${item.name}" class="btn-download-single">
            Download Clean Photo
          </a>
        </div>
      `;
      itemsList.appendChild(card);
    });
  }

  btnDownloadAll.addEventListener('click', () => {
    cleanedItems.forEach((item, idx) => {
      setTimeout(() => {
        const a = document.createElement('a');
        a.href = item.url;
        a.download = item.name;
        a.click();
      }, idx * 250);
    });
  });

  if (btnCopySummary) {
    btnCopySummary.addEventListener('click', () => {
      const summaryText = `RemoveSynth AI Info Sanitizer Report:\n${cleanedItems.length} files sanitized.\nPurged: C2PA Content Credentials, IPTC DigitalSourceType, Adobe Generative Fill histories.\nReady for Instagram and Facebook without AI tags.`;
      navigator.clipboard.writeText(summaryText).then(() => {
        btnCopySummary.textContent = 'Copied!';
        setTimeout(() => {
          btnCopySummary.textContent = 'Copy Report';
        }, 2000);
      });
    });
  }

  if (btnShareState) {
    btnShareState.addEventListener('click', () => {
      const shareUrl = `${window.location.origin}${window.location.pathname}#tool`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        btnShareState.textContent = 'Link Copied!';
        setTimeout(() => {
          btnShareState.textContent = 'Share Link';
        }, 2000);
      });
    });
  }
</script>

