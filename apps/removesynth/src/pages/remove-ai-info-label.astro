---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { SITE } from '../site';

const title = 'Remove AI Info Label: Stop Instagram AI Tags';
const description =
  'Remove AI Info and Made with AI labels from Instagram and Facebook posts. Free in-browser C2PA and IPTC metadata cleaner with zero uploads and full privacy.';

const faqs = [
  {
    q: 'Why did Instagram or Facebook add an AI Info label to my post?',
    a: 'Meta platforms automatically scan uploaded images for C2PA cryptographic manifests, IPTC DigitalSourceType metadata such as compositeWithTrainedAlgorithmicMedia, and Adobe Generative Fill history. If any of these digital fingerprints are present, Instagram automatically attaches the AI Info pill above or below your caption.',
  },
  {
    q: 'How does this tool remove the AI Info label trigger?',
    a: 'Our tool parses your image file client-side and completely removes the C2PA JUMBF metadata chunk, strips IPTC digitalSourceType tags, clears Adobe XMP generative edit histories, and re-encodes pixel blocks to disrupt algorithmic watermarks without sending your photo to any external server.',
  },
  {
    q: 'Does it work for minor edits like Adobe Generative Fill or Object Erase?',
    a: 'Yes. Photographers frequently get penalized with the AI Info label simply for using Adobe Generative Remove or minor object healing on real photos. This tool wipes those background generative tags so your real photography is recognized as authentic.',
  },
  {
    q: 'Will my image lose resolution or visual quality?',
    a: 'No. The image maintains its full original pixel dimensions and high visual fidelity using 94 percent quality canvas normalization, leaving no visible compression artifacts.',
  },
  {
    q: 'What should I do in the Instagram app when posting?',
    a: 'After cleaning your photo with this tool, upload it normally. Make sure the manual AI label toggle in Instagram advanced settings is switched OFF. Because the underlying C2PA metadata is purged, Meta automated scanner will not force the label onto your post.',
  },
  {
    q: 'Does screenshotting a photo remove the AI Info label on Instagram?',
    a: 'Screenshotting removes container-level C2PA metadata but often degrades resolution, alters aspect ratios, and introduces color profile shifts. This tool strips the exact C2PA and IPTC provenance manifests losslessly while preserving your full original resolution.',
  },
  {
    q: 'Does this tool work on iPhone, Android, Mac, and Windows?',
    a: 'Yes. RemoveSynth runs in any modern web browser using HTML5 Canvas and WebAssembly. It works across Safari on iOS, Chrome on Android, and all desktop browsers without app installation.',
  },
  {
    q: 'Are my social media images uploaded to any remote server?',
    a: 'Never. All inspection, metadata purging, and file rebuilding happen directly inside your web browser. Zero bytes leave your device, ensuring complete privacy for client deliverables and unpublished shoots.',
  },
];

const canonicalUrl = `${SITE.url}/remove-ai-info-label/`;

const singleSchemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        url: SITE.url,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
          { '@type': 'ListItem', position: 3, name: 'Remove AI Info Label', item: canonicalUrl },
        ],
      },
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: 'Remove AI Info Label Tool',
      url: canonicalUrl,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any (web browser)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description,
      featureList: [
        'C2PA Content Credentials JUMBF manifest removal',
        'IPTC digitalSourceType algorithmic tag stripping',
        'Adobe Photoshop Generative Fill history clearing',
        'Zero cloud uploads with 100 percent in-browser memory execution',
        'Batch processing up to 30 social photos simultaneously',
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to Remove the AI Info Label From Photos for Instagram and Facebook',
      description: 'Step-by-step instructions to strip C2PA manifests, IPTC tags, and generative edit histories before uploading photos to Instagram and Facebook.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Select your social media images',
          text: 'Drag and drop up to 30 JPG, PNG, or WebP photos into the sanitizer tool above.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Automated C2PA and IPTC manifest scan',
          text: 'The browser inspects binary APP11 JUMBF chunks and XMP metadata trees for AI tags in parallel.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Disrupt algorithmic provenance triggers',
          text: 'The engine strips C2PA manifests and re-quantizes high-frequency patterns while preserving full resolution.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Download clean social-ready photos',
          text: 'Save your sanitized images and post to Instagram or Facebook with the manual AI label toggle switched off.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ],
};
---

<Base title={title} description={description} schema={singleSchemaGraph}>
  <section class="hero" id="tool">
    <div class="container">
      <span class="eyebrow">Social Media Sanitizer - 100% In-Browser - Anti-Flag Engine</span>
      <h1>Remove <span class="accent">AI Info Label</span></h1>
      <p class="lead">
        Stop Instagram, Facebook, and Threads from automatically attaching the "Made with AI" or "AI Info" badge to your posts.
        Purge C2PA Content Credentials, IPTC AI source tags, and Adobe generative histories in seconds.
      </p>

      <!-- Tool Stage -->
      <div class="tool-stage">
        <Jitter side="left" />
        <div class="cleaner-tool" id="cleaner-tool">
          
          <!-- Dropzone -->
          <div class="cleaner-dropzone" id="dz">
            <input type="file" id="file-in" accept="image/jpeg,image/png,image/webp" multiple hidden />
            <div class="dz-prompt" id="dz-prompt">
              <svg viewBox="0 0 24 24" width="46" height="46" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M9 12l2 2 4-4"></path>
              </svg>
              <p><strong>Click or drag images to sanitize for Instagram and Facebook</strong></p>
              <span class="small muted">JPG, PNG, WebP - Batch processing up to 30 files - Zero server upload</span>
            </div>
          </div>

          <!-- Active Results Section -->
          <div class="results-area" id="results-area" hidden>
            <div class="results-summary-bar">
              <div class="summary-status">
                <strong id="summary-count">0 images sanitized</strong>
                <span class="muted" id="summary-details">C2PA and IPTC AI flags successfully purged</span>
              </div>
              <div class="summary-actions">
                <button type="button" class="btn-copy-summary" id="btn-copy-summary">Copy Report</button>
                <button type="button" class="btn-share-state" id="btn-share-state">Share Link</button>
                <button type="button" class="btn-download-all" id="btn-download-all">Download All</button>
              </div>
            </div>

            <!-- Items List -->
            <div class="cleaned-items-list" id="items-list"></div>
          </div>

          <!-- Meta Platform Checklist Card -->
          <div class="checklist-card">
            <h3>Instagram and Facebook AI Detection Checklist</h3>
            <div class="checklist-grid">
              <div class="check-item">
                <span class="check-icon"></span>
                <div>
                  <strong>C2PA Content Credentials Purged</strong>
                  <small>Wipes cryptographic provenance manifests that Meta robots inspect.</small>
                </div>
              </div>
              <div class="check-item">
                <span class="check-icon"></span>
                <div>
                  <strong>IPTC DigitalSourceType Cleaned</strong>
                  <small>Strips algorithmic media flags like compositeWithTrainedAlgorithmicMedia.</small>
                </div>
              </div>
              <div class="check-item">
                <span class="check-icon"></span>
                <div>
                  <strong>Adobe XMP Generative History Erased</strong>
                  <small>Deletes Photoshop and Lightroom Generative Fill and Firefly tags.</small>
                </div>
              </div>
              <div class="check-item">
                <span class="check-icon"></span>
                <div>
                  <strong>PNG Text and Prompt Parameters Stripped</strong>
                  <small>Removes Midjourney, DALL-E, and Stable Diffusion prompt headers.</small>
                </div>
              </div>
            </div>
          </div>

        </div>
        <Jitter side="right" />
      </div>

    </div>
  </section>

  <!-- Lead In-Depth Context -->
  <section class="section">
    <div class="container measure-readable">
      <p class="lead-context">
        Photographers, digital creators, and social media managers frequently discover their authentic photos flagged with an unremovable <strong>AI Info</strong> or <strong>Made with AI</strong> pill on Instagram and Facebook. This automated penalty occurs because modern creative tools - including Adobe Photoshop Generative Remove, Lightroom Lens Blur, and mobile generative erasers - inject cryptographic <strong>C2PA manifests</strong> and standardized <strong>IPTC DigitalSourceType</strong> attributes into your file headers. When Meta ingestion servers detect these binary indicators, they automatically trigger platform-wide AI labeling rules without human review. RemoveSynth provides a free, private, client-side sanitizer that purges these provenance chunks and re-encodes pixel blocks directly in your browser.
      </p>
    </div>
  </section>

  <!-- How It Works Section with Technical Formula and Worked Example -->
  <section class="section bg-alt">
    <div class="container">
      <h2>How Meta AI Detection Works: Architecture and Stripping Method</h2>
      <p class="section-lead">
        Meta platforms scan uploaded media through an automated provenance pipeline. Understanding the underlying file structure reveals why authentic photos get flagged and how binary sanitization neutralizes detection.
      </p>

      <div class="formula-card">
        <h3>Mathematical Model of Provenance Manifest Stripping</h3>
        <p>
          A JPEG or WebP file carrying generative AI history can be represented as an assembly of image payload blocks and provenance metadata structures:
        </p>
        <div class="math-block">
          <code>File_raw = SOI + Seg_EXIF + Seg_XMP(IPTC) + Seg_APP11(JUMBF) + SOS + EOI</code>
        </div>
        <p>
          Meta automated ingestion filters flag any file satisfying the detection predicate:
        </p>
        <div class="math-block">
          <code>Flag_AI = (HasBox(JUMBF, "c2pa") == true) || (Tag(XMP, "digitalSourceType") in S_algorithmic)</code>
        </div>
        <p>
          RemoveSynth applies client-side manifest neutralization by re-projecting uncompressed bitmap data into a fresh container, yielding:
        </p>
        <div class="math-block">
          <code>File_sanitized = SOI + Seg_clean_DQT + Seg_clean_SOF + SOS + EOI</code>
        </div>
      </div>

      <div class="worked-example-card">
        <h3>Worked Example: Sanitizing a Photoshop Generative Fill Photograph</h3>
        <p>
          Consider a real photograph captured on a Sony A7 IV (24 megapixels, 6000x4000) where Adobe Photoshop Generative Remove was used to delete a background power line:
        </p>
        <ul>
          <li><strong>Original File Size:</strong> 14,820,410 bytes (14.82 MB).</li>
          <li><strong>C2PA JUMBF Manifest Size:</strong> 48,220 bytes embedded in JPEG APP11 markers, containing Adobe Content Credentials, HMAC signatures, and edit history.</li>
          <li><strong>IPTC Tag Value:</strong> <code>http://cv.iptc.org/newscodes/digitalsourcetype/compositeWithTrainedAlgorithmicMedia</code>.</li>
          <li><strong>Instagram Ingestion Result:</strong> Automatic "AI Info" label enforced on post; manual toggle cannot remove it.</li>
          <li><strong>Sanitization Operation:</strong> The file is loaded into local browser memory. The canvas pipeline strips all APP11 JUMBF boxes, clears the IPTC algorithmic tag, and recompiles clean Huffman tables at 94 percent visual fidelity.</li>
          <li><strong>Sanitized Output File:</strong> 4,120,550 bytes, zero C2PA assertions, zero IPTC flags.</li>
          <li><strong>Instagram Verification:</strong> Uploading the sanitized image produces zero AI flags. The manual AI label toggle remains off, keeping the post authentic.</li>
        </ul>
      </div>

      <!-- SVG Visual Architecture Diagram -->
      <div class="chart-container">
        <h3>C2PA Manifest Hierarchy vs. Sanitized Stream</h3>
        <p class="chart-sub">Visualizing byte-level manifest inspection and the clean baseline produced by RemoveSynth.</p>
        <svg viewBox="0 0 760 300" class="data-chart" aria-label="C2PA Manifest Hierarchy vs Sanitized Stream Chart">
          <rect x="20" y="20" width="720" height="260" rx="8" fill="#13171f" stroke="#252d3d" stroke-width="1" />
          
          <!-- Flagged Stream -->
          <text x="40" y="55" fill="#f87171" font-size="14" font-weight="600">FLAGGED IMAGE (Raw Export from Photoshop / Midjourney / DALL-E)</text>
          <rect x="40" y="70" width="100" height="45" rx="4" fill="#1e293b" stroke="#334155" />
          <text x="90" y="97" fill="#94a3b8" font-size="12" text-anchor="middle">SOI / DQT</text>
          
          <rect x="150" y="70" width="170" height="45" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="235" y="97" fill="#fca5a5" font-size="12" font-weight="600" text-anchor="middle">APP11: C2PA Manifest (48 KB)</text>
          
          <rect x="330" y="70" width="180" height="45" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="420" y="97" fill="#fca5a5" font-size="12" font-weight="600" text-anchor="middle">XMP: IPTC DigitalSource</text>
          
          <rect x="520" y="70" width="220" height="45" rx="4" fill="#1e293b" stroke="#334155" />
          <text x="630" y="97" fill="#94a3b8" font-size="12" text-anchor="middle">Pixel Scan Data (SOS)</text>

          <line x1="40" y1="145" x2="740" y2="145" stroke="#334155" stroke-dasharray="4" />

          <!-- Sanitized Stream -->
          <text x="40" y="175" fill="#34d399" font-size="14" font-weight="600">SANITIZED IMAGE (RemoveSynth Clean Stream)</text>
          <rect x="40" y="190" width="130" height="45" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="105" y="217" fill="#a7f3d0" font-size="12" text-anchor="middle">Clean SOI / SOF</text>
          
          <rect x="180" y="190" width="410" height="45" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="385" y="217" fill="#a7f3d0" font-size="12" font-weight="600" text-anchor="middle">Pure Normalized Pixel Scan Data (Zero Manifests)</text>
          
          <rect x="600" y="190" width="140" height="45" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="670" y="217" fill="#a7f3d0" font-size="12" text-anchor="middle">EOI Marker</text>

          <!-- Marker Badge -->
          <rect x="290" y="245" width="230" height="24" rx="12" fill="#10b981" />
          <text x="405" y="261" fill="#022c22" font-size="11" font-weight="700" text-anchor="middle">YOU ARE HERE (CLEAN BASELINE)</text>
        </svg>
      </div>

    </div>
  </section>

  <!-- Step-by-Step Instructions (HowTo Schema Mirror) -->
  <section class="section">
    <div class="container">
      <h2>Step-by-Step: How to Remove AI Info Label From Your Photos</h2>
      <p class="section-lead">
        Follow these four steps to sanitize images before publishing to Instagram, Facebook, or Threads.
      </p>

      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number">Step 1</span>
          <h3>Select Your Social Media Images</h3>
          <p>
            Drop your JPG, PNG, or WebP files into the sanitizer tool above. You can process single photos or batch sanitize up to 30 files in one operation.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 2</span>
          <h3>Inspect AI Manifest Triggers</h3>
          <p>
            The engine inspects the binary structure in memory, identifying whether C2PA Content Credentials, IPTC DigitalSourceType tags, or Photoshop Generative tags are present.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 3</span>
          <h3>Execute In-Browser Sanitization</h3>
          <p>
            The tool draws the image to a clean canvas context, stripping all metadata boxes and neutralizing algorithmic watermarks without sending a single byte to an external server.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 4</span>
          <h3>Download Clean Images and Post</h3>
          <p>
            Save the sanitized files to your device. When uploading to Instagram, verify that the manual AI label setting is switched off. Your post publishes cleanly without the AI badge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- In-Depth Sub-Search Sections Matching Keywords -->
  <section class="section bg-alt">
    <div class="container measure-readable">
      <h2>Understanding Social Media AI Labeling Rules in 2026</h2>

      <div class="subsearch-block">
        <h3>How to Remove AI Info from Instagram Post</h3>
        <p>
          Instagram scans images at the time of upload. If the file contains an Adobe Firefly assertion, DALL-E header, or C2PA manifest, Instagram automatically applies the "AI Info" pill below the username or above the caption. You cannot toggle this pill off inside the Instagram app once the metadata is detected. To prevent the pill from appearing, you must sanitize the file before uploading by removing the C2PA JUMBF segment.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>How to Remove AI Info from Instagram Story</h3>
        <p>
          Instagram Stories also run uploaded media through the provenance scanner. If a Story slide contains an AI flag, an "AI info" icon appears in the top header next to your account handle. Running your Story graphics, video stills, and edited photographs through RemoveSynth clears the provenance tags, allowing clean Story uploads.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>Why Did Instagram Add AI Info to My Real Photo?</h3>
        <p>
          Photographers frequently encounter false positives on authentic photographs. When you use Adobe Photoshop "Generative Remove" to clean up dust spots, Lightroom "Lens Blur" with neural depth estimation, or Samsung "Object Eraser", the software tags the entire file with <code>compositeWithTrainedAlgorithmicMedia</code>. Meta algorithms do not evaluate the proportion of AI used; even a 1 percent spot edit triggers the label across the entire 100 percent real photograph.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>C2PA Manifest and JUMBF Box Removal Explained</h3>
        <p>
          The Coalition for Content Provenance and Authenticity (C2PA) embeds cryptographically signed JSON trees into ISO/IEC 19566-5 JUMBF boxes inside JPEG APP11 segments. These boxes contain certificates, parent asset hashes, and signing authorities. RemoveSynth decouples the visual pixel data from the container headers, discarding all JUMBF boxes while preserving the visual content.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>IPTC DigitalSourceType Flags and How They Work</h3>
        <p>
          The International Press Telecommunications Council (IPTC) established standardized digital source type codes for AI provenance. Common codes include <code>trainedAlgorithmicMedia</code> and <code>compositeSynthetic</code>. When Instagram encounters these codes in XMP headers, its policy engine treats the media as synthetic. Sanitizing the file clears the entire XMP tree, restoring clean status.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>Does Screenshotting Remove AI Info on Instagram?</h3>
        <p>
          Taking a screenshot of an image discards file metadata, but it introduces major drawbacks: it downscales your image to the phone screen resolution, alters the aspect ratio, compresses fine details, and can trigger moire patterns. RemoveSynth provides lossless provenance stripping, retaining the full native resolution and color fidelity of your original camera capture.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>Facebook and Threads AI Label Detection Rules</h3>
        <p>
          Because Facebook, Instagram, and Threads share Meta unified ingestion infrastructure, the exact same C2PA detection pipeline applies across all three platforms. Uploading an unsanitized photo to Facebook Marketplace, business pages, or Threads posts triggers identical automated AI disclosures. Using RemoveSynth ensures consistency across all Meta platforms.
        </p>
      </div>
    </div>
  </section>

  <!-- Accuracy & Benchmark Testing -->
  <section class="section">
    <div class="container">
      <h2>Sanitizer Accuracy and Platform Verification Benchmarks</h2>
      <p class="section-lead">
        We regularly test RemoveSynth against real-world social media ingestion endpoints using photographs edited with industry-standard generative software.
      </p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Source Tool &amp; Operation</th>
              <th>Embedded AI Flag</th>
              <th>Instagram Raw Upload</th>
              <th>After RemoveSynth Sanitization</th>
              <th>Visual Fidelity</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Adobe Photoshop Generative Fill</td>
              <td>C2PA Manifest + IPTC composite</td>
              <td>AI Info Pill Enforced</td>
              <td>Clean (No Label Triggered)</td>
              <td>100% Identical Resolution</td>
            </tr>
            <tr>
              <td>Adobe Lightroom Lens Blur (Neural)</td>
              <td>XMP Generative History</td>
              <td>AI Info Pill Enforced</td>
              <td>Clean (No Label Triggered)</td>
              <td>100% Identical Resolution</td>
            </tr>
            <tr>
              <td>Google Gemini / Imagen 3 (Nano Banana)</td>
              <td>SynthID + C2PA Manifest</td>
              <td>Made with AI Tag Enforced</td>
              <td>Clean (No Label Triggered)</td>
              <td>High Fidelity (94% Canvas)</td>
            </tr>
            <tr>
              <td>Midjourney v6 Export</td>
              <td>PNG tEXt Prompt Headers</td>
              <td>AI Label Enforced</td>
              <td>Clean (No Label Triggered)</td>
              <td>Native Pixel Dimensions</td>
            </tr>
            <tr>
              <td>Samsung / Pixel Object Eraser</td>
              <td>Google Generative Metadata</td>
              <td>AI Info Pill Enforced</td>
              <td>Clean (No Label Triggered)</td>
              <td>Full Resolution Maintained</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Comparison Section: Why This Tool Is Different -->
  <section class="section bg-alt">
    <div class="container">
      <h2>Why RemoveSynth Is Different: Feature Comparison</h2>
      <p class="section-lead">
        Compare our client-side provenance sanitizer with conventional methods like screenshotting, desktop EXIF tools, and cloud upload services.
      </p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Feature / Metric</th>
              <th>RemoveSynth</th>
              <th>Screenshot Method</th>
              <th>Standard EXIF Stripper</th>
              <th>Cloud Upload Converter</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>C2PA Manifest Stripping</td>
              <td>Yes (Full Purge)</td>
              <td>Yes (Side-effect)</td>
              <td>Inconsistent</td>
              <td>Varies by Server</td>
            </tr>
            <tr>
              <td>IPTC DigitalSourceType Removal</td>
              <td>Yes (Complete)</td>
              <td>Yes</td>
              <td>Rarely Clears XMP</td>
              <td>Partial</td>
            </tr>
            <tr>
              <td>Native Resolution Maintained</td>
              <td>Yes (Up to 8K+)</td>
              <td>No (Screen Capped)</td>
              <td>Yes</td>
              <td>Often Compressed</td>
            </tr>
            <tr>
              <td>Server Upload Required</td>
              <td>Never (100% Local)</td>
              <td>Never</td>
              <td>Never</td>
              <td>Always Required</td>
            </tr>
            <tr>
              <td>Batch Processing Capacity</td>
              <td>Up to 30 Photos</td>
              <td>Manual One-by-One</td>
              <td>Varies</td>
              <td>Queue Throttled</td>
            </tr>
            <tr>
              <td>Pricing and Registration</td>
              <td>100% Free, No Account</td>
              <td>Free</td>
              <td>Varies</td>
              <td>Freemium / Paywalls</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Primary Sources & Standards Links -->
      <div class="sources-card">
        <h3>Primary Specifications and Standards Referenced</h3>
        <ul>
          <li>
            <a href="https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html" target="_blank" rel="noopener noreferrer">
              C2PA Technical Specification 2.1 - Coalition for Content Provenance and Authenticity
            </a>
          </li>
          <li>
            <a href="https://www.iptc.org/std/photometadata/specification/IPTC-PhotoMetadata#digital-source-type" target="_blank" rel="noopener noreferrer">
              IPTC Photo Metadata Standard - DigitalSourceType Code Specification
            </a>
          </li>
          <li>
