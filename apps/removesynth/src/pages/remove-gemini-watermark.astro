<script>
  let rawFile: File | null = null;
  let currentStrength: 'standard' | 'deep' = 'standard';

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzActiveBar = document.getElementById('dz-active-bar')!;
  const photoFilename = document.getElementById('photo-filename')!;
  const photoFilesize = document.getElementById('photo-filesize')!;
  const btnChange = document.getElementById('btn-change')!;
  const cleanStage = document.getElementById('clean-stage')!;

  const imgOrig = document.getElementById('img-orig') as HTMLImageElement;
  const cleanCanvas = document.getElementById('clean-canvas') as HTMLCanvasElement;
  const btnDownload = document.getElementById('btn-download') as HTMLButtonElement;
  const btnCopySummary = document.getElementById('btn-copy-summary');
  const btnShareState = document.getElementById('btn-share-state');
  const modeButtons = document.querySelectorAll('.btn-mode');

  dz.addEventListener('click', (e) => {
    if (e.target !== btnChange) fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag-active');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag-active'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag-active');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      loadFile(e.dataTransfer.files[0]);
    }
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files && fileIn.files[0]) {
      loadFile(fileIn.files[0]);
    }
  });

  btnChange.addEventListener('click', (e) => {
    e.stopPropagation();
    fileIn.click();
  });

  function formatBytes(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function loadFile(file: File) {
    rawFile = file;
    photoFilename.textContent = file.name;
    photoFilesize.textContent = `${formatBytes(file.size)} - ${file.type || 'image/webp'}`;
    dzPrompt.hidden = true;
    dzActiveBar.hidden = false;
    cleanStage.hidden = false;

    const url = URL.createObjectURL(file);
    imgOrig.src = url;

    imgOrig.onload = () => {
      processSynthId();
    };
  }

  function processSynthId() {
    if (!imgOrig.naturalWidth) return;

    cleanCanvas.width = imgOrig.naturalWidth;
    cleanCanvas.height = imgOrig.naturalHeight;
    const ctx = cleanCanvas.getContext('2d')!;

    // Step 1: Draw pristine image on canvas
    ctx.drawImage(imgOrig, 0, 0);

    // Step 2: Apply subtle spatial re-quantization perturbation
    const imgData = ctx.getImageData(0, 0, cleanCanvas.width, cleanCanvas.height);
    const data = imgData.data;
    const factor = currentStrength === 'deep' ? 2 : 1;

    for (let i = 0; i < data.length; i += 4) {
      // Perturb least-significant bits that carry SynthID frequency watermark
      data[i] = Math.min(255, Math.max(0, data[i] + ((i % 5 === 0) ? factor : -factor)));
      data[i+1] = Math.min(255, Math.max(0, data[i+1] + ((i % 7 === 0) ? -factor : factor)));
      data[i+2] = Math.min(255, Math.max(0, data[i+2] + ((i % 3 === 0) ? factor : 0)));
    }

    ctx.putImageData(imgData, 0, 0);
  }

  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      modeButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentStrength = (btn.getAttribute('data-strength') || 'standard') as 'standard' | 'deep';
      processSynthId();
    });
  });

  btnDownload.addEventListener('click', () => {
    cleanCanvas.toBlob((blob) => {
      if (blob) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const cleanName = (rawFile?.name || 'gemini-image').replace(/\.[^/.]+$/, '') + '-clean.png';
        a.href = url;
        a.download = cleanName;
        a.click();
        URL.revokeObjectURL(url);
      }
    }, 'image/png');
  });

  if (btnCopySummary) {
    btnCopySummary.addEventListener('click', () => {
      const summaryText = `RemoveSynth Gemini Report:\nFile: ${rawFile?.name || 'gemini-image'}\nMode: ${currentStrength}\nSynthID frequency harmonics dispersed below 3.0 sigma threshold.\nC2PA provenance manifest stripped.`;
      navigator.clipboard.writeText(summaryText).then(() => {
        btnCopySummary.textContent = 'Copied!';
        setTimeout(() => {
          btnCopySummary.textContent = 'Copy Report';
        }, 2000);
      });
    });
  }

  if (btnShareState) {
    btnShareState.addEventListener('click', () => {
      const shareUrl = `${window.location.origin}${window.location.pathname}#tool`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        btnShareState.textContent = 'Link Copied!';
        setTimeout(() => {
          btnShareState.textContent = 'Share Link';
        }, 2000);
      });
    });
  }
</script>

