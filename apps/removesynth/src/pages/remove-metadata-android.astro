import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';

const title = 'Remove Photo Metadata on Android: Wipe GPS & EXIF Free';
const description =
  'Wipe GPS location tags, camera details, and EXIF metadata from Android photos. Works in mobile Chrome with zero app installation and zero server uploads.';

const faqs: FaqItem[] = [
  {
    q: 'Can I remove location from Android photos without installing apps from Play Store?',
    a: 'Yes. RemoveSynth works directly in Chrome or Samsung Internet on Android. Select photos from your Gallery or Files app, and our client-side engine wipes all EXIF and GPS markers in seconds.',
  },
  {
    q: 'How do I turn off photo location tags in Samsung Galaxy Camera?',
    a: 'Open the Samsung Camera app, tap the Settings gear icon in the top left corner, scroll down to "Location tags", and toggle it off.',
  },
  {
    q: 'How do I turn off location tags on Google Pixel?',
    a: 'Open the Pixel Camera app, tap Settings (bottom left or top left), tap More settings, and turn off "Save location".',
  },
  {
    q: 'Are photos uploaded to your servers?',
    a: 'No. The entire sanitization process happens inside your phone’s browser sandbox.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Remove Photo Metadata on Android',
    url: 'https://removesynth.com/remove-metadata-android/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Android',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Remove Metadata on Android', url: '/remove-metadata-android/' },
  ]),
];
