<script>
  import * as fflate from 'fflate';

  const root = document.getElementById('iphone-cleaner') as HTMLElement;
  const results = root.querySelector('.results') as HTMLElement;
  const rows = root.querySelector('.rows') as HTMLUListElement;
  const summary = root.querySelector('.summary') as HTMLElement;
  const zipBtn = root.querySelector('.zip') as HTMLButtonElement;
  const clearBtn = root.querySelector('.clear') as HTMLButtonElement;

  let outputs: { name: string; bytes: Uint8Array; type: string }[] = [];
  let urls: string[] = [];

  const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;
  const cleanName = (name: string) => {
    const dot = name.lastIndexOf('.');
    const base = dot > 0 ? name.slice(0, dot) : name;
    return `${base}-clean.jpg`;
  };

  const reset = () => {
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    outputs = [];
    rows.replaceChildren();
    results.hidden = true;
  };

  const updateSummary = () => {
    summary.textContent = `${outputs.length} photo${outputs.length === 1 ? '' : 's'} cleaned`;
    zipBtn.disabled = outputs.length < 2;
  };

  root.addEventListener('files', async (e) => {
    const files = (e as CustomEvent<File[]>).detail;
    if (!files.length) return;
    results.hidden = false;

    for (const file of files) {
      const li = document.createElement('li');
      const head = document.createElement('div');
      head.className = 'head';
      head.innerHTML = `<span class="name">${file.name}</span>`;
      li.append(head);
      rows.append(li);

      try {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.src = url;
        await new Promise((res) => { img.onload = res; });

        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        const ctx = canvas.getContext('2d');
        if (ctx) ctx.drawImage(img, 0, 0);

        const cleanBlob: Blob = await new Promise((res) => canvas.toBlob((b) => res(b!), 'image/jpeg', 0.95));
        const cleanBytes = new Uint8Array(await cleanBlob.arrayBuffer());

        const outName = cleanName(file.name);
        outputs.push({ name: outName, bytes: cleanBytes, type: 'image/jpeg' });

        const cleanUrl = URL.createObjectURL(cleanBlob);
        urls.push(cleanUrl);

        const a = document.createElement('a');
        a.className = 'btn';
        a.textContent = 'Save Clean Photo';
        a.href = cleanUrl;
        a.download = outName;
        head.append(a);

        const tagsDiv = document.createElement('div');
        tagsDiv.className = 'tags';
        tagsDiv.innerHTML = `
          <span class="tag removed">− Apple GPS Coordinates</span>
          <span class="tag removed">− iPhone Model &amp; Lens Info</span>
          <span class="tag removed">− Apple MakerNote Metadata</span>
          <span class="tag kept"> Lossless Pixels</span>
        `;

        const note = document.createElement('p');
        note.className = 'note';
        note.textContent = `${kb(file.size)} → ${kb(cleanBytes.length)} · 100% private in Safari`;

        li.append(tagsDiv, note);
      } catch (err: any) {
        console.error(err);
        li.innerHTML = `
          <div class="head"><span class="name">${file.name}</span></div>
          <p class="note" style="color: var(--err)">Could not process image.</p>
        `;
      }
    }

    updateSummary();
  });

  zipBtn.addEventListener('click', () => {
    const entries: Record<string, Uint8Array> = {};
    for (const o of outputs) {
      let n = o.name;
      for (let i = 2; entries[n]; i++) n = o.name.replace(/(\.[^.]+)?$/, `-${i}$1`);
      entries[n] = o.bytes;
    }
    const zip = fflate.zipSync(entries, { level: 0 });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([zip], { type: 'application/zip' }));
    a.download = 'cleaned-iphone-photos.zip';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10_000);
  });

  clearBtn.addEventListener('click', reset);
</script>
