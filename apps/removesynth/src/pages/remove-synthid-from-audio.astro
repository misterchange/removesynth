<script>
  const btnShare = document.getElementById('btn-share-state');
  const btnCopy = document.getElementById('btn-copy-summary');
  const toast = document.getElementById('utility-toast');

  function showToast(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.hidden = false;
    setTimeout(() => {
      toast.hidden = true;
    }, 2500);
  }

  btnShare?.addEventListener('click', async () => {
    const cleanUrl = `${window.location.origin}${window.location.pathname}#synthid-audio-tool`;
    try {
      await navigator.clipboard.writeText(cleanUrl);
      showToast('Tool link copied to clipboard');
    } catch {
      showToast('Link: ' + cleanUrl);
    }
  });

  btnCopy?.addEventListener('click', async () => {
    const summary = 'Sanitized with RemoveSynth: Audio SynthID frequency watermarks neutralized, ID3 metadata cleared, 100% private in-browser processing.';
    try {
      await navigator.clipboard.writeText(summary);
      showToast('Summary copied to clipboard');
    } catch {
      showToast('Verification copied');
    }
  });
</script>

