---
import Base from '../layouts/Base.astro';
import Uploader from '../components/Uploader.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { SITE } from '../site';

const title = 'Remove SynthID: Free SynthID Remover for AI Images';
const description =
  'Remove SynthID watermarks from Gemini and Imagen images online. Free in-browser SynthID remover for PNG, JPG and WebP with zero quality loss and full privacy.';

const faqs = [
  {
    q: 'How do I remove SynthID from Gemini images?',
    a: 'Upload your Gemini or Imagen image to the tool above. RemoveSynth neutralizes the imperceptible frequency perturbations across the pixel grid client-side in your browser, allowing you to download an unwatermarked file in seconds.',
  },
  {
    q: 'Does cropping, resizing, or screenshotting an image remove SynthID?',
    a: 'No. DeepMind designed SynthID specifically to survive standard geometric manipulations, including aggressive cropping, aspect ratio resizing, JPEG compression, and screenshotting. Only frequency domain dispersion neutralizes the detector signal.',
  },
  {
    q: 'Will removing SynthID degrade the image resolution or sharpness?',
    a: 'No. The image resolution, color palette, and visual fidelity are preserved at 100 percent original quality. The neutralization operates only on subtle imperceptible frequency variations.',
  },
  {
    q: 'What is the difference between SynthID and C2PA Content Credentials?',
    a: 'C2PA is a file-level metadata manifest containing cryptographic signatures of provenance. SynthID is a steganographic pixel-level watermark embedded directly into frequency coefficients of the image data. RemoveSynth cleans both.',
  },
  {
    q: 'Can social networks like Instagram detect SynthID in uploads?',
    a: 'Social media platforms run automated ingestion scanners that check both C2PA manifests and pixel watermarks to apply AI Info labels. Neutralizing SynthID and stripping metadata prevents automated tagging.',
  },
  {
    q: 'Which image file formats are supported by RemoveSynth?',
    a: 'RemoveSynth supports PNG, JPG, JPEG, and WebP images up to 50 MB with full client-side processing.',
  },
  {
    q: 'Is my image uploaded to any server or cloud database?',
    a: 'No. All processing executes 100 percent locally in your web browser memory using client-side Canvas and WebAssembly. Your files never leave your device.',
  },
  {
    q: 'What is the viral Nano Banana watermark on Gemini pictures?',
    a: 'Nano Banana is an informal community nickname for the invisible SynthID frequency pattern embedded by Google Gemini and Imagen models, which causes automated platforms to tag files as AI generated.',
  },
];

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}/remove-synthid-from-images/#webpage`,
      'url': `${SITE.url}/remove-synthid-from-images/`,
      'name': title,
      'description': description,
      'isPartOf': {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        'name': SITE.name,
        'url': SITE.url,
      },
      'breadcrumb': {
        '@id': `${SITE.url}/remove-synthid-from-images/#breadcrumb`,
      },
      'mainEntity': {
        '@id': `${SITE.url}/remove-synthid-from-images/#app`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/remove-synthid-from-images/#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `${SITE.url}/`,
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Tools',
          'item': `${SITE.url}/tools/`,
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': 'Remove SynthID from Images',
          'item': `${SITE.url}/remove-synthid-from-images/`,
        },
      ],
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      '@id': `${SITE.url}/remove-synthid-from-images/#app`,
      'name': 'RemoveSynth In-Browser SynthID Remover',
      'url': `${SITE.url}/remove-synthid-from-images/`,
      'applicationCategory': 'MultimediaApplication',
      'operatingSystem': 'Web (Any browser)',
      'isAccessibleForFree': true,
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
      },
      'featureList': [
        'Client-side SynthID frequency dispersion',
        'Full resolution PNG, JPG, and WebP export',
        'C2PA and IPTC metadata stripping',
        'Zero server uploads with complete privacy',
        'State sharing and instant copyable summaries',
      ],
    },
    {
      '@type': 'HowTo',
      '@id': `${SITE.url}/remove-synthid-from-images/#howto`,
      'name': 'How to Remove SynthID Watermarks from AI Images',
      'description': 'Step-by-step process to neutralize Google DeepMind SynthID frequency watermarks from Gemini and Imagen pictures.',
      'step': [
        {
          '@type': 'HowToStep',
          'position': 1,
          'name': 'Select your Gemini or Imagen AI image',
          'text': 'Drag and drop your AI-generated PNG, JPG, or WebP into the client-side uploader above.',
        },
        {
          '@type': 'HowToStep',
          'position': 2,
          'name': 'In-browser frequency domain dispersion',
          'text': 'The browser decodes pixel buffers and applies targeted frequency dispersion to break the SynthID statistical correlation.',
        },
        {
          '@type': 'HowToStep',
          'position': 3,
          'name': 'Compare before and after inspection',
          'text': 'Inspect the visual preview to verify 100 percent fidelity retention across color, texture, and edge sharpness.',
        },
        {
          '@type': 'HowToStep',
          'position': 4,
          'name': 'Download sanitized image file',
          'text': 'Save your clean image without embedded watermarks, ready for publishing without AI Info flags.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/remove-synthid-from-images/#faq`,
      'mainEntity': faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': `<p>${f.a}</p>`,
        },
      })),
    },
  ],
};
---

<Base title={title} description={description} schema={[jsonLdGraph]}>
  <!-- Anchor Section: Tool Above the Fold -->
  <section class="hero" id="synthid-tool">
    <div class="container">
      <span class="eyebrow">Client-Side Frequency Sanitizer - 100% In-Browser Privacy - No Account Required</span>
      <h1>Remove SynthID from Images with Free In-Browser SynthID Remover</h1>
      
      <!-- Interactive Tool Stage -->
      <div class="tool-wrapper">
        <Uploader kinds={["image"]} />
        
        <!-- Utility Toolbar: State Sharing & Instant Summary -->
        <div class="tool-utility-bar">
          <div class="utility-chip">
            <span class="status-indicator"></span>
            <span class="utility-text">Engine: In-Memory Web Canvas 2D</span>
          </div>
          <div class="utility-actions">
            <button type="button" class="btn-util" id="btn-copy-summary" title="Copy verification summary">
              Copy Summary
            </button>
            <button type="button" class="btn-util" id="btn-share-state" title="Copy shareable link">
              Share Tool Link
            </button>
          </div>
        </div>
        <div class="utility-toast" id="utility-toast" hidden>Link copied to clipboard</div>
