        <line x1="80" y1="280" x2="720" y2="280" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
        <line x1="80" y1="320" x2="720" y2="320" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
        
        <!-- Y-Axis Labels -->
        <text x="65" y="45" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="end">1.00</text>
        <text x="65" y="105" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="end">0.80</text>
        <text x="65" y="165" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="end">0.60</text>
        <text x="65" y="225" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="end">0.40</text>
        <text x="65" y="285" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="end">0.20</text>
        <text x="65" y="325" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="end">0.00</text>
        
        <!-- X-Axis Labels -->
        <text x="120" y="345" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="middle">DC / Low Freq</text>
        <text x="270" y="345" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="middle">Mid-Low</text>
        <text x="430" y="345" fill="rgba(255,255,255,0.6)" font-size="11" text-anchor="middle">Mid-High Freq</text>
