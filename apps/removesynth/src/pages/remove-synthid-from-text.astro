          <text x="630" y="95" fill="#fca5a5" font-size="12" text-anchor="middle">Token 4: "the tapestry of"</text>

          <line x1="40" y1="135" x2="740" y2="135" stroke="#334155" stroke-dasharray="4" />

          <!-- Sanitized Chain -->
          <text x="40" y="165" fill="#34d399" font-size="13" font-weight="600">REMOVESYNTH RESTRUCTURED SYNTAX (Z = 0.89 sigma)</text>
          
