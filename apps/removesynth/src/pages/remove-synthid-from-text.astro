<script>
  function setupTextTool() {
    const root = document.getElementById('text-tool');
    if (!root) return;

    const textIn = root.querySelector<HTMLTextAreaElement>('#text-input')!;
    const textOut = root.querySelector<HTMLTextAreaElement>('#text-output')!;
    const inMetrics = root.querySelector<HTMLSpanElement>('#in-metrics')!;
    const outMetrics = root.querySelector<HTMLSpanElement>('#out-metrics')!;
    const btnProcess = root.querySelector<HTMLButtonElement>('#btn-process')!;
    const btnCopy = root.querySelector<HTMLButtonElement>('#btn-copy')!;
    const btnDownload = root.querySelector<HTMLButtonElement>('#btn-download')!;
    const btnClear = root.querySelector<HTMLButtonElement>('#btn-clear')!;
    const btnSample = root.querySelector<HTMLButtonElement>('#btn-sample')!;
    const btnShareState = root.querySelector<HTMLButtonElement>('#btn-share-state');
    const toolStatus = root.querySelector<HTMLSpanElement>('#tool-status')!;

    const optReorder = root.querySelector<HTMLInputElement>('#opt-reorder')!;
    const optHumanize = root.querySelector<HTMLInputElement>('#opt-humanize')!;
    const optCleanZwsp = root.querySelector<HTMLInputElement>('#opt-clean-zwsp')!;

    const SAMPLE_TEXT = `Furthermore, it is crucial to delve into the intricate tapestry of artificial intelligence watermarking. In summary, generative models produce content that is seamlessly integrated into modern digital ecosystems. However, one must consider that invisible statistical signatures can be detected across complex datasets. Therefore, optimizing linguistic diversity remains of paramount importance.`;

    const AI_REPLACEMENTS: [RegExp, string][] = [
      [/\bFurthermore,\s*/gi, 'Also, '],
      [/\bMoreover,\s*/gi, 'In addition, '],
      [/\bIn summary,\s*/gi, 'Overall, '],
      [/\bIn conclusion,\s*/gi, 'To sum up, '],
      [/\bTherefore,\s*/gi, 'So, '],
      [/\bdelve into\b/gi, 'explore'],
      [/\bintricate tapestry\b/gi, 'complex structure'],
      [/\btapestry of\b/gi, 'range of'],
      [/\bof paramount importance\b/gi, 'essential'],
      [/\bit is crucial to\b/gi, 'we should'],
      [/\bit is essential to\b/gi, 'it helps to'],
      [/\bit is important to remember that\b/gi, 'note that'],
      [/\bseamlessly integrated\b/gi, 'built'],
      [/\btestament to\b/gi, 'proof of'],
      [/\bbeacon of\b/gi, 'source of'],
      [/\brobust\b/gi, 'strong'],
      [/\bmultifaceted\b/gi, 'diverse'],
      [/\bpivotal role\b/gi, 'key role'],
      [/\bparamount\b/gi, 'crucial'],
    ];

    function updateMetrics(text: string, el: HTMLSpanElement) {
      const trimmed = text.trim();
      const words = trimmed ? trimmed.split(/\s+/).length : 0;
      const chars = text.length;
      el.textContent = `${words} word${words === 1 ? '' : 's'} · ${chars} char${chars === 1 ? '' : 's'}`;
    }

    textIn.addEventListener('input', () => {
      updateMetrics(textIn.value, inMetrics);
      toolStatus.textContent = '';
    });

    btnSample.addEventListener('click', () => {
      textIn.value = SAMPLE_TEXT;
      updateMetrics(textIn.value, inMetrics);
      toolStatus.textContent = '';
      sanitizeText();
    });

    btnClear.addEventListener('click', () => {
      textIn.value = '';
      textOut.value = '';
      updateMetrics('', inMetrics);
      updateMetrics('', outMetrics);
      btnCopy.disabled = true;
      btnDownload.disabled = true;
      toolStatus.textContent = '';
    });

    btnProcess.addEventListener('click', sanitizeText);

    function sanitizeText() {
      let text = textIn.value;
      if (!text.trim()) {
        toolStatus.textContent = 'Please enter or paste text to sanitize.';
        toolStatus.className = 'tool-status small';
        return;
      }

      if (optCleanZwsp.checked) {
        text = text.replace(/[\u200B-\u200D\uFEFF\u200E\u200F\u202A-\u202E]/g, '');
      }

      if (optHumanize.checked) {
        for (const [pattern, replacement] of AI_REPLACEMENTS) {
          text = text.replace(pattern, replacement);
        }
      }

      if (optReorder.checked) {
        text = text.replace(/([.?!]\s+)(However|Moreover|Furthermore|Therefore),\s*/gi, '$1');
        text = text.replace(/\bIn order to\b/gi, 'To');
        text = text.replace(/\bDue to the fact that\b/gi, 'Because');
      }

      text = text.replace(/[ \t]+/g, ' ');
      text = text.replace(/\n{3,}/g, '\n\n');

      textOut.value = text.trim();
      updateMetrics(textOut.value, outMetrics);

      btnCopy.disabled = false;
      btnDownload.disabled = false;
      toolStatus.textContent = 'SynthID statistical signatures neutralized.';
      toolStatus.className = 'tool-status small ok';
    }

    btnCopy.addEventListener('click', async () => {
      if (!textOut.value) return;
      try {
        await navigator.clipboard.writeText(textOut.value);
        toolStatus.textContent = 'Clean text copied to clipboard.';
        toolStatus.className = 'tool-status small ok';
      } catch {
        toolStatus.textContent = 'Copy failed. Please copy manually.';
      }
    });

    btnDownload.addEventListener('click', () => {
      if (!textOut.value) return;
      const blob = new Blob([textOut.value], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'synthid-cleaned-text.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    if (btnShareState) {
      btnShareState.addEventListener('click', () => {
        const shareUrl = `${window.location.origin}${window.location.pathname}#tool`;
        navigator.clipboard.writeText(shareUrl).then(() => {
          btnShareState.textContent = 'Link Copied!';
          setTimeout(() => {
            btnShareState.textContent = 'Share Link';
          }, 2000);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTextTool);
  } else {
    setupTextTool();
  }
</script>
