              ></textarea>
            </div>

            <div class="tool-col">
              <div class="col-header">
                <span class="col-title">Sanitized Output (Clean)</span>
                <span class="badge badge-accent" id="out-metrics">0 words · 0 chars</span>
              </div>
              <textarea
