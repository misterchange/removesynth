          <!-- Flagged Chain -->
          <text x="40" y="55" fill="#f87171" font-size="13" font-weight="600">CONNECTED SYNTHID N-GRAM HASH CHAIN (Z = 4.12 sigma)</text>
          
          <rect x="40" y="70" width="130" height="40" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="105" y="95" fill="#fca5a5" font-size="12" text-anchor="middle">Token 1: "Furthermore"</text>
          
          <line x1="170" y1="90" x2="200" y2="90" stroke="#ef4444" stroke-width="2" marker-end="url(#arrow)" />
          
          <rect x="200" y="70" width="140" height="40" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="270" y="95" fill="#fca5a5" font-size="12" text-anchor="middle">Token 2: "it is crucial"</text>
          
          <line x1="340" y1="90" x2="370" y2="90" stroke="#ef4444" stroke-width="2" />
          
          <rect x="370" y="70" width="140" height="40" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="440" y="95" fill="#fca5a5" font-size="12" text-anchor="middle">Token 3: "to delve into"</text>

          <line x1="510" y1="90" x2="540" y2="90" stroke="#ef4444" stroke-width="2" />

