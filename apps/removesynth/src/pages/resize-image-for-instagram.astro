  }
  #preview-canvas {
    display: block;
    max-width: 100%;
    max-height: 380px;
    margin: 0 auto;
  }
  .file-summary {
    margin-top: 12px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text);
  }
  .section-label {
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin: 22px 0 10px;
  }
  .presets-grid,
  .fit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
  }
  .preset-card,
  .fit-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: all 0.15s ease;
  }
  .preset-card strong,
  .fit-card strong {
    font-size: 0.92rem;
  }
