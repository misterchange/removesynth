    color: var(--text);
    border-color: var(--border-strong);
  }
</style>

<script>
  let rawImg: HTMLImageElement | null = null;
  let rawFile: File | null = null;
  let targetW = 1080;
  let targetH = 1350;
  let fitMode = 'blur';

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzPreview = document.getElementById('dz-preview')!;
  const previewCanvas = document.getElementById('preview-canvas') as HTMLCanvasElement;
  const fileSummary = document.getElementById('file-summary')!;
  const btnChange = document.getElementById('btn-change')!;
  const igControls = document.getElementById('ig-controls')!;
  const btnDownload = document.getElementById('btn-download')!;
  const dlDim = document.getElementById('dl-dim')!;
  const toolStatus = document.getElementById('tool-status')!;

  dz.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#btn-change')) return;
    if (rawImg) return;
    fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag');
    if (e.dataTransfer?.files?.[0]) handleFile(e.dataTransfer.files[0]);
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files?.[0]) handleFile(fileIn.files[0]);
  });

  btnChange.addEventListener('click', () => {
    rawImg = null;
    rawFile = null;
    fileIn.value = '';
    dzPrompt.hidden = false;
    dzPreview.hidden = true;
    igControls.hidden = true;
  });

  function handleFile(file: File) {
    if (!file.type.startsWith('image/')) {
      alert('Please upload an image file (JPG, PNG, WebP).');
      return;
    }
    rawFile = file;
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      rawImg = img;
      dzPrompt.hidden = true;
      dzPreview.hidden = false;
      igControls.hidden = false;
      fileSummary.textContent = `${file.name} · Original: ${img.naturalWidth} × ${img.naturalHeight} px (${(file.size / 1024).toFixed(1)} KB)`;
      renderPreview();
    };
    img.src = url;
  }

  // Presets
  document.querySelectorAll('.preset-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-card').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      targetW = parseInt(btn.getAttribute('data-w') || '1080', 10);
      targetH = parseInt(btn.getAttribute('data-h') || '1350', 10);
      dlDim.textContent = `${targetW}×${targetH}`;
      renderPreview();
    });
  });

  // Fit modes
  document.querySelectorAll('.fit-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fit-card').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      fitMode = btn.getAttribute('data-mode') || 'blur';
      renderPreview();
    });
  });

  function renderPreview() {
    if (!rawImg) return;
    previewCanvas.width = targetW;
    previewCanvas.height = targetH;
    const ctx = previewCanvas.getContext('2d');
    if (!ctx) return;

    ctx.clearRect(0, 0, targetW, targetH);
    const sw = rawImg.naturalWidth;
    const sh = rawImg.naturalHeight;

    if (fitMode === 'cover') {
      const scale = Math.max(targetW / sw, targetH / sh);
      const dw = sw * scale;
      const dh = sh * scale;
      const dx = (targetW - dw) / 2;
      const dy = (targetH - dh) / 2;
      ctx.drawImage(rawImg, dx, dy, dw, dh);
    } else if (fitMode === 'white' || fitMode === 'black') {
      ctx.fillStyle = fitMode === 'white' ? '#ffffff' : '#000000';
      ctx.fillRect(0, 0, targetW, targetH);
      const scale = Math.min(targetW / sw, targetH / sh) * 0.94; // subtle padding
      const dw = sw * scale;
      const dh = sh * scale;
      const dx = (targetW - dw) / 2;
      const dy = (targetH - dh) / 2;
      ctx.drawImage(rawImg, dx, dy, dw, dh);
    } else {
      // Smart Blur Fill
      ctx.save();
      ctx.filter = 'blur(28px) brightness(0.7)';
      const bgScale = Math.max(targetW / sw, targetH / sh) * 1.1;
      const bgW = sw * bgScale;
      const bgH = sh * bgScale;
      const bgX = (targetW - bgW) / 2;
      const bgY = (targetH - bgH) / 2;
      ctx.drawImage(rawImg, bgX, bgY, bgW, bgH);
      ctx.restore();

      const scale = Math.min(targetW / sw, targetH / sh);
      const dw = sw * scale;
      const dh = sh * scale;
      const dx = (targetW - dw) / 2;
      const dy = (targetH - dh) / 2;
      ctx.save();
      ctx.shadowColor = 'rgba(0, 0, 0, 0.4)';
      ctx.shadowBlur = 20;
      ctx.drawImage(rawImg, dx, dy, dw, dh);
      ctx.restore();
    }
  }

  // Download
  btnDownload.addEventListener('click', () => {
    if (!previewCanvas) return;
    toolStatus.textContent = 'Exporting Instagram-ready image...';
    previewCanvas.toBlob((blob) => {
      if (!blob) return;
      const dlUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const baseName = (rawFile?.name || 'instagram_photo').replace(/\.[^/.]+$/, '');
      a.href = dlUrl;
      a.download = `${baseName}_ig_${targetW}x${targetH}.jpg`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(dlUrl), 1000);
      toolStatus.textContent = `Downloaded ${targetW}×${targetH} JPG!`;
    }, 'image/jpeg', 0.95);
  });
</script>
