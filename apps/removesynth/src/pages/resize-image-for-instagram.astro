    <Faq items={faqs} heading="Frequently Asked Questions About Instagram Photo Resizing" />
  </article>
</Base>

<style>
  .tool-stage {
    position: relative;
    max-width: 860px;
    margin: 28px auto 0;
  }
  .ig-tool {
    max-width: 860px;
    margin: 0 auto;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-lg);
    text-align: left;
  }
  .ig-dropzone {
    border: 2px dashed var(--border-strong);
    border-radius: 18px;
    padding: 32px 20px;
    text-align: center;
    background: linear-gradient(180deg, var(--accent-faint), transparent);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .ig-dropzone:hover,
  .ig-dropzone.drag {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .dz-prompt svg {
