</style>

<script>
  const root = document.getElementById('resizer-drop') as HTMLElement;
  const results = root.querySelector('.results') as HTMLElement;
  const previewImg = root.querySelector('#preview-img') as HTMLImageElement;
  const origDimEl = root.querySelector('#orig-dim') as HTMLElement;
  const origSizeEl = root.querySelector('#orig-size') as HTMLElement;
  const widthInput = root.querySelector('#width-input') as HTMLInputElement;
  const heightInput = root.querySelector('#height-input') as HTMLInputElement;
  const lockRatio = root.querySelector('#lock-ratio') as HTMLInputElement;
  const targetStat = root.querySelector('#target-stat') as HTMLElement;
  const formatSelect = root.querySelector('#format-select') as HTMLSelectElement;
  const qualSlider = root.querySelector('#qual-slider') as HTMLInputElement;
  const qualNum = root.querySelector('#qual-num') as HTMLElement;
  const downloadBtn = root.querySelector('#download-btn') as HTMLButtonElement;
  const clearBtn = root.querySelector('#clear-btn') as HTMLButtonElement;

  let loadedImg: HTMLImageElement | null = null;
  let currentFile: File | null = null;
  let aspectRatio = 1;

  const updateTarget = () => {
    targetStat.textContent = `Target: ${widthInput.value || 0} x ${heightInput.value || 0}`;
  };

  root.addEventListener('files', (e) => {
    const files = (e as CustomEvent<File[]>).detail;
    if (!files.length || !files[0].type.startsWith('image/')) return;
    const file = files[0];
    currentFile = file;

    const url = URL.createObjectURL(file);
    const img = new Image();
    img.src = url;
    img.onload = () => {
      loadedImg = img;
      previewImg.src = url;
      aspectRatio = img.naturalWidth / img.naturalHeight;
      origDimEl.textContent = `${img.naturalWidth} x ${img.naturalHeight}`;
      origSizeEl.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      widthInput.value = img.naturalWidth.toString();
      heightInput.value = img.naturalHeight.toString();
      updateTarget();
      results.hidden = false;
    };
  });

  widthInput?.addEventListener('input', () => {
    const w = parseInt(widthInput.value, 10);
    if (lockRatio.checked && w && aspectRatio) {
      heightInput.value = Math.round(w / aspectRatio).toString();
    }
    updateTarget();
  });

  heightInput?.addEventListener('input', () => {
    const h = parseInt(heightInput.value, 10);
    if (lockRatio.checked && h && aspectRatio) {
      widthInput.value = Math.round(h * aspectRatio).toString();
    }
    updateTarget();
  });

  qualSlider?.addEventListener('input', () => {
    qualNum.textContent = qualSlider.value;
  });

  root.querySelectorAll('.preset-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const w = (btn as HTMLElement).dataset.w;
      const h = (btn as HTMLElement).dataset.h;
      if (w && h) {
        lockRatio.checked = false;
        widthInput.value = w;
        heightInput.value = h;
        updateTarget();
      }
    });
  });

  clearBtn?.addEventListener('click', () => {
    results.hidden = true;
    loadedImg = null;
    currentFile = null;
  });

  downloadBtn?.addEventListener('click', async () => {
    if (!loadedImg || !currentFile) return;
    const w = parseInt(widthInput.value, 10);
    const h = parseInt(heightInput.value, 10);
    if (!w || !h || w <= 0 || h <= 0) return;

    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(loadedImg, 0, 0, w, h);

    const mime = formatSelect.value;
    const qual = parseInt(qualSlider.value, 10) / 100;
    const blob: Blob = await new Promise((res) => canvas.toBlob((b) => res(b!), mime, qual));
    const ext = mime === 'image/png' ? 'png' : mime === 'image/webp' ? 'webp' : 'jpg';

    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    const base = currentFile.name.substring(0, currentFile.name.lastIndexOf('.')) || 'image';
    a.download = `${base}-${w}x${h}.${ext}`;
    a.click();
  });
</script>
