---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'Social Media Safe Zones: Reels, TikTok & Shorts Guide';
const description =
  'Interactive safe zone simulator for Instagram Reels, TikTok, YouTube Shorts, and Stories. Preview overlays to prevent app UI from obstructing your text.';

const faqs: FaqItem[] = [
  {
    q: 'What is a social media video safe zone?',
    a: 'A safe zone is the visible screen area in short-form video apps (Reels, TikTok, Shorts) where your critical content (text captions, logos, product callouts, and faces) will NOT be obstructed by app UI elements like the right-side engagement buttons (Like, Comment, Share), bottom captions and usernames, or top navigation headers.',
  },
  {
    q: 'What are the exact safe zone dimensions for Instagram Reels?',
    a: 'Instagram Reels are 1080 x 1920 pixels (9:16). The safe zone leaves a 160 px buffer at the top (profile/audio headers), a 440 px buffer at the bottom (usernames, audio ticker, multi-line captions), and a 130 px buffer on the right side (action buttons). Furthermore, when viewed in the feed, Reels are cropped to 1080 x 1350 (4:5), and on your profile grid, they are cropped to 1080 x 1080 (1:1).',
  },
  {
    q: 'What is the TikTok safe zone for text and captions?',
    a: 'TikTok videos are 1080 x 1920 pixels. The right side requires a 140 px safe margin to clear the creator avatar, follow button, like, comment, bookmark, share icons, and the rotating sound vinyl. The bottom requires a 480 px buffer to clear long captions, sound titles, and search pills.',
  },
  {
    q: 'How do YouTube Shorts safe zones differ from Instagram and TikTok?',
    a: 'YouTube Shorts have a top bar of approximately 140 px (search and menu icons) and a bottom buffer of 420 px (channel handle, red Subscribe button, and audio attribution). The right-hand column occupies roughly 130 px with engagement buttons (thumbs up/down, comments, share, remix).',
  },
  {
    q: 'How do I use the downloadable transparent PNG safe zone template in CapCut or Premiere Pro?',
    a: 'Click the "Download PNG Template" button to export a 1080 x 1920 transparent PNG guide. In your video editing software (Adobe Premiere, CapCut, Final Cut Pro, or DaVinci Resolve), import the PNG onto the top video track above your clips. Lock the track while positioning your titles and graphics inside the green safe boundary, then mute or delete the guide track before final rendering.',
  },
  {
    q: 'Are my uploaded videos or images sent to a server?',
    a: 'No. All video playback, canvas scaling, and overlay rendering executes 100% locally in your browser using HTML5 Video and Canvas APIs. Your video files never leave your computer or phone.',
  },
];

const canonicalUrl = `${SITE.url}/social-media-safe-zones/`;

const singleSchemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        url: SITE.url,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
          { '@type': 'ListItem', position: 3, name: 'Social Media Safe Zones', item: canonicalUrl },
        ],
      },
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: 'Social Media Safe Zones Simulator',
      url: canonicalUrl,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any (web browser)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description,
      featureList: [
        'Instagram Reels 9:16, 4:5, and 1:1 safe zone overlays',
        'TikTok caption and engagement UI danger zone simulator',
        'YouTube Shorts subscribe and header overlay preview',
        'Downloadable transparent 1080x1920 PNG editing templates',
        '100 percent in-browser execution with zero video uploads',
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to Check Social Media Video Safe Zones for Reels and TikTok',
      description: 'Step-by-step instructions to test short-form 9:16 videos against mobile app UI obstructions.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Upload video or image draft',
          text: 'Drag and drop your 9:16 short-form video or still frame into the simulator.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Toggle platform UI overlays',
          text: 'Switch between Instagram Reels, TikTok, YouTube Shorts, and Snapchat overlays.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Inspect text and graphics placement',
          text: 'Verify that captions, key visual subjects, and text calls-to-action remain inside green safe areas.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Download PNG editing template',
          text: 'Export the 1080x1920 transparent overlay template to use as a guide track in Premiere Pro or CapCut.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ],
};
---

<Base title={title} description={description} schema={singleSchemaGraph}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Creator Tool • 100% In-Browser • Universal 2026 UI Specs</span>
      <h1>Social Media <span class="accent">Safe Zones Checker</span></h1>
