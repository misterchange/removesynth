---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema, type FaqItem } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';

const title = 'Sora AI Video Cleaner: Remove Watermarks & C2PA';
const description =
  'Clean OpenAI Sora video watermarks, C2PA Content Credentials, and MP4 metadata online for free. 100% in-browser container sanitizer with zero re-encoding.';

const faqs: FaqItem[] = [
  {
    q: 'How do I remove the Sora AI watermark from my video?',
    a: 'Upload your Sora AI MP4 video into the cleaner above. Our client-side sanitizer losslessly wipes the container user-data (udta), encoder stamps, and C2PA provenance UUID boxes in under 1 second without re-encoding your video bitstream.',
  },
  {
    q: 'Does Sora AI add watermarks and metadata to exported clips?',
    a: 'Yes, Sora AI video exports can include bottom corner logo stamps on free and trial tiers as well as MP4 container user-data (udta), encoder provenance tags, and C2PA Content Credentials that platforms like Instagram and TikTok scan to flag AI video.',
  },
  {
    q: 'Will removing the watermark re-encode or compress my video?',
    a: 'No. Our in-browser container sanitizer operates strictly at the MP4 box header level. Video frames and audio streams are preserved bit-for-bit without generational loss, preserving original bitrate, frame rate, and resolution.',
  },
  {
    q: 'Can I clean 9:16 vertical videos for TikTok and Instagram Reels?',
    a: 'Yes. All video aspect ratios including 9:16 vertical, 16:9 widescreen, 1:1 square, and 4:3 broadcast are fully supported for instant client-side sanitization.',
  },
  {
    q: 'Are my private Sora AI videos uploaded to an external server?',
    a: 'Never. All container demuxing, box parsing, and file assembly execute 100 percent locally inside your web browser memory. Your video files never leave your computer or phone.',
  },
  {
    q: 'How does this tool prevent social media AI info labeling?',
    a: 'Social platforms like Instagram, TikTok, and YouTube scan MP4 user-data atoms (`udta`) and C2PA provenance boxes (`uuid`) during ingestion. By safely zeroing these tracking atoms into standard padding boxes (`free`), platforms treat your video as authentic camera footage.',
  },
  {
    q: 'Does this tool work on mobile devices like iPhone and Android?',
    a: 'Yes. You can open this tool in Safari on iOS or Chrome on Android, select your Sora AI video from your photo library or Files app, and download the sanitized MP4 directly to your device.',
  },
  {
    q: 'What video file formats are supported by the sanitizer?',
    a: 'The sanitizer supports standard MP4, MOV, and WebM video containers exported by generative AI video platforms up to 500 MB in file size.',
  },
];

const canonicalUrl = `${SITE.url}/sora-ai/`;

const singleSchemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        url: SITE.url,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
          { '@type': 'ListItem', position: 3, name: 'Sora AI Video Sanitizer', item: canonicalUrl },
        ],
      },
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: 'Sora AI Video Sanitizer',
      url: canonicalUrl,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any (web browser)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ],
};
---

