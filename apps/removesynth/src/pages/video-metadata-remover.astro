---
import Base from '../layouts/Base.astro';
import Jitter from '@removesynth/shared/components/Jitter.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { SITE } from '../site';

const title = 'Video Metadata Remover: Clean MP4 & MOV Tags Free';
const description =
  'Remove metadata from MP4, WebM, and MOV video files. Strip GPS coordinates, creation timestamps, and camera tags without re-encoding or any quality loss.';

const faqs = [
  {
    q: 'What metadata is embedded inside MP4 and MOV video files?',
    a: 'Video files contain technical containers with ISO-BMFF and QuickTime atoms that store precise GPS location tags in the ©xyz atom, camera serial numbers, creation and modification timestamps in mvhd and tkhd atoms, editing software footprints in udta and meta boxes, and C2PA provenance manifests in uuid atoms.',
  },
  {
    q: 'Does removing metadata reduce video quality or compress audio?',
    a: 'No. Our tool performs header-level container atom sanitization. It removes private metadata atoms from the container headers without touching the underlying H.264, HEVC, ProRes, or AAC video and audio streams. Visual clarity and sound fidelity remain 100 percent identical.',
  },
  {
    q: 'How fast is video metadata processing?',
    a: 'Because video and audio streams are never re-encoded, processing is near-instantaneous. Most video clips up to 500 MB process in under 2 seconds directly inside your browser.',
  },
  {
    q: 'Which video formats are supported?',
    a: 'MP4, MOV (QuickTime), WebM, and M4V video containers are natively supported. The sanitized file is exported in its native container format and resolution.',
  },
  {
    q: 'Is my video file uploaded to a remote cloud server?',
    a: 'Never. All atom parsing, timestamp zeroing, and byte restructuring happen 100 percent client-side in your web browser memory. Your private home videos, drone footage, and confidential rushes never leave your computer.',
  },
  {
    q: 'Does this tool remove GPS coordinates from iPhone and drone videos?',
    a: 'Yes. It targets and zeroes out the QuickTime ©xyz GPS atom and location strings embedded by Apple iPhones, DJI drones, GoPro cameras, and Android devices.',
  },
  {
    q: 'Can social media platforms still see when the video was recorded?',
    a: 'No. The tool resets creation_time and modification_time attributes in the mvhd and tkhd headers to UTC epoch zero, preventing platforms and viewers from extracting recording timestamps.',
  },
  {
    q: 'Does it strip C2PA Content Credentials manifests from video?',
    a: 'Yes. Top-level uuid atoms containing C2PA provenance manifests and AI video generation signatures are sanitized and purged.',
  },
];

const canonicalUrl = `${SITE.url}/video-metadata-remover/`;

const singleSchemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        url: SITE.url,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
          { '@type': 'ListItem', position: 3, name: 'Video Metadata Remover', item: canonicalUrl },
        ],
      },
    },
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      name: 'Video Metadata Remover',
      url: canonicalUrl,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any (web browser)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description,
      featureList: [
        'Lossless ISO-BMFF container atom sanitization',
        'QuickTime GPS location coordinate removal',
        'Creation and modification timestamp zeroing',
        'Zero re-encoding with 100 percent original video quality retention',
        '100 percent in-browser memory execution with zero cloud storage',
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to Remove Metadata from MP4 and MOV Video Files',
      description: 'Step-by-step instructions to strip GPS tags, timestamps, camera serial numbers, and C2PA manifests from video files without re-encoding.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Select your video file',
          text: 'Drag and drop your MP4, MOV, or WebM clip into the tool dropzone.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Scan container atoms',
          text: 'The browser inspects ISO-BMFF box structures, flagging GPS atoms, creation times, and user data.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Execute lossless atom stripping',
          text: 'The engine zeroes out udta boxes and resets movie headers without re-encoding video streams.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Download clean video',
          text: 'Save your sanitized video file with 100 percent identical picture and audio quality.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ],
};
---

<Base title={title} description={description} schema={singleSchemaGraph}>
  <section class="hero" id="tool">
    <div class="container">
      <span class="eyebrow">Zero Re-Encoding - 100% In-Browser - Lossless</span>
      <h1>Video Metadata <span class="accent">Remover</span></h1>
      <p class="lead">
        Strip GPS coordinates, creation timestamps, camera serials, and editing history from MP4 and MOV files.
        Zero quality loss, zero re-encoding, and 100% private in-browser processing.
      </p>

      <!-- Tool Stage -->
      <div class="tool-stage">
        <Jitter side="left" />
        <div class="video-tool" id="video-tool">
          
          <div class="vid-dropzone" id="dz">
            <input type="file" id="file-in" accept="video/mp4,video/quicktime,video/webm,.mp4,.mov,.webm" hidden />
            
            <div class="dz-prompt" id="dz-prompt">
              <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                <line x1="7" y1="2" x2="7" y2="22"></line>
                <line x1="17" y1="2" x2="17" y2="22"></line>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <line x1="2" y1="7" x2="7" y2="7"></line>
                <line x1="2" y1="17" x2="7" y2="17"></line>
                <line x1="17" y1="17" x2="22" y2="17"></line>
                <line x1="17" y1="7" x2="22" y2="7"></line>
              </svg>
              <p><strong>Click or drag an MP4 or MOV video here</strong></p>
              <span class="small muted">Supports MP4, MOV, WebM - Up to 500 MB - Zero upload</span>
            </div>

            <div class="dz-details" id="dz-details" hidden>
              <div class="vid-header-info">
                <span class="vid-name" id="vid-name">video.mp4</span>
                <span class="badge" id="vid-size">0 MB</span>
                <button type="button" class="btn-sm" id="btn-change">Change</button>
              </div>

              <div class="tags-list" id="tags-list"></div>
            </div>
          </div>

          <div class="vid-actions" id="vid-actions" hidden>
            <div class="clean-options">
              <label class="check-opt">
                <input type="checkbox" id="opt-gps" checked />
                <span>Remove GPS coordinates and location tags (QuickTime &copy;xyz)</span>
              </label>
              <label class="check-opt">
                <input type="checkbox" id="opt-time" checked />
                <span>Reset creation and modification timestamps (mvhd, tkhd to epoch zero)</span>
              </label>
              <label class="check-opt">
                <input type="checkbox" id="opt-udta" checked />
                <span>Scrub software, author, and encoder user metadata (udta, meta)</span>
              </label>
              <label class="check-opt">
                <input type="checkbox" id="opt-c2pa" checked />
                <span>Purge C2PA provenance manifest and AI video uuid atoms</span>
              </label>
            </div>

            <div class="action-btn-row">
              <button type="button" class="btn btn-primary" id="btn-clean-video">
                Clean &amp; Download Video
              </button>
              <button type="button" class="btn btn-ghost" id="btn-copy-summary">
                Copy Report
              </button>
              <button type="button" class="btn btn-ghost" id="btn-share-state">
                Share Link
              </button>
              <span class="tool-status small" id="tool-status" role="status" aria-live="polite"></span>
            </div>
          </div>

        </div>
        <Jitter side="right" />
      </div>

    </div>
  </section>

  <!-- Lead In-Depth Context -->
  <section class="section">
    <div class="container measure-readable">
      <p class="lead-context">
        Whenever you record video on a smartphone, action camera, or drone, your device embeds extensive telemetry data directly into the media container. Standard MP4 and Apple QuickTime MOV files retain precise satellite GPS coordinates, device serial numbers, lens settings, and exact recording timestamps. Sharing uncleaned video files on public message boards, social networks, or cloud storage can inadvertently expose your private home address, travel routines, or confidential production sources. RemoveSynth performs lossless container sanitization directly in your browser. By parsing and zeroing out metadata atoms without re-encoding video frames, your private telemetry is eliminated in milliseconds with zero quality loss.
      </p>
    </div>
  </section>

  <!-- How It Works Technical Specification -->
  <section class="section bg-alt">
    <div class="container">
      <h2>How Video Metadata Removal Works: Lossless Atom Sanitization</h2>
      <p class="section-lead">
        Video files are built from structured atom boxes defined by ISO/IEC 14496-12. Sanitizing metadata does not require re-compressing the video stream.
      </p>

      <div class="formula-card">
        <h3>Mathematical Model of the ISO-BMFF Container Structure</h3>
        <p>
          An MP4 or MOV container is composed of sequential top-level boxes:
        </p>
        <div class="math-block">
          <code>File_video = Box_ftyp + Box_moov( mvhd, trak_1, trak_2, udta, meta ) + Box_mdat( Samples_H264_AAC )</code>
        </div>
        <p>
          Metadata resides entirely within the Movie Box <code>moov</code> and optional vendor <code>uuid</code> boxes, while pure compressed audio/video frames are stored in the Media Data Box <code>mdat</code>:
        </p>
        <div class="math-block">
          <code>Size(File_video) = Size(moov) + Size(mdat) + Size(ftyp)</code>
        </div>
        <p>
          RemoveSynth traverses the box hierarchy in typed array memory:
        </p>
        <div class="math-block">
          <code>Box_moov_clean = Box_moov - (udta + meta + uuid_C2PA) with Timestamp(mvhd) = 0</code>
        </div>
        <p>
          Because the <code>mdat</code> box containing H.264, HEVC, ProRes, or AAC samples is preserved bit-for-bit without decompression, processing speed is limited only by local disk read/write bandwidth.
        </p>
      </div>

      <div class="worked-example-card">
        <h3>Worked Example: Sanitizing a 4K iPhone 15 Pro QuickTime Video</h3>
        <p>
          Consider a 280 MB 4K video clip recorded at 60 fps on an iPhone:
        </p>
        <ul>
          <li><strong>Source File Size:</strong> 284,520,000 bytes (284.5 MB) MOV container.</li>
          <li><strong>Embedded Telemetry:</strong> GPS coordinates (<code>©xyz: +37.7749-122.4194/</code>), Creation Date (<code>mvhd: 2026-08-14 15:22:04</code>), Device Serial (<code>Apple iPhone 15 Pro, iOS 18.1</code>).</li>
          <li><strong>Execution in RemoveSynth:</strong> The video file buffer is read into typed memory. The parser navigates to the <code>moov</code> atom, zeroes the <code>mvhd</code> timestamp fields, wipes the <code>udta</code> user metadata box, and unlinks vendor C2PA tags.</li>
          <li><strong>Processing Time:</strong> 190 milliseconds. Zero frames re-encoded.</li>
          <li><strong>Sanitized Output File:</strong> 284,490,000 bytes. Identical 4K bitstream, zero GPS metadata, zero device serial tracking.</li>
        </ul>
      </div>

      <!-- SVG Container Diagram -->
      <div class="chart-container">
        <h3>ISO-BMFF Container Box Hierarchy: Before vs. After Sanitization</h3>
        <p class="chart-sub">Preserving media samples (mdat) while eliminating user data (udta) and timestamps.</p>
        <svg viewBox="0 0 760 280" class="data-chart" aria-label="ISO-BMFF Video Container Architecture Chart">
          <rect x="20" y="20" width="720" height="240" rx="8" fill="#13171f" stroke="#252d3d" stroke-width="1" />
          
          <!-- Flagged Container -->
          <text x="40" y="55" fill="#f87171" font-size="13" font-weight="600">ORIGINAL VIDEO CONTAINER (EXPOSED GPS &amp; TIMESTAMPS)</text>
          
          <rect x="40" y="70" width="80" height="40" rx="4" fill="#1e293b" stroke="#334155" />
          <text x="80" y="95" fill="#94a3b8" font-size="12" text-anchor="middle">ftyp</text>

          <rect x="130" y="70" width="130" height="40" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="195" y="95" fill="#fca5a5" font-size="12" font-weight="600" text-anchor="middle">mvhd: Timestamp</text>

          <rect x="270" y="70" width="140" height="40" rx="4" fill="#7f1d1d" stroke="#ef4444" />
          <text x="340" y="95" fill="#fca5a5" font-size="12" font-weight="600" text-anchor="middle">udta: &copy;xyz GPS</text>

          <rect x="420" y="70" width="300" height="40" rx="4" fill="#1e293b" stroke="#334155" />
          <text x="570" y="95" fill="#94a3b8" font-size="12" text-anchor="middle">mdat: Pure Video &amp; Audio Samples (280 MB)</text>

          <line x1="40" y1="135" x2="740" y2="135" stroke="#334155" stroke-dasharray="4" />

          <!-- Sanitized Container -->
          <text x="40" y="165" fill="#34d399" font-size="13" font-weight="600">SANITIZED VIDEO CONTAINER (REMOVESYNTH LOSSLESS OUTPUT)</text>
          
          <rect x="40" y="180" width="80" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="80" y="205" fill="#a7f3d0" font-size="12" text-anchor="middle">ftyp</text>

          <rect x="130" y="180" width="130" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="195" y="205" fill="#a7f3d0" font-size="12" text-anchor="middle">mvhd: Epoch 0</text>

          <rect x="270" y="180" width="140" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="340" y="205" fill="#a7f3d0" font-size="12" text-anchor="middle">udta: Zeroed</text>

          <rect x="420" y="180" width="300" height="40" rx="4" fill="#064e3b" stroke="#10b981" />
          <text x="570" y="205" fill="#a7f3d0" font-size="12" font-weight="600" text-anchor="middle">mdat: 100% Bit-for-Bit Preserved Stream</text>

          <!-- Marker Badge -->
          <rect x="270" y="235" width="260" height="24" rx="12" fill="#10b981" />
          <text x="400" y="251" fill="#022c22" font-size="11" font-weight="700" text-anchor="middle">YOU ARE HERE (ZERO QUALITY LOSS)</text>
        </svg>
      </div>

    </div>
  </section>

  <!-- Step-by-Step Instructions -->
  <section class="section">
    <div class="container">
      <h2>Step-by-Step: How to Strip Metadata from MP4 and MOV Videos</h2>
      <p class="section-lead">
        Four fast steps to sanitize your video files without downloading heavy desktop software.
      </p>

      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number">Step 1</span>
          <h3>Upload Video</h3>
          <p>
            Drop your MP4, MOV, or WebM clip into the tool. Supports footage up to 500 MB recorded on phones, cameras, or drones.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 2</span>
          <h3>Inspect Detected Atoms</h3>
          <p>
            The analyzer flags embedded GPS coordinates, QuickTime user data, creation timestamps, and C2PA manifests.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 3</span>
          <h3>Execute Lossless Cleaning</h3>
          <p>
            The browser zeroes out telemetry boxes in memory, leaving the underlying video and audio streams 100 percent untouched.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 4</span>
          <h3>Download Clean Video</h3>
          <p>
            Save your clean video file ready for upload to YouTube, Instagram, Reddit, or client portals without privacy risks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sub-Search In-Depth Content -->
  <section class="section bg-alt">
    <div class="container measure-readable">
      <h2>Comprehensive Video Privacy and Metadata Guide</h2>

      <div class="subsearch-block">
        <h3>How to Remove GPS Location Coordinates from Video</h3>
        <p>
          Modern cameras store GPS latitude, longitude, and altitude within QuickTime user data atoms (<code>©xyz</code>). Anyone with a free media inspector can read these coordinates to locate where a video was captured. RemoveSynth zeroes out the <code>©xyz</code> atom and clears auxiliary location tracks completely.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>Clean MP4 Metadata on Mac, Windows, and Linux</h3>
        <p>
          Desktop utilities like FFmpeg require command-line terminal commands (such as <code>ffmpeg -i in.mp4 -map_metadata -1 -c copy out.mp4</code>). RemoveSynth provides the exact same bitstream-copy mechanism inside an accessible web interface that functions in any desktop or mobile browser.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>Drone and Action Camera Metadata Stripping (DJI, GoPro)</h3>
        <p>
          Action cameras and commercial drones embed high-frequency flight telemetry, accelerometer readings, and pilot location data into MP4 subtitle and data streams. Running clips through RemoveSynth strips these proprietary tracking records before publishing.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>Why Re-Encoding Video Degrades Quality and Wastes Time</h3>
        <p>
          Most online video converters re-compress video through cloud encoders like H.264 or VP9. This process introduces macroblocking compression artifacts, alters frame rates, and can take minutes per file. Because RemoveSynth modifies only container headers, processing takes under a second and picture quality remains 100 percent identical.
        </p>
      </div>

      <div class="subsearch-block">
        <h3>C2PA Video Manifest and AI Video Tag Neutralization</h3>
        <p>
          Emerging AI video generators (such as Sora, Runway Gen-3, Google Veo, and Kling) embed C2PA cryptographic manifests in <code>uuid</code> container boxes. RemoveSynth detects and neutralizes these provenance records.
        </p>
      </div>
    </div>
  </section>

  <!-- Performance & Compatibility Benchmarks -->
  <section class="section">
    <div class="container">
      <h2>Processing Speed Benchmarks Across Common Video Formats</h2>
      <p class="section-lead">
        Header atom stripping speed measurements on standard consumer hardware.
      </p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Video Source &amp; Codec</th>
              <th>Container &amp; Resolution</th>
              <th>File Size</th>
              <th>Processing Time</th>
              <th>Quality Retention</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>iPhone 15 Pro 4K60 (HEVC)</td>
              <td>QuickTime MOV (3840x2160)</td>
              <td>350 MB</td>
              <td>240 ms</td>
              <td>100% Bit-for-Bit Lossless</td>
            </tr>
            <tr>
              <td>GoPro Hero 12 (H.264)</td>
              <td>MP4 Container (4K)</td>
              <td>420 MB</td>
              <td>310 ms</td>
              <td>100% Bit-for-Bit Lossless</td>
            </tr>
            <tr>
              <td>DJI Mini 4 Pro Drone Footage</td>
              <td>MP4 Container (4K HDR)</td>
              <td>280 MB</td>
