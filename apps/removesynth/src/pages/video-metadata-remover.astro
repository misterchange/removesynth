              <td>File Size Paywalls</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Primary Sources -->
      <div class="sources-card">
        <h3>Primary Technical Standards Referenced</h3>
        <ul>
          <li>
            <a href="https://www.iso.org/standard/68960.html" target="_blank" rel="noopener noreferrer">
