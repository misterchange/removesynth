<script>
  let currentFile: File | null = null;
  let rawBuffer: ArrayBuffer | null = null;

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzDetails = document.getElementById('dz-details')!;
  const vidName = document.getElementById('vid-name')!;
  const vidSize = document.getElementById('vid-size')!;
  const tagsList = document.getElementById('tags-list')!;
  const btnChange = document.getElementById('btn-change')!;
  const vidActions = document.getElementById('vid-actions')!;
  const btnClean = document.getElementById('btn-clean-video')!;
  const btnCopySummary = document.getElementById('btn-copy-summary');
  const btnShareState = document.getElementById('btn-share-state');
  const toolStatus = document.getElementById('tool-status')!;

  dz.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#btn-change')) return;
    if (currentFile) return;
    fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag');
    if (e.dataTransfer?.files?.[0]) handleVideo(e.dataTransfer.files[0]);
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files?.[0]) handleVideo(fileIn.files[0]);
  });

  btnChange.addEventListener('click', () => {
    currentFile = null;
    rawBuffer = null;
    fileIn.value = '';
    dzPrompt.hidden = false;
    dzDetails.hidden = true;
    vidActions.hidden = true;
  });

  async function handleVideo(file: File) {
    currentFile = file;
    vidName.textContent = file.name;
    vidSize.textContent = `${(file.size / (1024 * 1024)).toFixed(2)} MB`;

    toolStatus.textContent = 'Scanning video container atoms...';
    rawBuffer = await file.arrayBuffer();

    dzPrompt.hidden = true;
    dzDetails.hidden = false;
    vidActions.hidden = false;

    // Fast heuristic scan of atoms in the buffer
    const uint8 = new Uint8Array(rawBuffer);
    const text = new TextDecoder('latin1').decode(uint8.subarray(0, Math.min(uint8.length, 1024 * 1024)));

    tagsList.innerHTML = '';
    const checks = [
      { name: 'GPS Location Coordinates (©xyz)', found: text.includes('©xyz') },
      { name: 'QuickTime User Data (udta)', found: text.includes('udta') },
      { name: 'Creation & Modification Timestamps', found: text.includes('mvhd') || text.includes('tkhd') },
      { name: 'Encoder & Camera Fingerprints', found: text.includes('©too') || text.includes('©ART') || text.includes('Lavf') },
      { name: 'C2PA Manifest Atom (uuid)', found: text.includes('c2pa') },
    ];

    checks.forEach((c) => {
      const span = document.createElement('span');
      span.className = `tag-item ${c.found ? 'found' : ''}`;
      span.textContent = `${c.found ? ' Found' : ' Clean'}: ${c.name}`;
      tagsList.appendChild(span);
    });

    toolStatus.textContent = 'Video analyzed. Ready to clean.';
  }

  // Fast ISO-BMFF / MP4 Box Sanitizer
  function cleanMp4Boxes(buffer: ArrayBuffer): Uint8Array {
    const bytes = new Uint8Array(buffer);
    const view = new DataView(buffer);
    const len = bytes.length;
    let pos = 0;

    // Traverse top-level boxes
    while (pos < len - 8) {
      let boxSize = view.getUint32(pos);
      const boxType = String.fromCharCode(bytes[pos+4], bytes[pos+5], bytes[pos+6], bytes[pos+7]);

      if (boxSize === 0) break; // runs to end of file
      if (boxSize === 1) {
        // 64-bit large box size
        boxSize = Number(view.getBigUint64(pos + 8));
      }

      if (boxType === 'moov') {
        cleanMoovBox(bytes, pos + 8, pos + boxSize);
      } else if (boxType === 'uuid') {
        // C2PA or custom vendor tags inside top-level uuid
        for (let i = pos + 8; i < pos + boxSize; i++) {
          bytes[i] = 0;
        }
      }

      pos += boxSize;
    }
    return bytes;
  }

  function cleanMoovBox(bytes: Uint8Array, start: number, end: number) {
    const view = new DataView(bytes.buffer);
    let pos = start;

    while (pos < end - 8) {
      const boxSize = view.getUint32(pos);
      if (boxSize < 8 || pos + boxSize > end) break;
      const boxType = String.fromCharCode(bytes[pos+4], bytes[pos+5], bytes[pos+6], bytes[pos+7]);

      if (boxType === 'mvhd') {
        // Reset creation_time and modification_time (offset 12 or 16 depending on version)
        const version = bytes[pos + 8];
        if (version === 0) {
          view.setUint32(pos + 12, 0); // creation_time
          view.setUint32(pos + 16, 0); // modification_time
        } else if (version === 1) {
          view.setBigUint64(pos + 12, 0n);
          view.setBigUint64(pos + 20, 0n);
        }
      } else if (boxType === 'udta' || boxType === 'meta') {
        // Zero out user data and metadata atoms (strips GPS, author, encoder)
        for (let i = pos + 8; i < pos + boxSize; i++) {
          bytes[i] = 0;
        }
      } else if (boxType === 'trak') {
        cleanTrakBox(bytes, pos + 8, pos + boxSize);
      }

      pos += boxSize;
    }
  }

  function cleanTrakBox(bytes: Uint8Array, start: number, end: number) {
    const view = new DataView(bytes.buffer);
    let pos = start;

    while (pos < end - 8) {
      const boxSize = view.getUint32(pos);
      if (boxSize < 8 || pos + boxSize > end) break;
      const boxType = String.fromCharCode(bytes[pos+4], bytes[pos+5], bytes[pos+6], bytes[pos+7]);

      if (boxType === 'tkhd') {
        const version = bytes[pos + 8];
        if (version === 0) {
          view.setUint32(pos + 12, 0);
          view.setUint32(pos + 16, 0);
        } else if (version === 1) {
          view.setBigUint64(pos + 12, 0n);
          view.setBigUint64(pos + 20, 0n);
        }
      } else if (boxType === 'udta') {
        for (let i = pos + 8; i < pos + boxSize; i++) {
          bytes[i] = 0;
        }
      }

      pos += boxSize;
    }
  }

  btnClean.addEventListener('click', () => {
    if (!rawBuffer || !currentFile) return;

    toolStatus.textContent = 'Sanitizing container atoms...';
    try {
      const cleanBytes = cleanMp4Boxes(rawBuffer);
      const cleanBlob = new Blob([cleanBytes], { type: currentFile.type || 'video/mp4' });
      const url = URL.createObjectURL(cleanBlob);
      const a = document.createElement('a');
      const ext = currentFile.name.split('.').pop() || 'mp4';
      a.href = url;
      a.download = currentFile.name.replace(/\.[^/.]+$/, '') + '-clean.' + ext;
      a.click();
      URL.revokeObjectURL(url);

      toolStatus.textContent = 'Sanitized video exported losslessly.';
      toolStatus.className = 'tool-status small ok';
    } catch (e) {
      console.error(e);
      toolStatus.textContent = 'Error processing video file.';
    }
  });

  if (btnCopySummary) {
    btnCopySummary.addEventListener('click', () => {
      const summaryText = `RemoveSynth Video Report:\nFile: ${currentFile?.name || 'video'}\nGPS location wiped (©xyz).\nCreation/modification timestamps set to UTC epoch zero.\nUser data and C2PA uuid atoms stripped.\nStreams 100% losslessly preserved.`;
      navigator.clipboard.writeText(summaryText).then(() => {
        btnCopySummary.textContent = 'Copied!';
        setTimeout(() => {
          btnCopySummary.textContent = 'Copy Report';
        }, 2000);
      });
    });
  }

  if (btnShareState) {
    btnShareState.addEventListener('click', () => {
      const shareUrl = `${window.location.origin}${window.location.pathname}#tool`;
      navigator.clipboard.writeText(shareUrl).then(() => {
        btnShareState.textContent = 'Link Copied!';
        setTimeout(() => {
          btnShareState.textContent = 'Share Link';
        }, 2000);
      });
    });
  }
</script>
