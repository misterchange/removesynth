          </tr>
          <tr>
            <td><strong>Smart Blur Ambient Fill</strong></td>
            <td>Automatic Canvas Layering</td>
            <td>Manual Duplicate and Blur</td>
            <td>Not Supported</td>
            <td>Multi-Step Layer Action</td>
          </tr>
          <tr>
            <td><strong>Export Speed</strong></td>
