            <td>Requires Paid License</td>
          </tr>
          <tr>
            <td><strong>Exact YouTube Presets</strong></td>
            <td>Instant 1-Click Toggle</td>
            <td>Manual Dimensions Entry</td>
            <td>Generic Resize Sliders</td>
