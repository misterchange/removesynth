    <!-- FAQ Section -->
    <Faq items={faqs} heading="Thumbnail &amp; Banner Resizer FAQ" />
  </article>

</Base>

<style>
  .tool-stage {
    position: relative;
    max-width: 860px;
    margin: 28px auto 0;
  }
  .yt-tool {
    max-width: 860px;
    margin: 0 auto;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-lg);
    text-align: left;
  }
  .yt-dropzone {
    border: 2px dashed var(--border-strong);
    border-radius: 18px;
    padding: 32px 20px;
    text-align: center;
    background: linear-gradient(180deg, var(--accent-faint), transparent);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .yt-dropzone:hover,
  .yt-dropzone.drag {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .dz-prompt svg {
    color: var(--accent);
    margin-bottom: 8px;
  }
  .preview-stage {
    position: relative;
    display: inline-block;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  #preview-canvas {
    display: block;
    max-width: 100%;
    max-height: 380px;
    margin: 0 auto;
  }
  .banner-guide {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .guide-box {
    width: 60.4%;
    height: 29.4%;
    border: 2px dashed rgba(64, 224, 208, 0.9);
    background: rgba(64, 224, 208, 0.15);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
    border-radius: 4px;
  }
  .file-summary {
    margin-top: 12px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text);
  }
  .section-label {
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin: 22px 0 10px;
  }
  .presets-grid,
  .fit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
  }
  .preset-card,
  .fit-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: all 0.15s ease;
  }
  .preset-card strong,
  .fit-card strong {
    font-size: 0.92rem;
  }
  .preset-card span,
  .fit-card span {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 2px;
  }
  .preset-card:hover,
  .fit-card:hover {
    border-color: var(--border-strong);
  }
  .preset-card.active,
  .fit-card.active {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .actions-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .btn-sm {
    padding: 6px 14px;
    font-size: 0.82rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
    cursor: pointer;
    margin-top: 10px;
    transition: all 0.15s ease;
  }
  .btn-sm:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
</style>

<script>
  let rawImg: HTMLImageElement | null = null;
  let rawFile: File | null = null;
  let targetW = 1280;
  let targetH = 720;
  let isBanner = false;
  let fitMode = 'blur';

  const dz = document.getElementById('dz')!;
  const fileIn = document.getElementById('file-in') as HTMLInputElement;
  const dzPrompt = document.getElementById('dz-prompt')!;
  const dzPreview = document.getElementById('dz-preview')!;
  const previewCanvas = document.getElementById('preview-canvas') as HTMLCanvasElement;
  const bannerGuide = document.getElementById('banner-guide')!;
  const fileSummary = document.getElementById('file-summary')!;
  const btnChange = document.getElementById('btn-change')!;
  const ytControls = document.getElementById('yt-controls')!;
  const btnDownload = document.getElementById('btn-download')!;
  const dlDim = document.getElementById('dl-dim')!;
  const toolStatus = document.getElementById('tool-status')!;

  dz.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#btn-change')) return;
    if (rawImg) return;
    fileIn.click();
  });

  dz.addEventListener('dragover', (e) => {
    e.preventDefault();
    dz.classList.add('drag');
  });

  dz.addEventListener('dragleave', () => dz.classList.remove('drag'));

  dz.addEventListener('drop', (e) => {
    e.preventDefault();
    dz.classList.remove('drag');
    if (e.dataTransfer?.files?.[0]) handleFile(e.dataTransfer.files[0]);
  });

  fileIn.addEventListener('change', () => {
    if (fileIn.files?.[0]) handleFile(fileIn.files[0]);
  });

  btnChange.addEventListener('click', () => {
    rawImg = null;
    rawFile = null;
    fileIn.value = '';
    dzPrompt.hidden = false;
    dzPreview.hidden = true;
    ytControls.hidden = true;
  });

  function handleFile(file: File) {
    if (!file.type.startsWith('image/')) {
      alert('Please upload an image file (JPG, PNG, WebP, AVIF).');
      return;
    }
    rawFile = file;
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      rawImg = img;
      dzPrompt.hidden = true;
      dzPreview.hidden = false;
      ytControls.hidden = false;
      fileSummary.textContent = `${file.name} · Original: ${img.naturalWidth} × ${img.naturalHeight} px (${(file.size / 1024).toFixed(1)} KB)`;
      renderPreview();
    };
    img.src = url;
  }

  // Presets
  document.querySelectorAll('.preset-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-card').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      targetW = parseInt(btn.getAttribute('data-w') || '1280', 10);
      targetH = parseInt(btn.getAttribute('data-h') || '720', 10);
      isBanner = btn.getAttribute('data-banner') === 'true';
      dlDim.textContent = `${targetW}×${targetH}`;
      bannerGuide.hidden = !isBanner;
      renderPreview();
    });
  });

  // Fit modes
  document.querySelectorAll('.fit-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fit-card').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      fitMode = btn.getAttribute('data-mode') || 'blur';
      renderPreview();
    });
  });

  function renderPreview() {
    if (!rawImg) return;
    previewCanvas.width = targetW;
    previewCanvas.height = targetH;
    const ctx = previewCanvas.getContext('2d');
    if (!ctx) return;

    ctx.clearRect(0, 0, targetW, targetH);

    const sw = rawImg.naturalWidth;
    const sh = rawImg.naturalHeight;

    if (fitMode === 'cover') {
      const scale = Math.max(targetW / sw, targetH / sh);
      const dw = sw * scale;
      const dh = sh * scale;
      const dx = (targetW - dw) / 2;
      const dy = (targetH - dh) / 2;
      ctx.drawImage(rawImg, dx, dy, dw, dh);
    } else if (fitMode === 'black') {
      ctx.fillStyle = '#000000';
      ctx.fillRect(0, 0, targetW, targetH);
      const scale = Math.min(targetW / sw, targetH / sh);
      const dw = sw * scale;
      const dh = sh * scale;
      const dx = (targetW - dw) / 2;
      const dy = (targetH - dh) / 2;
      ctx.drawImage(rawImg, dx, dy, dw, dh);
    } else {
      ctx.save();
      ctx.filter = 'blur(26px) brightness(0.65)';
      const bgScale = Math.max(targetW / sw, targetH / sh) * 1.08;
      const bgW = sw * bgScale;
      const bgH = sh * bgScale;
      const bgX = (targetW - bgW) / 2;
      const bgY = (targetH - bgH) / 2;
      ctx.drawImage(rawImg, bgX, bgY, bgW, bgH);
      ctx.restore();

      const scale = Math.min(targetW / sw, targetH / sh);
      const dw = sw * scale;
      const dh = sh * scale;
      const dx = (targetW - dw) / 2;
      const dy = (targetH - dh) / 2;
      ctx.save();
      ctx.shadowColor = 'rgba(0, 0, 0, 0.45)';
      ctx.shadowBlur = 18;
      ctx.drawImage(rawImg, dx, dy, dw, dh);
      ctx.restore();
    }
  }

  // Download
  btnDownload.addEventListener('click', () => {
    if (!previewCanvas) return;
    toolStatus.textContent = 'Exporting high-resolution thumbnail...';
    previewCanvas.toBlob((blob) => {
      if (!blob) return;
      const dlUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const baseName = (rawFile?.name || 'thumbnail').replace(/\.[^/.]+$/, '');
      a.href = dlUrl;
      a.download = `${baseName}_${targetW}x${targetH}.jpg`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(dlUrl), 1000);
      toolStatus.textContent = `Downloaded ${targetW}×${targetH} JPG!`;
    }, 'image/jpeg', 0.94);
  });
</script>
