---
import Base from '../layouts/Base.astro';
import ImageTool from '../components/ImageTool.astro';
import Faq from '@removesynth/shared/components/Faq.astro';
import { faqSchema, breadcrumbSchema } from '@removesynth/shared/lib/faq';
import { SITE } from '../site';
import { SIZES, type SizePage } from '../data/image-tools';

export function getStaticPaths() {
  return SIZES.map((s) => ({ params: { size: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: SizePage };
const path = `/compress-image-to-${s.slug}/`;
const compact = s.label.replace(' ', '');
const title = `Compress Image to ${compact}: Reduce Photo Size to ${s.label} Online, Free`;
const description = `Compress a JPG or photo to ${s.label} in seconds. Free, works on phone and PC, keeps the best quality that fits, and nothing is uploaded.`;
const others = SIZES.filter((x) => x.slug !== s.slug);

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Compress image to KB', url: `${SITE.url}/compress-image-to-kb/` },
    { name: `To ${s.label}`, url: `${SITE.url}${path}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `How to compress an image to ${s.label}`,
    step: [
      { '@type': 'HowToStep', position: 1, text: 'Drop your photo into the tool.' },
      { '@type': 'HowToStep', position: 2, text: `Keep the target at ${s.label}.` },
      { '@type': 'HowToStep', position: 3, text: 'Download the compressed photo.' },
    ],
  },
  faqSchema(s.faqs),
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Free · No upload · Phone &amp; PC</span>
      <h1>Compress image to <span class="accent">{s.label}</span></h1>
      <p class="lead">Drop your photo and get a copy under {s.label}, at the best quality that fits.</p>
      <ImageTool mode="compress" targetKb={s.kb} title={`Drop photos to compress to ${s.label}`} sub="Change the size any time; results update instantly." />
    </div>
  </section>

  <article class="prose">
    <h2>When you need a photo under {s.label}</h2>
    <ul>{s.uses.map((u) => <li>{u}</li>)}</ul>

    <h2>How to compress a photo to {s.label}</h2>
    <ol class="steps">
      <li>Drop your photo into the box above, or tap it to choose one. You can add up to 30.</li>
      <li>The target is already set to {s.label}. Change it if your form needs something else.</li>
      <li>Download the result. The new size is shown next to each photo.</li>
    </ol>

    <h2>What size will the image be?</h2>
    <p>{s.dims}</p>

    <h2>Tips for the best result</h2>
    <ul>{s.tips.map((t) => <li>{t}</li>)}</ul>

    <h2>Other sizes</h2>
    <ul class="link-grid">
      {others.map((o) => <li><a href={`/compress-image-to-${o.slug}/`}>Compress to {o.label}</a></li>)}
      <li><a href="/compress-image-to-kb/">Any size in KB</a></li>
    </ul>

    <Faq items={s.faqs} heading={`Compress to ${s.label} FAQ`} />
  </article>
</Base>

<style>
  .link-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    gap: 8px;
  }
  .link-grid a {
    display: block;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-elev);
  }
</style>
