# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=https://removesynth.com,https://www.removesynth.com,http://localhost:4321

# Keep in sync with PUBLIC_MAX_UPLOAD_MB on the site.
MAX_UPLOAD_MB=50

# Uploads per IP per minute.
RATE_LIMIT_PER_MINUTE=10

# Set to true only behind a proxy you control (Cloudflare, a load balancer) so client IPs are read from headers.
TRUST_PROXY=false
