---
// Drop zone for the in-browser tools. Dispatches a `files` CustomEvent (detail: File[]) on the
// `.tool-drop` element when files are dropped, picked or pasted.
import Jitter from './Jitter.astro';

interface Props {
  id: string;
  accept: string;
  multiple?: boolean;
  title: string;
  sub: string;
  meta: string;
  footnote: string;
}

const { id, accept, multiple = false, title, sub, meta, footnote } = Astro.props;
---

<div class="tool-stage">
  <Jitter side="left" />
  <section class="tool-drop" id={id}>
    <label class="dz">
      <input type="file" accept={accept} multiple={multiple} hidden />
      <span class="dz-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 15V4m0 0-4 4m4-4 4 4M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path></svg>
      </span>
      <strong class="dz-title">{title}</strong>
      <span class="dz-sub">{sub}</span>
      <span class="dz-meta small">{meta}</span>
    </label>
    <slot />
    <p class="footnote small">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
      {footnote}
    </p>
  </section>
  <Jitter side="right" />
</div>

<style>
  .tool-stage {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
  }
  .tool-drop {
    max-width: 820px;
    margin: 0 auto;
    padding: 18px;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 28px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-lg);
  }
  svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dz {
    display: grid;
    place-items: center;
    gap: 8px;
    text-align: center;
    padding: 52px 20px 48px;
    border: 2px dashed var(--border-strong);
    border-radius: 20px;
    background: linear-gradient(180deg, var(--accent-faint), transparent);
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .dz:hover,
  .dz.drag {
    border-color: var(--accent);
    background-color: var(--accent-soft);
  }
  .dz-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 20px;
    color: #fff;
    background: linear-gradient(180deg, var(--accent-light), var(--accent-strong));
    box-shadow: 0 10px 28px var(--accent-glow);
    margin-bottom: 8px;
  }
  .dz-icon svg {
    width: 26px;
    height: 26px;
    stroke-width: 2;
  }
  .dz-title {
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }
  .dz-sub,
  .dz-meta {
    color: var(--muted);
  }
  .footnote {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 16px 0 2px;
    color: var(--muted);
    text-align: center;
  }
  .footnote svg {
    width: 15px;
    height: 15px;
    flex: none;
  }
  @media (max-width: 520px) {
    .tool-drop {
      padding: 10px;
      border-radius: 22px;
    }
    .dz {
      padding: 34px 14px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.tool-drop').forEach((root) => {
    const input = root.querySelector('input[type=file]') as HTMLInputElement;
    const dz = root.querySelector('.dz') as HTMLElement;
    const emit = (files: FileList | File[] | null | undefined) => {
      const list = [...(files ?? [])];
      if (list.length) root.dispatchEvent(new CustomEvent('files', { detail: input.multiple ? list : list.slice(0, 1) }));
    };
    input.addEventListener('change', () => {
      emit(input.files);
      input.value = '';
    });
    ['dragenter', 'dragover'].forEach((ev) =>
      dz.addEventListener(ev, (e) => {
        e.preventDefault();
        dz.classList.add('drag');
      }),
    );
    ['dragleave', 'drop'].forEach((ev) =>
      dz.addEventListener(ev, (e) => {
        e.preventDefault();
        dz.classList.remove('drag');
      }),
    );
    dz.addEventListener('drop', (e) => emit((e as DragEvent).dataTransfer?.files));
    document.addEventListener('paste', (e) => emit(e.clipboardData?.files));
  });
</script>
